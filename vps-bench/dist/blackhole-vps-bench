      "$(json_val "${BH_SYSCTL_KPTR:-}")" "$(json_val "${BH_SYSCTL_DMESG:-}")" "$(json_val "${BH_SYSCTL_BPF:-}")" "$(json_val "${BH_SYSCTL_YAMA:-}")" \
