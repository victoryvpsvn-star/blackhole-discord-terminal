# bhv5c9_redact_on — true when BH_REDACT=1 (reuses 12-cloud's bh_redact_on
# when loaded; same env contract, so behaviour is identical either way).
bhv5c9_redact_on() {
  if command -v bh_redact_on >/dev/null 2>&1; then
    bh_redact_on
    return $?
  fi
