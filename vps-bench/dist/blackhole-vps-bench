    printf '"firewall":%s,"fail2ban":%s,"uid0_accounts":%s,"empty_passwords":%s,"sudo_nopasswd":%s,' \
      "$(json_val "$BH_FW")" "$(json_val "$BH_F2B")" "$(json_val "${BH_UID0:-unknown}")" "$(json_val "$BH_EMPTY_PW")" "$(json_val "$BH_SUDO_NOPASS")"
    printf '"aslr":%s,"auto_updates":%s,"listening_ports":%s,' \
      "$(json_val "$BH_ASLR")" "$(json_val "$BH_AUTO_UPD")" "$(json_val "$BH_LISTEN")"
    printf '"sshd_version":%s,"sshd_running":%s,"permit_empty_passwords":%s,"login_grace_time":%s,"x11_forwarding":%s,"allow_users":%s,"auth_key_perm_issues":%s,' \
      "$(json_val "${BH_SSH_VERSION:-}")" "$(json_val "${BH_SSH_RUNNING:-}")" "$(json_val "${BH_SSH_PERMPTY:-}")" \
      "$(json_val "${BH_SSH_LOGINGRACE:-}")" "$(json_val "${BH_SSH_X11:-}")" "$(json_val "${BH_SSH_ALLOWUSERS:-}")" \
      "$(json_val "${BH_AK_PERM_BAD:-}")"
    printf '"mac":%s,"updates":%s,"updates_n":%s,"risky_ports":%s,"miners":%s,"docker_sock":%s,' \
      "$(json_val "${BH_MAC:-}")" "$(json_val "${BH_UPDATES:-}")" "$(json_val "${BH_UPDATES_N:-}")" \
      "$(json_val "${BH_RISKY_PORTS:-}")" "$(json_val "${BH_MINERS:-}")" "$(json_val "${BH_DOCKER_SOCK:-}")"
    printf '"sysctl":{"kptr_restrict":%s,"dmesg_restrict":%s,"unprivileged_bpf":%s,"yama_ptrace":%s},"tmp_opts":%s,"timers":%s,"cron_files":%s,"sshguard":%s,"crowdsec":%s,' \
      "$(json_val "${BH_SYSCTL_KPTR:-}")" "$(json_val "${BH_SYSCTL_DMESG:-}")" "$(json_val "${BH_SYSCTL_BPF:-}")" "$(json_val "${BH_SYSCTL_YAMA:-}")" \
      "$(json_val "${BH_TMP_OPTS:-}")" "$(json_val "${BH_TIMERS_N:-}")" "$(json_val "${BH_CRON_N:-}")" \
      "$(json_val "${BH_SSHGUARD:-}")" "$(json_val "${BH_CROWDSEC:-}")"
    printf '"weak_crypto":%s,"ciphers":%s,"kex":%s,"maxstartups":%s,"alive":%s,"authkeys_path":%s,' \
      "$(json_val "${BH_SEC_WEAK_CRYPTO:-}")" "$(json_val "${BH_SEC_CIPHERS:-}")" "$(json_val "${BH_SEC_KEX:-}")" \
      "$(json_val "${BH_SEC_MAXSTARTUPS:-}")" "$(json_val "${BH_SEC_ALIVE:-}")" "$(json_val "${BH_SEC_AUTHKEYS_PATH:-}")"
    printf '"pam_pw":%s,"pass_max_days":%s,"root_expire":%s,"auditd":%s,"ntp":%s,"banner":%s,' \
      "$(json_val "${BH_SEC_PAM_PW:-}")" "$(json_val "${BH_SEC_PASS_MAX_DAYS:-}")" "$(json_val "${BH_SEC_ROOT_EXPIRE:-}")" \
      "$(json_val "${BH_SEC_AUDITD:-}")" "$(json_val "${BH_SEC_NTP:-}")" "$(json_val "${BH_SEC_BANNER:-}")"
    printf '"path_world_writable":%s,"suid_count":%s,"suid_odd":%s,"core_dumps":%s,"protected_sysctl":%s,' \
      "$(json_val "${BH_SEC_PATH_WW:-}")" "$(json_val "${BH_SEC_SUID_COUNT:-}")" "$(json_val "${BH_SEC_SUID_ODD:-}")" \
      "$(json_val "${BH_SEC_CORE:-}")" "$(json_val "${BH_SEC_PROTECTED_SYSCTL:-}")"
    printf '"legacy_pkgs":%s,"sudo_ver":%s,"pkexec_ver":%s,"umask":%s,"forensics":%s,' \
      "$(json_val "${BH_SEC_LEGACY_PKGS:-}")" "$(json_val "${BH_SEC_SUDO_VER:-}")" "$(json_val "${BH_SEC_PKEXEC_VER:-}")" \
      "$(json_val "${BH_SEC_UMASK:-}")" "$(json_val "${BH_SEC_FORENSICS:-}")"
    printf '"pass":%s,"warn":%s,"bad":%s,"posture":%s},' \
      "$(json_val "$BH_SEC_PASS")" "$(json_val "$BH_SEC_WARN")" "$(json_val "$BH_SEC_BAD")" "$(json_val "$BH_SEC_POSTURE")"
  fi
  # top-level convenience mirror of the system.cpu v4 fields (the v4 suite
  # asserts .cpu.ai_features at the top level; system.cpu stays canonical)
  printf '"cpu":{"ai_features":%s,"crypto_features":%s,"microcode":%s,"stepping":%s,"bash_ops":%s,"awk_ops":%s,"steal_under_load":%s,"input_src":%s},' \
    "$(json_val "${BH_CPU_AI_FEAT:-}")" "$(json_val "${BH_CPU_CRYPTO_FEAT:-}")" \
    "$(json_val "${BH_CPU_UCODE:-}")" "$(json_val "${BH_CPU_STEPPING:-}")" \
    "$(json_val "${BH_BASH_OPS:-}")" "$(json_val "${BH_AWK_OPS:-}")" \
    "$(json_val "${BH_STEAL_UNDER_LOAD:-}")" "$(json_val "${BH_CPU_INPUT_SRC:-}")"
  printf '"score":{"cpu_1c":%s,"cpu_multi":%s,"memory":%s,"disk_seq":%s,"disk_4k":%s,"net_down":%s,"net_up":%s,"total":%s,"max":%s,"grade":%s,"oversell":%s,"share_card":%s},' \
    "$(json_val "$BH_SCORE_CPU1C")" "$(json_val "$BH_SCORE_CPUMC")" "$(json_val "$BH_SCORE_MEM")" \
    "$(json_val "$BH_SCORE_DSEQ")" "$(json_val "$BH_SCORE_D4K")" "$(json_val "$BH_SCORE_NDOWN")" \
    "$(json_val "$BH_SCORE_NUP")" "$(json_val "$BH_SCORE_TOTAL")" "$(json_val "$BH_SCORE_MAX")" "$(json_val "$BH_GRADE")" \
    "$(json_val "${BH_OVERSELL:-}")" "$(json_val "${BH_SHARE_CARD:-}")"
  # ---- v5 extras (C14): speccheck / container / hardware objects ----
  if [ -n "${BH_SPEC_SUMMARY:-}${BH_SPEC_CPU_V:-}${BH_SPEC_RAM_V:-}${BH_SPEC_BURST:-}" ]; then
    printf '"speccheck":{"summary":%s,"cpu":%s,"ram":%s,"burst":%s},' \
      "$(json_val "${BH_SPEC_SUMMARY:-}")" "$(json_val "${BH_SPEC_CPU_V:-}")" \
      "$(json_val "${BH_SPEC_RAM_V:-}")" "$(json_val "${BH_SPEC_BURST:-}")"
  fi
  if [ -n "${BH_UIDMAP_MODE:-}${BH_SECCOMP_MODE:-}${BH_PSI_TXT:-}${BH_RT_NAME:-}${BH_ORCH:-}${BH_RT_CTR_ID:-}${BH_K8S_CTX:-}${BH_SA_TXT:-}${BH_POD_UID:-}${BH_PROJ_VOL:-}${BH_NS_FP:-}" ]; then
    printf '"container":{"uidmap_mode":%s,"seccomp":%s,"psi":%s,"runtime":%s,"orchestrator":%s,"container_id":%s,"k8s_context":%s,"service_account":%s,"pod_uid":%s,"projected_volume":%s,"ns_fingerprint":%s},' \
      "$(json_val "${BH_UIDMAP_MODE:-}")" "$(json_val "${BH_SECCOMP_MODE:-}")" "$(json_val "${BH_PSI_TXT:-}")" \
      "$(json_val "${BH_RT_NAME:-}")" "$(json_val "${BH_ORCH:-}")" "$(json_val "${BH_RT_CTR_ID:-}")" \
      "$(json_val "${BH_K8S_CTX:-}")" "$(json_val "${BH_SA_TXT:-}")" "$(json_val "${BH_POD_UID:-}")" \
      "$(json_val "${BH_PROJ_VOL:-}")" "$(json_val "${BH_NS_FP:-}")"
  fi
  if [ -n "${BH_CACHE_TXT:-}${BH_BLOCKQ_TXT:-}${BH_NUMA_TXT:-}${BH_NUMA_OFFLINE:-}${BH_CPUFREQ_TXT:-}${BH_THERMAL_TXT:-}${BH_THROTTLE_CNT:-}${BH_HWERR_TXT:-}${BH_DIMM_TXT:-}" ]; then
    printf '"hardware":{"cache":%s,"block_queue":%s,"numa":%s,"numa_offline":%s,"cpufreq":%s,"thermal":%s,"throttle_events":%s,"hw_errors":%s,"dimm":%s},' \
      "$(json_val "${BH_CACHE_TXT:-}")" "$(json_val "${BH_BLOCKQ_TXT:-}")" "$(json_val "${BH_NUMA_TXT:-}")" \
      "$(json_val "${BH_NUMA_OFFLINE:-}")" "$(json_val "${BH_CPUFREQ_TXT:-}")" "$(json_val "${BH_THERMAL_TXT:-}")" \
      "$(json_val "${BH_THROTTLE_CNT:-}")" "$(json_val "${BH_HWERR_TXT:-}")" "$(json_val "${BH_DIMM_TXT:-}")"
  fi
  # ---- v5 numeric extras — flat keys, emitted only for clean numbers ----
  bhv5c14_json_num mem_lat_ns   "${BH_MEM_LAT_NS:-}"
  bhv5c14_json_num pipe_us      "${BH_PIPE_US:-}"
  bhv5c14_json_num stat_kps     "${BH_STAT_KPS:-}"
  bhv5c14_json_num sqlite_rps   "${BH_SQLITE_RPS:-}"
  bhv5c14_json_num fsync_p50_ms "${BH_FSYNC_P50_MS:-}"
  bhv5c14_json_num fsync_p99_ms "${BH_FSYNC_P99_MS:-}"
  bhv5c14_json_num throttle_pct "${BH_THROTTLE_PCT:-}"
  bhv5c14_json_num tls_ms       "${BH_TLS_MS:-}"
  bhv5c14_json_num clock_skew_s "${BH_CLOCK_SKEW_S:-}"
  bhv5c14_json_num pmtu         "${BH_PMTU:-}"
  # ---- v5 tips array (full list) + fingerprint + truth (closing keys) ----
  if declare -F bh_tips_engine >/dev/null 2>&1; then
    bh_tips_engine
  fi
  local _tip _tips_json="" _tsep=""
  if [ -n "${BH_TIPS:-}" ]; then
    while IFS= read -r _tip; do
      [ -n "$_tip" ] || continue
      _tips_json="${_tips_json}${_tsep}\"$(json_esc "$_tip")\""
      _tsep=","
    done <<BHV5C14JSONTIPS
${BH_TIPS:-}
BHV5C14JSONTIPS
  fi
  printf '"tips":[%s],' "$_tips_json"
  bh_fingerprint
  bhv5c14_truth_strip
  printf '"fingerprint":%s,"truth":%s}' \
    "$(json_val "${BH_FINGERPRINT:-}")" "$(json_val "${BH_TRUTH:-}")"
}

# ---------------------------------------------------------------- Markdown
build_markdown() {
  bh_redact_sink
  bh_compute_verdicts
  printf '# BLACKHOLE VPS BENCH v%s\n\n' "$BH_VERSION"
  printf '> Generated: %s · mode: `%s` · repo: [%s](https://github.com/%s)\n\n' \
    "$(date -u '+%Y-%m-%d %H:%M UTC')" "$BH_MODE" "$BH_REPO" "$BH_REPO"
  printf '## Verdict\n\n| Field | Value |\n|---|---|\n'
  printf '| Kind | **%s** |\n' "$BH_KIND"
  printf '| Type | %s |\n' "$BH_TYPE"
  printf '| Product | %s |\n' "$BH_PRODUCT"
  [ -n "$BH_HOST_PRODUCT" ] && printf '| Host | %s |\n' "$BH_HOST_PRODUCT"
  [ -n "$BH_CLOUD" ] && printf '| Cloud | %s %s |\n' "$BH_CLOUD" "$BH_CLOUD_DETAIL"
  printf '\n## System\n\n| Field | Value |\n|---|---|\n'
  printf '| OS | %s (%s) |\n' "$BH_OS" "$BH_KERNEL"
  printf '| CPU | %s — %s logical / %s physical, effective %s |\n' "$BH_CPU_MODEL" "$BH_CPU_LOGICAL" "$BH_CPU_PHYS" "$BH_EFF_CORES"
  [ -n "$BH_CPU_QUOTA_TXT" ] && printf '| CPU quota (cgroup) | %s cores |\n' "$BH_CPU_QUOTA_TXT"
  [ -n "$CPUSET" ] && printf '| cpuset | `%s` |\n' "$CPUSET"
  printf '| RAM | %s total / %s avail |\n' "$(fmt_mbint "$BH_MEM_TOTAL_MB")" "$(fmt_mbint "$BH_MEM_AVAIL_MB")"
  [ "${BH_MEM_LIMIT_MB:-0}" -gt 0 ] 2>/dev/null && printf '| RAM limit (cgroup) | %s |\n' "$(fmt_mbint "$BH_MEM_LIMIT_MB")"
  [ -n "${BH_STEAL_PCT:-}" ] && printf '| CPU steal | %s%% |\n' "$BH_STEAL_PCT"
  printf '| Disk | %s (%s) %s total |\n' "$BH_DISK_DEV" "$BH_DISK_FS" "$(fmt_mbint "$BH_DISK_TOTAL_MB")"
  if [ -n "${BH_DISK_CLASS:-}${BH_DISK_SCHED:-}${BH_DISK_ROTA:-}" ]; then
    printf '| Disk class | %s (sched %s, rota %s) |\n' "${BH_DISK_CLASS:-?}" "${BH_DISK_SCHED:-?}" "${BH_DISK_ROTA:-?}"
  fi
  if [ "${BH_BENCH_SKIPPED:-0}" != "1" ]; then
    printf '\n## Benchmark\n\n| Metric | Value |\n|---|---|\n'
    printf '| CPU sha256 (1 core) | %s |\n' "$(fmt_mb "$BH_SHA1C")"
    printf '| CPU sha256 (%s threads) | %s |\n' "$BH_PAR_JOBS" "$(fmt_mb "$BH_SHANC")"
    [ -n "${BH_CPU_EFFICIENCY:-}" ] && printf '| Multi-thread efficiency | %s%% of linear scaling |\n' "$BH_CPU_EFFICIENCY"
    printf '| Memory bandwidth | %s (%s) |\n' "$(fmt_gbs "$BH_MEM_GBS")" "$BH_MEM_METHOD"
    printf '| Disk seq write | %s |\n' "$(fmt_mb "$BH_SEQW")"
    printf '| Disk seq read | %s |\n' "$(fmt_mb "$BH_SEQR")"
    printf '| Disk 4K write / read | %s / %s |\n' "$(fmt_mb "$BH_4KW")" "$(fmt_mb "$BH_4KR")"
    if [ -n "${BH_4K_IOPS_W:-}" ] || [ -n "${BH_4K_IOPS_R:-}" ]; then
      printf '| Disk 4K IOPS (w/r) | %s / %s |\n' "${BH_4K_IOPS_W:-n/a}" "${BH_4K_IOPS_R:-n/a}"
    fi
    [ -n "$BH_FIO_RIOPS" ] && printf '| fio 4k rand IOPS | r %s / w %s |\n' "$BH_FIO_RIOPS" "${BH_FIO_WIOPS:-n/a}"
    if [ "$BH_NO_NET" != "1" ]; then
      printf '| Network download | %s |\n' "$(fmt_mbps "$BH_DOWN_MBPS")"
      printf '| Network upload | %s |\n' "$(fmt_mbps "$BH_UP_MBPS")"
      printf '| TCP connect | %s |\n' "$(fmt_ms "$BH_LAT_MS")"
      [ -n "$BH_LAT_ICMP" ] && printf '| ICMP latency / jitter | %s ms%s (%s) |\n' "$BH_LAT_ICMP" "${BH_LAT_JITTER:+ ± $BH_LAT_JITTER}" "$BH_LAT_TARGET"
      [ -n "${BH_NET_ENDPOINT:-}" ] && printf '| Test endpoint | %s |\n' "$BH_NET_ENDPOINT"
    fi
  fi
  if [ "${BH_SEC_SKIPPED:-0}" != "1" ] && [ "${#BH_SEC_LINES[@]}" -gt 0 ] 2>/dev/null; then
    printf '\n## SSH & Security\n\n| Status | Check |\n|---|---|\n'
    local ml badge txt post_row=""
    md_sec_row() { # one table row from a "  [TAG]  text" audit line
      txt="${1##*]  }"
      badge="${1#*\[}"; badge="${badge%%\]*}"
      printf '| %s | %s |\n' "$badge" "$(printf '%s' "$txt" | sed 's/|/\\|/g')"
    }
    # v3 deep-scan extras sit between the audit body and the posture summary
    for ml in "${BH_SEC_LINES[@]}"; do
      case "$ml" in "  [POST]"*) post_row="$ml"; continue ;; esac
      md_sec_row "$ml"
    done
    sec_report_extras
    if [ "${#BH_SEC_EXTRA_LINES[@]}" -gt 0 ] 2>/dev/null; then
      for ml in "${BH_SEC_EXTRA_LINES[@]}"; do md_sec_row "$ml"; done
    fi
    [ -n "$post_row" ] && md_sec_row "$post_row"
  fi
  if [ "${BH_BENCH_SKIPPED:-0}" != "1" ]; then
    if [ -n "$BH_GRADE" ]; then
      printf '\n## BH-SCORE\n\n**%s / %s (grade %s)**\n\n' "$BH_SCORE_TOTAL" "$BH_SCORE_MAX" "$BH_GRADE"
    else
      printf '\n## BH-SCORE\n\n**%s / %s**\n\n' "$BH_SCORE_TOTAL" "$BH_SCORE_MAX"
    fi
    printf 'cpu1c %s · cpumc %s · mem %s · disk-seq %s · disk-4k %s · net-down %s · net-up %s\n' \
      "$BH_SCORE_CPU1C" "$BH_SCORE_CPUMC" "$BH_SCORE_MEM" "$BH_SCORE_DSEQ" "$BH_SCORE_D4K" "$BH_SCORE_NDOWN" "$BH_SCORE_NUP"
  fi
  # v4: oversell verdict + share card (wow#1 / wow#9) in the markdown sink too
  if [ -n "${BH_OVERSELL:-}" ]; then
    printf '\n**Oversell verdict:** %s\n' "$BH_OVERSELL"
  fi
  [ -n "${BH_SHARE_CARD:-}" ] && printf '\n> Share: %s\n' "$BH_SHARE_CARD"
  # ---- v5 extras (C14) — one compact table, skipped when nothing to show ----
  bhv5c14_md_extras
  if [ -n "$BH_IPV4$BH_IP_GEO$BH_IP_ASN" ]; then
    printf '\n## Location\n\n| Field | Value |\n|---|---|\n'
    [ -n "$BH_IPV4" ] && printf '| IPv4 | `%s` |\n' "$BH_IPV4"
    [ -n "$BH_IPV6" ] && printf '| IPv6 | `%s` |\n' "$BH_IPV6"
    [ -n "$BH_IP_GEO" ] && printf '| Geo/ISP | %s |\n' "$BH_IP_GEO"
    [ -n "$BH_IP_ASN" ] && printf '| ASN | %s |\n' "$BH_IP_ASN"
  fi
  if [ -n "$BH_EVIDENCE" ]; then
    printf '\n<details><summary>Detection evidence</summary>\n\n```\n%s\n```\n\n</details>\n' "$BH_EVIDENCE"
  fi
  printf '\n> Methodology: CPU = sha256 throughput (dd|sha256sum); Memory = C memcpy-style loop (or dd proxy); Disk = dd (direct I/O when supported); Network = Cloudflare speed endpoints. BH-SCORE caps each of the 7 components at 100 (max 700).\n'
}

# ---------------------------------------------------------------- Discord
discord_send() {
  [ -n "$BH_WEBHOOK" ] || return 0
  bh_redact_sink
  bh_compute_verdicts
  log "sending report to Discord webhook..."

  local desc
  desc="$(printf '%s\n' "${bh_lines[@]}" | tail -c 1900)"
  desc="${desc//$\\/\\\\}"; desc="${desc//\"/\\\"}"; desc="${desc//$'\n'/\\n}"; desc="${desc//$'\t'/ }"

  # colors must be DECIMAL: hex literals (9B59B6) are invalid JSON numbers
  local color=10181046 # 0x9B59B6 (purple)
  case "$BH_KIND" in
    container)  color=3447003 ;;  # 0x3498DB (blue)
    vm)         color=15494310 ;; # 0x9B59B6
    bare-metal) color=3066993 ;;  # green
  esac

  local fields="["
  local sep=""
  add_field() {
    fields="$fields$sep{\"name\":\"$(json_esc "$1")\",\"value\":\"$(json_esc "$2")\",\"inline\":true}"
    sep=","
  }
  add_field "Verdict" "$(verdict_text)"
  if [ "${BH_BENCH_SKIPPED:-0}" != "1" ]; then
    add_field "BH-SCORE" "$BH_SCORE_TOTAL / $BH_SCORE_MAX"
    add_field "CPU sha256" "$(fmt_mb "$BH_SHA1C") (1c) / $(fmt_mb "$BH_SHANC") (${BH_PAR_JOBS}thr)"
    add_field "Memory" "$(fmt_gbs "$BH_MEM_GBS")"
    add_field "Disk" "seq $(fmt_mb "$BH_SEQW") | 4k $(fmt_mb "$BH_4KW")"
    if [ "$BH_NO_NET" != "1" ]; then
      add_field "Network" "down $(fmt_mbps "$BH_DOWN_MBPS") / up $(fmt_mbps "$BH_UP_MBPS")"
    fi
  fi
  [ -n "$BH_IP_GEO" ] && add_field "Location" "$BH_IP_GEO"
  if [ "${BH_SEC_SKIPPED:-0}" != "1" ]; then
    add_field "SSH auth" "password=${BH_SSH_PWDAUTH:-unset} · root=${BH_SSH_ROOTLOGIN:-default} · keys=$BH_AK_TOTAL"
    add_field "Security posture" "$BH_SEC_POSTURE — $BH_SEC_PASS pass / $BH_SEC_WARN warn / $BH_SEC_BAD bad"
  fi
  case "${BH_OVERSELL:-}" in
    ''|"no evidence") : ;;
    *) add_field "Oversell" "$BH_OVERSELL" ;;
  esac
  [ -n "${BH_SHARE_CARD:-}" ] && add_field "Share" "$BH_SHARE_CARD"
  fields="$fields]"

  local payload="$BH_RUNDIR/dh_payload.json"
  {
    printf '{"username":"Blackhole VPS Bench",'
    printf '"embeds":[{"title":"%s — %s",' "$(json_esc "$BH_TOOL")" "$(json_esc "$BH_HOSTNAME")"
    printf '"description":"```\\n%s\\n```",' "$desc"
    printf '"color":%s,' "$color"
    printf '"fields":%s,' "$fields"
    printf '"footer":{"text":"%s v%s · %s"},' "$(json_esc "$BH_TOOL")" "$(json_esc "$BH_VERSION")" "$(json_esc "$BH_REPO")"
    printf '"timestamp":"%s"}]}' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
  } > "$payload"

  local code
  code="$(curl -sS -o /dev/null -w '%{http_code}' --max-time 20 \
    -H 'Content-Type: application/json' -X POST --data-binary @"$payload" "$BH_WEBHOOK" 2>/dev/null)"
  if [ "$code" = "204" ] || [ "$code" = "200" ]; then
    log "Discord webhook delivered (HTTP $code)"
  else
    warn "Discord webhook returned HTTP ${code:-none}"
  fi
}

# ============ lib/80-ssh.sh ============
# =====================================================================
# blackhole-vps-bench · 80-ssh.sh — SSH & local security audit (v4)
# Audits ONLY the local machine: sshd effective config (password auth,
# pubkey auth, root login, empty passwords, login grace, X11, keyboard-
# interactive, AllowUsers/AllowGroups), OpenSSH version, sshd runtime
# state, authorized_keys inventory + StrictModes permission audit, failed
# login attempts, firewall, brute-force protection (fail2ban / sshguard /
# crowdsec), UID-0 accounts, empty passwords, sudo NOPASSWD, ASLR, auto
# updates, listening ports.
# v4 additions (H1-H8): weak crypto algorithms in the effective
# Ciphers/MACs/KexAlgorithms (with correct OpenSSH Include semantics —
# first-match-wins, Include expands IN PLACE), MaxStartups/ClientAlive
# connection hygiene, non-default AuthorizedKeysFile paths added to the key
# inventory (%u/%h expanded), PAM password quality, password aging
# (login.defs + root chage), auditd state, time-sync status and pre-login
# banner OS-info leaks.
# No root required — checks degrade gracefully and say so.
# v5 additions (C10): sshd config syntax gate (sshd -t, root), daemon
# version, declared-vs-effective config diff (sshd -T cross-check),
# systemd socket-activation false-positive guard, authorized_keys deep scan
# (DSA keys, comment CLASS counts, >2y rotation age, RSA bit fallback),
# host key audit (type/size/mtime, 16-char fingerprints only), certificate
# auth posture, Match/SFTP block scan, forwarding sweep, port/topology
# cross-check, auth-log deep counts, MFA posture. Counts only — never key
# material, public keys, usernames or IPs in the lines (BH_REDACT-safe).
# =====================================================================
# shellcheck shell=bash

BH_SSH_FOUND=0; BH_SSH_T_OK=0; BH_SSH_T_OUT=""; BH_SSH_CFG_SRC=""
BH_SSH_PWDAUTH=""; BH_SSH_PUBKEY=""; BH_SSH_ROOTLOGIN=""
BH_SSH_PORTS=""; BH_SSH_MAXAUTH=""
BH_SSH_PERMPTY=""; BH_SSH_LOGINGRACE=""; BH_SSH_X11=""; BH_SSH_KBDINT=""
BH_SSH_ALLOWUSERS=""; BH_SSH_VERSION=""
BH_SSH_RUNNING=0; BH_SSH_LISTENING=""; BH_SSHD_BIN=""
BH_AK_TOTAL=0; BH_AK_TYPES=""; BH_AK_WEAK=0; BH_AK_PERM_BAD=0
BH_SSH_FAILS="n/a"; BH_SSH_FAILS_N=-1
BH_FW="unknown"; BH_F2B=0; BH_F2B_ACTIVE=0; BH_SSHGUARD=0; BH_CROWDSEC=0
BH_UID0=""; BH_EMPTY_PW="n/a"; BH_LOGIN_SHELLS=""
BH_SUDO_NOPASS="n/a"
BH_ASLR=""; BH_AUTO_UPD="n/a"
BH_LISTEN=""
BH_SEC_PASS=0; BH_SEC_WARN=0; BH_SEC_BAD=0
BH_SEC_POSTURE="n/a"
BH_SEC_LINES=()
BH_SSH_CFG_LINES=()
# --- v4 deep-scan additions (H1-H8) ---------------------------------------
BH_SEC_WEAK_CRYPTO=""    # weak tokens found in effective Ciphers/MACs/Kex
                         # ("" = none found / distro defaults)
BH_SEC_CIPHERS=""        # effective Ciphers, first 60 chars (INFO)
BH_SEC_KEX=""            # effective KexAlgorithms, first 60 chars (INFO)
BH_SEC_MAXSTARTUPS=""    # MaxStartups effective, or "10:30:100 default"
BH_SEC_ALIVE=""          # ClientAliveInterval/CountMax or "disabled (default)"
BH_SEC_AUTHKEYS_PATH=""  # effective AuthorizedKeysFile (or default); feeds key inventory
BH_SEC_PAM_PW=""         # pwquality (minlen N) | pwquality | cracklib | passwdqc | none | unknown
BH_SEC_PASS_MAX_DAYS=""  # login.defs PASS_MAX_DAYS ("no expiry" for 99999)
BH_SEC_ROOT_EXPIRE=""    # root password expiry: never | YYYY-MM-DD | "" (unknown)
BH_SEC_AUDITD="unknown"  # running | installed-not-running | not-installed | unknown
BH_SEC_NTP="unknown"     # synced (chronyd) | synced (timesyncd) | not-synced | unknown
BH_SEC_BANNER=""         # leaks OS info (...) | custom | none | "" (no sshd)
# --- v5.0 deep-scan additions (C10; raw values, the report layer may read) ---
BH_SSHD_CFG_VALID=""     # ok | invalid | skipped (non-root) | n/a (no binary)
BH_SSHD_VER=""           # daemon OpenSSH_x.y from sshd -V/-h ("" = unknown)
BH_SSH_EFF_DECL="n/a"    # declared=effective | overrides:N | n/a
BH_SSH_SOCKET_FP=0       # 1 = sshd answers via systemd socket-activation
BH_AK_WEAK=0             # (v4) weak authorized_keys (<2048-bit / DSA)
BH_AK_DSA=0              # DSA keys found in authorized_keys
BH_AK_STALE=0            # authorized_keys files older than 730 days
BH_AK_RSA_FB=0           # RSA keys bit-counted via the od/awk fallback
BH_AK_DEEP_KEYS=0        # key lines classified by the deep scan
BH_AK_CMT_EMAIL=0        # key comments that look like an email (count only)
BH_AK_CMT_HOST=0         # key comments that look like a host (count only)
BH_AK_CMT_NONE=0         # key comments absent (count only)
BH_AK_CMT_OTHER=0        # key comments in no known class (count only)
BH_HOSTKEY_AUDIT=""      # "keys:N dsa:M rsa_lt2048:K rsa_2048:J"
BH_SSH_CA="none"         # none | ca | command | ca+command
BH_SSH_MATCH_SFTP=""     # "N block(s)" when sftp-only chroot Match blocks found
BH_SSH_FWD=""            # forwarding sweep summary (tcp/agent/tunnel/gw/pen)
BH_SSH_TOPO=""           # ports/listen/masters/unconf/bind summary
BH_AUTH_LOG_SUM=""       # "fail:N invalid-users:M pw-accepted:K"
BH_AUTH_PW_LOGIN=0       # 'Accepted password' hits in the auth logs
BH_AUTH_INVALID_USERS=0  # distinct 'Invalid user' names (count only)
BH_LASTB_N=0             # lastb entries in /var/log/btmp (capped at 20)
BH_F2B_BANNED=-1         # fail2ban sshd jail currently-banned count (-1 unknown)
BH_SSH_MFA=""            # enforced | methods-only | usepam-no | none

# sec_line STATUS TEXT — record one audit line (plain, badged) and count it.
# STATUS: ok | warn | bad | info (info is not counted in the posture score)
sec_line() {
  local st="$1" txt="$2" tag
  case "$st" in
    ok)   tag="[OK]";   BH_SEC_PASS=$((BH_SEC_PASS + 1)) ;;
    warn) tag="[WARN]"; BH_SEC_WARN=$((BH_SEC_WARN + 1)) ;;
    bad)  tag="[BAD]";  BH_SEC_BAD=$((BH_SEC_BAD + 1)) ;;
    *)    tag="[INFO]" ;;
  esac
  BH_SEC_LINES+=("  $tag  $txt")
}

# ---------------------------------------------------------------------------
# sec_sshd_read FILE DEPTH — append FILE's directives to BH_SSH_CFG_LINES,
# expanding Include directives IN PLACE (recursive; depth-capped; unreadable
# files are skipped silently — "Permission denied" degrades to nothing).
#
# SEMANTICS NOTE — OpenSSH Include, first-match-wins (fixes bug G5):
# sshd implements "first obtained value wins", and Include expands exactly
# where it appears in the read stream. Given a two-line /etc/ssh/sshd_config:
#
#     Port 2222
#     Include /etc/ssh/sshd_config.d/*.conf   (drop-in contains: Port 22)
#
# the effective Port is 2222 — a directive set BEFORE an Include line stays
# authoritative over the included files. A directive that exists ONLY in a
# drop-in still wins over a later (or absent) main-file directive, because
# the drop-in's line enters the stream first. The old parser read the
# drop-in dir ahead of the main file unconditionally, which wrongly let
# drop-ins beat earlier main-file settings. The common distro layout (Include
# as the very first line of sshd_config) behaves exactly as it did before.
# ---------------------------------------------------------------------------
sec_sshd_read() {
  local f="$1" depth="${2:-0}" line key rest tok g
  [ "$depth" -le 8 ] 2>/dev/null || return 0    # Include-cycle guard
  [ -r "$f" ] || return 0                       # unreadable -> graceful skip
  # shellcheck disable=SC2094  # config file is read-only here (recursion guarded)
  while IFS= read -r line; do
    line="${line#"${line%%[![:space:]]*}"}"     # trim leading whitespace
    case "$line" in ''|\#*) continue ;; esac
    key="${line%%[[:space:]]*}"
    rest="${line#"$key"}"
    case "$key" in
      [Ii][Nn][Cc][Ll][Uu][Dd][Ee])
        # sshd: relative Include paths resolve against /etc/ssh; several
        # whitespace-separated globs may be given; globs matching nothing are
        # silently ignored (bash leaves the literal, the -f test rejects it).
        for tok in $rest; do
          case "$tok" in \"*\") tok="${tok#\"}"; tok="${tok%\"}" ;; esac
          case "$tok" in
            /*) : ;;
            *)  tok="/etc/ssh/$tok" ;;
          esac
          for g in $tok; do
            # shellcheck disable=SC2094  # read-only recursion; $g != $f guarded
            if [ -f "$g" ] && [ "$g" != "$f" ]; then
              sec_sshd_read "$g" $((depth + 1))
            fi
          done
        done
        ;;
      *)
        BH_SSH_CFG_LINES+=("$line")
        ;;
    esac
  done < "$f"
}

sec_sshd_load() {
  # sshd usually lives OUTSIDE a normal user's PATH (/usr/sbin) — probe the
  # usual sbin homes first, then whatever 'command -v sshd' can find.
  local b g
  for b in /usr/sbin/sshd /usr/local/sbin/sshd; do
    [ -x "$b" ] && { BH_SSHD_BIN="$b"; break; }
  done
  if [ -z "$BH_SSHD_BIN" ] && command_exists sshd; then
    BH_SSHD_BIN="$(command -v sshd)"
  fi
  if [ -n "$BH_SSHD_BIN" ]; then
    BH_SSH_FOUND=1
    # 'sshd -T' loads the 0600 root-owned host keys, so as non-root it always
    # fails — only run it when we are root; capture stderr quietly either way.
    if [ "$(id -u 2>/dev/null)" = "0" ]; then
      BH_SSH_T_OUT="$($BH_SSHD_BIN -T 2>/dev/null || true)"
      if [ -n "$BH_SSH_T_OUT" ]; then
        BH_SSH_T_OK=1
        BH_SSH_CFG_SRC="sshd -T (effective config)"
      fi
    fi
  fi
  # no binary but a config file? still audit the raw config below
  if [ "$BH_SSH_FOUND" = "0" ] && [ -f /etc/ssh/sshd_config ]; then
    BH_SSH_FOUND=1
  fi
  if [ "$BH_SSH_T_OK" = "0" ]; then
    # Build the logical directive stream with real OpenSSH Include semantics:
    # read the main config top-to-bottom and expand Include IN PLACE, so
    # first-match-wins holds across the expanded stream (see sec_sshd_read).
    BH_SSH_CFG_LINES=()
    [ -r /etc/ssh/sshd_config ] && sec_sshd_read /etc/ssh/sshd_config 0
    # main config missing/unreadable but drop-in fragments exist? audit those
    # too (sshd itself would ignore them, but auditing beats staying blind)
    if [ ! -r /etc/ssh/sshd_config ] && [ -d /etc/ssh/sshd_config.d ]; then
      for g in /etc/ssh/sshd_config.d/*.conf; do
        [ -f "$g" ] && sec_sshd_read "$g" 0
      done
    fi
    if [ "${#BH_SSH_CFG_LINES[@]}" -gt 0 ] 2>/dev/null; then
      BH_SSH_CFG_SRC="config files, first-match (Include expanded in place)"
    else
      BH_SSH_CFG_SRC="config files (none readable)"
    fi
  fi
}

sec_sshd_opt() { # KEY DEFAULT — first match wins (mirrors sshd semantics)
  local key="$1" def="$2" out=""
  if [ "$BH_SSH_T_OK" = "1" ]; then
    out="$(printf '%s\n' "$BH_SSH_T_OUT" | awk -v k="$key" 'tolower($1)==tolower(k){ $1=""; sub(/^[ \t]+/, ""); print; exit }')"
  elif [ "${#BH_SSH_CFG_LINES[@]}" -gt 0 ] 2>/dev/null; then
    # sshd -T already resolves everything; for raw config lines: strip inline
    # comments ("PermitRootLogin yes # ansible"), skip Match blocks (their
    # settings are not global), and lowercase the value — sec_audit compares
    # lowercase but real files often say "PasswordAuthentication YES".
    out="$(printf '%s\n' "${BH_SSH_CFG_LINES[@]}" | awk -v k="$key" '
      { sub(/#.*/, "") }
      tolower($1)=="match" { inmatch=1; next }
      inmatch { next }
      tolower($1)==tolower(k){ $1=""; sub(/^[ \t]+/, ""); print tolower($0); exit }')"
  fi
  if [ -n "$out" ]; then printf '%s' "$out"; else printf '%s' "$def"; fi
}

sec_sshd_all() { # KEY — every match joined by ',' (for multi-Port configs)
  local key="$1" out=""
  if [ "$BH_SSH_T_OK" = "1" ]; then
    out="$(printf '%s\n' "$BH_SSH_T_OUT" | awk -v k="$key" 'tolower($1)==tolower(k){print $2}')"
  elif [ "${#BH_SSH_CFG_LINES[@]}" -gt 0 ] 2>/dev/null; then
    out="$(printf '%s\n' "${BH_SSH_CFG_LINES[@]}" | awk -v k="$key" '
      { sub(/#.*/, "") }
      tolower($1)=="match" { inmatch=1; next }
      inmatch { next }
      tolower($1)==tolower(k){print $2}')"
  fi
  printf '%s' "$out" | paste -sd ',' -
}

# sec_trunc VALUE — first 60 chars of a (long) algorithm list, "..." when cut
sec_trunc() {
  local v="$1"
  [ -n "$v" ] || return 0
  if [ "${#v}" -gt 60 ]; then printf '%s...' "${v:0:57}"; else printf '%s' "$v"; fi
}

# sec_weak_tokens ALG_LIST — print the weak tokens found in a comma-separated
# Ciphers/MACs/KexAlgorithms list (lowercased first; both sshd -T and raw
# config use ',' as the separator). Weak families (H1): arcfour*, all *-cbc
# ciphers, hmac-md5*/hmac-sha1* MACs, and the SHA-1 DH kex family plus the
# legacy ssh-rsa/rsa-sha1 kex names. NOTE: group1 is matched as the exact
# 'diffie-hellman-group1-sha1' name — a glob 'group1*' would also swallow
# the MODERN diffie-hellman-group14-sha256, which must stay green.
sec_weak_tokens() {
  local v out="" tok
  v="$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')"
  [ -n "$v" ] || return 0
  local IFS=,
  for tok in $v; do
    case "$tok" in
      arcfour*|*-cbc*|hmac-md5*|hmac-sha1*|diffie-hellman-group1-sha1|diffie-hellman-group14-sha1*|diffie-hellman-group-exchange-sha1*|ssh-rsa|rsa-sha1*)
        out="${out:+$out,}$tok"
        ;;
    esac
  done
  printf '%s' "$out"
}

# sec_perm_go_writable PATH — exit 0 when group OR other holds the WRITE bit.
# StrictModes refuses authentication when authorized_keys, ~/.ssh or the home
# directory are group/world-WRITABLE (read bits don't matter to sshd). The
# octal write bit is 2, so digits 2/3/6/7 all mean "writable".
sec_perm_go_writable() {
  local m
  m="$(stat -c %a "$1" 2>/dev/null)" || return 1
  case "$m" in ''|*[!0-7]*) return 1 ;; esac
  while [ "${#m}" -lt 3 ]; do m="0$m"; done    # normalize "44" -> "044"
  while [ "${#m}" -gt 2 ]; do m="${m#?}"; done # keep the group+other digits
  case "$m" in
    [2367]?|?[2367]) return 0 ;;
    *)               return 1 ;;
  esac
}

# sec_grace_secs VALUE — normalize a LoginGraceTime value to plain seconds.
# 'sshd -T' always reports seconds, but raw config files may say "2m"/"1h";
# anything unparseable is passed through unchanged.
sec_grace_secs() {
  local v="$1" n="" u=""
  [ -n "$v" ] || return 0
  case "$v" in
    [0-9]*) n="${v%%[!0-9]*}"; u="${v#"$n"}" ;;
    *)      printf '%s' "$v"; return 0 ;;
  esac
  case "$u" in
    ''|s|S) printf '%s' "$n" ;;
    m|M)    printf '%s' $(( n * 60 )) ;;
    h|H)    printf '%s' $(( n * 3600 )) ;;
    *)      printf '%s' "$v" ;;
  esac
}

sec_auth_keys() {
  local d kf line kt homes="/root" owner ak_bad tok path seen=""
  for d in /home/*; do [ -d "$d" ] && homes="$homes $d"; done
  for d in $homes; do
    owner="$(stat -c %U "$d" 2>/dev/null)"
    [ -n "$owner" ] || owner="${d##*/}"
    # scan every AuthorizedKeysFile path (H3): the default .ssh/authorized_keys
    # plus any non-default path from the effective config, with sshd's
    # %u (username) / %h (home directory) tokens expanded per user.
    for tok in ${BH_SEC_AUTHKEYS_PATH:-".ssh/authorized_keys"}; do
      path="$tok"
      case "$path" in *%h*) path="${path//%h/$d}" ;; esac
      case "$path" in *%u*) path="${path//%u/$owner}" ;; esac
      case "$path" in
        /*) : ;;                    # absolute (e.g. /etc/ssh/keys/%u)
        *)  path="$d/$path" ;;      # relative -> per-user, under the home
      esac
      case ",$seen," in *",${path},"*) continue ;; esac  # dedup (absolute paths repeat per user)
      seen="$seen,$path"
      kf="$path"
      [ -f "$kf" ] || continue
      # --- StrictModes permission audit: sshd REFUSES auth when the key file,
      #     ~/.ssh or the home directory are group/world-writable.
      #     Count every finding, but emit at most one warn line per file.
      ak_bad=""
      if sec_perm_go_writable "$kf"; then
        BH_AK_PERM_BAD=$((BH_AK_PERM_BAD + 1))
        ak_bad="authorized_keys of $owner is group/world-writable (StrictModes will REFUSE it)"
      elif [ "${path#"$d/.ssh"}" != "$path" ] && sec_perm_go_writable "$d/.ssh"; then
        BH_AK_PERM_BAD=$((BH_AK_PERM_BAD + 1))
        ak_bad=".ssh directory of $owner is group/world-writable (StrictModes will REFUSE its authorized_keys)"
      elif sec_perm_go_writable "$d"; then
        BH_AK_PERM_BAD=$((BH_AK_PERM_BAD + 1))
        ak_bad="home directory of $owner is group/world-writable (StrictModes will REFUSE its authorized_keys)"
      fi
      [ -n "$ak_bad" ] && sec_line warn "$ak_bad"
      while IFS= read -r line; do
        case "$line" in ''|\#*) continue ;; esac
        BH_AK_TOTAL=$((BH_AK_TOTAL + 1))
        kt="${line%%[[:space:]]*}"
        case "$kt" in
          ssh-ed25519|sk-ssh-ed25519@openssh.com) kt="ed25519" ;;
          ssh-rsa)                                kt="RSA" ;;
          ecdsa-sha2-*)                           kt="ECDSA" ;;
          *)                                      kt="${kt%%@*}" ;;
        esac
        BH_AK_TYPES="$BH_AK_TYPES $kt"
      done < "$kf"
      if command_exists ssh-keygen; then
        while IFS= read -r bits; do
          [ -n "$bits" ] || continue
          if [ "$bits" -lt 2048 ] 2>/dev/null; then BH_AK_WEAK=$((BH_AK_WEAK + 1)); fi
        done < <(ssh-keygen -lf "$kf" 2>/dev/null | awk '{print $1}')
      fi
    done
  done
  # BH_AK_TYPES accumulates as one space-separated line; split into one type
  # per line first or 'sort | uniq -c' counts the whole string as a single hit.
  BH_AK_TYPES="$(printf '%s\n' "$BH_AK_TYPES" | tr ' ' '\n' | sed '/^$/d' | sort | uniq -c | awk '{printf "%sx%d ", $2, $1}')"
  BH_AK_TYPES="${BH_AK_TYPES% }"
}

sec_failed_logins() {
  local n jerr="$BH_RUNDIR/journal.err"
  # journalctl exits 0 even when no journal files exist (stderr: "No journal
  # files were found.", stdout: "-- No entries --") — that must NOT be
  # reported as "0 failed logins", so bail to the auth.log fallback instead.
  if command_exists journalctl && journalctl -n 1 >/dev/null 2>&1; then
    n="$(journalctl -u ssh -u sshd --since '-24 hours' --no-pager 2>"$jerr" | grep -c 'Failed password' || true)"
    if [ -n "$n" ] && ! grep -qi 'no journal files' "$jerr" 2>/dev/null; then
      BH_SSH_FAILS_N="$n"
      BH_SSH_FAILS="$n in last 24h (journalctl)"
      return
    fi
  fi
  if [ -r /var/log/auth.log ]; then
    n="$(grep -hc 'Failed password' /var/log/auth.log 2>/dev/null)"
    case "$n" in
      ''|*[!0-9]*) # keep BH_SSH_FAILS_N numeric for the -ge comparisons below
        BH_SSH_FAILS_N=-1
        BH_SSH_FAILS="n/a (auth.log present but not parseable)"
        return
        ;;
    esac
    BH_SSH_FAILS_N="$n"
    BH_SSH_FAILS="$n in current auth.log"
    return
  fi
  BH_SSH_FAILS_N=-1
  BH_SSH_FAILS="n/a (no readable auth logs — run as root for the exact count)"
}

sec_firewall() {
  if command_exists ufw && ufw status 2>/dev/null | grep -q "Status: active"; then
    BH_FW="ufw active"
  elif command_exists nft && nft list ruleset 2>/dev/null | grep -q "chain "; then
    BH_FW="nftables rules present"
  elif command_exists iptables && iptables -S 2>/dev/null | grep -qv "^-P"; then
    BH_FW="iptables rules present"
  elif command_exists firewall-cmd && firewall-cmd --state >/dev/null 2>&1; then
    BH_FW="firewalld running"
  elif command_exists ufw; then
    BH_FW="ufw installed but INACTIVE"
  else
    BH_FW="no firewall detected"
  fi
}

# sec_sshd_runtime — is the sshd daemon alive, and which ports does it bind?
sec_sshd_runtime() {
  BH_SSH_RUNNING=0
  BH_SSH_LISTENING=""
  if command_exists pgrep; then
    # match the classic standalone daemon or a daemonized master ('-D';
    # OpenSSH 9.8+ splits sessions into sshd-session child processes)
    if pgrep -x sshd >/dev/null 2>&1 || pgrep -f "sshd.*-D" >/dev/null 2>&1; then
      BH_SSH_RUNNING=1
    fi
  fi
  if command_exists ss; then
    local ssout p ports=""
    ssout="$(ss -tlnpH 2>/dev/null || true)"
    ports="$(printf '%s\n' "$ssout" | grep -i sshd | awk '{print $4}' | sed 's/.*://' | sort -n | uniq | paste -sd ',' -)"
    if [ -z "$ports" ] && [ -n "$BH_SSH_PORTS" ]; then
      # without root, ss hides the process column — fall back to matching the
      # configured port(s) against every listening socket instead
      for p in $(printf '%s\n' "$ssout" | awk '{print $4}' | sed 's/.*://' | sort -n | uniq); do
        case ",$BH_SSH_PORTS," in *",${p},"*) ports="${ports:+$ports,}$p" ;; esac
      done
    fi
    BH_SSH_LISTENING="$ports"
  fi
}

# sec_to SECS CMD ARGS... — run a local (no-network) command under `timeout`
# when available, stderr silenced. Used for every potentially slow probe
# below; callers treat a non-zero rc / empty output as "unknown".
sec_to() {
  local s="$1"
  shift
  if command_exists timeout; then
    timeout "$s" "$@" 2>/dev/null
  else
    "$@" 2>/dev/null
  fi
}

# sec_banner (H8) — pre-login banner leak check. Sources, in order of
# authority: the effective 'Banner' directive, then /etc/issue.net, then
# /etc/motd (first line each). A line "leaks" when it names the distro or
# the kernel — exactly what a pre-auth probe wants for fingerprinting.
sec_banner() {
  BH_SEC_BANNER=""
  local b first
  local leak_re='debian|ubuntu|centos|rocky|alma|fedora|kernel|linux release'
  b="$(sec_sshd_opt banner "")"
  case "$b" in none|no) b="" ;; esac
  if [ -n "$b" ]; then
    first="$(head -n 1 "$b" 2>/dev/null)"
    first="${first:0:80}"
    if [ -n "$first" ]; then
      if printf '%s\n' "$first" | grep -qiE "$leak_re"; then
        BH_SEC_BANNER="leaks OS info (Banner $b: '$first')"
      else
        BH_SEC_BANNER="custom"
      fi
      return
    fi
    BH_SEC_BANNER="none"    # Banner set but the file is empty/unreadable
    return
  fi
  first="$(head -n 1 /etc/issue.net 2>/dev/null)"
  first="${first:0:80}"
  if [ -n "$first" ] && printf '%s\n' "$first" | grep -qiE "$leak_re"; then
    BH_SEC_BANNER="leaks OS info (/etc/issue.net: '$first')"
    return
  fi
  first="$(head -n 1 /etc/motd 2>/dev/null)"
  first="${first:0:80}"
  if [ -n "$first" ] && printf '%s\n' "$first" | grep -qiE "$leak_re"; then
    BH_SEC_BANNER="leaks OS info (/etc/motd: '$first')"
    return
  fi
  BH_SEC_BANNER="none"
}

# sec_pam_pw (H4) — which password-quality module does the PAM password
# stage use? Checked files: common-password (Debian) and system-auth /
# password-auth (RHEL-style). minlen comes from /etc/security/pwquality.conf.
# Result: "pwquality (minlen N)" | "pwquality" | "cracklib" | "passwdqc" |
# "none" | "unknown" (no readable PAM password config at all).
sec_pam_pw() {
  BH_SEC_PAM_PW=""
  local f all="" n=0 minlen
  for f in /etc/pam.d/common-password /etc/pam.d/system-auth /etc/pam.d/password-auth; do
    [ -r "$f" ] || continue
    n=$((n + 1))
    grep -qs 'pam_pwquality\.so' "$f" && all="$all pwquality"
    grep -qs 'pam_cracklib\.so' "$f" && all="$all cracklib"
    grep -qs 'pam_passwdqc\.so' "$f" && all="$all passwdqc"
  done
  case "$all" in
    *pwquality*)
      minlen="$(sed -n 's/^[[:space:]]*minlen[[:space:]]*=[[:space:]]*\([0-9][0-9]*\).*/\1/p' /etc/security/pwquality.conf 2>/dev/null | head -n 1)"
      if [ -n "$minlen" ]; then BH_SEC_PAM_PW="pwquality (minlen $minlen)"; else BH_SEC_PAM_PW="pwquality"; fi
      ;;
    *cracklib*) BH_SEC_PAM_PW="cracklib" ;;
    *passwdqc*) BH_SEC_PAM_PW="passwdqc" ;;
  esac
  if [ -z "$BH_SEC_PAM_PW" ]; then
    if [ "$n" -gt 0 ]; then BH_SEC_PAM_PW="none"; else BH_SEC_PAM_PW="unknown"; fi
  fi
}

# sec_aging (H5) — password aging: PASS_MAX_DAYS from /etc/login.defs, plus
# the root account's password expiry via `chage -l root` — run directly when
# root, else through passwordless `sudo -n` when that works.
sec_aging() {
  BH_SEC_PASS_MAX_DAYS=""
  BH_SEC_ROOT_EXPIRE=""
  local v out
  v="$(awk '$1=="PASS_MAX_DAYS" && $2 ~ /^[0-9]+$/ {print $2; exit}' /etc/login.defs 2>/dev/null)"
  case "$v" in
    '')    : ;;
    99999) BH_SEC_PASS_MAX_DAYS="no expiry" ;;
    *)     BH_SEC_PASS_MAX_DAYS="$v" ;;
  esac
  if command_exists chage &&
     { [ "$(id -u 2>/dev/null)" = "0" ] || { command_exists sudo && sudo -n true >/dev/null 2>&1; }; }; then
    if [ "$(id -u 2>/dev/null)" = "0" ]; then
      out="$(sec_to 3 chage -l root | sed -n 's/^[[:space:]]*Password expires[[:space:]]*:[[:space:]]*//p' | head -n 1)"
    else
      out="$(sec_to 3 sudo -n chage -l root | sed -n 's/^[[:space:]]*Password expires[[:space:]]*:[[:space:]]*//p' | head -n 1)"
    fi
    case "$out" in
      never) BH_SEC_ROOT_EXPIRE="never" ;;
      '')    : ;;
      *)     BH_SEC_ROOT_EXPIRE="$(sec_to 2 date -d "$out" +%Y-%m-%d)"
             [ -n "$BH_SEC_ROOT_EXPIRE" ] || BH_SEC_ROOT_EXPIRE="$out" ;;
    esac
  fi
}

# sec_auditd (H6) — is the kernel audit daemon installed / running?
sec_auditd() {
  BH_SEC_AUDITD="unknown"
  if command_exists auditd || [ -x /usr/sbin/auditd ] || [ -x /sbin/auditd ] || [ -x /usr/local/sbin/auditd ]; then
    if { command_exists pgrep && pgrep -x auditd >/dev/null 2>&1; } || \
       sec_to 2 systemctl is-active auditd >/dev/null 2>&1; then
      BH_SEC_AUDITD="running"
    else
      BH_SEC_AUDITD="installed-not-running"
    fi
  else
    BH_SEC_AUDITD="not-installed"
  fi
}

# sec_ntp (H7) — clock synchronisation status. Primary: timedatectl's
# NTPSynchronized property (2s timeout). Fallbacks: chronyc tracking rc,
# the systemd-timesyncd "synchronized" marker, then chrony/timesyncd
# presence (installed but not tracking -> "not-synced").
sec_ntp() {
  BH_SEC_NTP="unknown"
  local v=""
  if command_exists timedatectl; then
    v="$(sec_to 2 timedatectl show -p NTPSynchronized --value)"
  fi
  case "$v" in
    yes)
      if sec_to 2 chronyc tracking >/dev/null 2>&1; then
        BH_SEC_NTP="synced (chronyd)"
      elif { command_exists pgrep && pgrep -x chronyd >/dev/null 2>&1; } || \
           [ -f /etc/chrony.conf ] || [ -f /etc/chrony/chrony.conf ]; then
        BH_SEC_NTP="synced (chronyd)"
      else
        BH_SEC_NTP="synced (timesyncd)"
      fi
      ;;
    no)
      BH_SEC_NTP="not-synced"
      ;;
    *)
      # timedatectl unusable (systemd absent / property unsupported)
      if [ -f /run/systemd/timesync/synchronized ]; then
        BH_SEC_NTP="synced (timesyncd)"
      elif sec_to 2 chronyc tracking >/dev/null 2>&1; then
        BH_SEC_NTP="synced (chronyd)"
      elif sec_to 2 systemctl is-active systemd-timesyncd >/dev/null 2>&1; then
        BH_SEC_NTP="synced (timesyncd)"
      elif { command_exists pgrep && pgrep -x chronyd >/dev/null 2>&1; } || \
           [ -f /etc/chrony.conf ] || [ -f /etc/chrony/chrony.conf ]; then
        BH_SEC_NTP="not-synced"   # chrony installed but tracking failed
      else
        BH_SEC_NTP="unknown"
      fi
      ;;
  esac
}

sec_misc() {
  local uid0
  uid0="$(awk -F: '$3==0{printf "%s ", $1}' /etc/passwd 2>/dev/null)"
  BH_UID0="${uid0% }"
  BH_LOGIN_SHELLS="$(awk -F: '$7 ~ /(bash|zsh|ksh|sh)$/{n++} END{print n+0}' /etc/passwd 2>/dev/null)"
  if [ -r /etc/shadow ]; then
    BH_EMPTY_PW="$(awk -F: '$2==""{n++} END{print n+0}' /etc/shadow 2>/dev/null)"
  fi
  local nopass=0 sudoers_readable=0
  if [ -r /etc/sudoers ]; then
    sudoers_readable=1
    grep -qs 'NOPASSWD' /etc/sudoers && nopass=1
  fi
  if [ -d /etc/sudoers.d ]; then
    grep -qs 'NOPASSWD' /etc/sudoers.d/* 2>/dev/null && nopass=1
    if ls /etc/sudoers.d/* >/dev/null 2>&1; then sudoers_readable=1; fi
  fi
  if [ "$nopass" = "1" ]; then
    BH_SUDO_NOPASS="yes (NOPASSWD entries found)"
  elif [ "$sudoers_readable" = "1" ]; then
    BH_SUDO_NOPASS="no"
  fi
  BH_ASLR="$(cat /proc/sys/kernel/randomize_va_space 2>/dev/null)"
  if grep -qs 'Unattended-Upgrade' /etc/apt/apt.conf.d/20auto-upgrades 2>/dev/null; then
    BH_AUTO_UPD="enabled (unattended-upgrades)"
  elif [ -f /etc/dnf/automatic.conf ]; then
    BH_AUTO_UPD="dnf-automatic configured"
  elif command_exists dnf && [ -f /etc/dnf/dnf.conf ] && grep -qs 'automatic' /etc/dnf/dnf.conf; then
    BH_AUTO_UPD="dnf-automatic configured"
  else
    BH_AUTO_UPD="not detected"
  fi
  if command_exists ss; then
    BH_LISTEN="$(ss -tulnH 2>/dev/null | awk '$1=="tcp"||$1=="tcp6"{print $5}' | sed 's/.*://' | sort -n | uniq | paste -sd ',' - | head -c 200)"
    [ -n "$BH_LISTEN" ] || BH_LISTEN="none" # ss exists but zero listeners — don't claim "ss unavailable"
  fi
}

# =====================================================================
# v5.0 deep-scan additions (C10) — helpers + checks called from sec_audit.
# All checks are passive local reads, timeout-wrapped, degrade to silence,
# and print through sec_line so the posture counters stay correct.
# =====================================================================

# bhv5c10_to_err SECS CMD... — timeout wrapper that KEEPS stderr (sshd -t/-V
# report there); stdin is closed so nothing can block on a tty.
bhv5c10_to_err() {
  local s="$1"; shift
  if command_exists timeout; then
    timeout "$s" "$@" 2>&1 </dev/null
  else
    "$@" 2>&1 </dev/null
  fi
}

# bhv5c10_sanitize TEXT — one short single-line printable message safe for
# report sinks: control bytes and tabs flattened, capped at 140 chars. With
# BH_REDACT=1 home-directory paths (which embed usernames) are masked too.
bhv5c10_sanitize() {
  local s
  s="$(printf '%s' "$1" | tr -d '\000-\010\013\014\015\016-\037' | tr '\011' ' ')"
  if [ "${BH_REDACT:-0}" = "1" ]; then
    s="$(printf '%s' "$s" | sed 's#/home/[^/[:space:]]*#/home/<redacted>#g')"
  fi
  printf '%s' "${s:0:140}"
}

# bhv5c10_norm VALUE — lowercase, strip quotes, normalize root-login synonyms
# so both sides of the declared/effective diff compare equal ("without-password"
# is a legacy synonym sshd -T always prints as "prohibit-password").
bhv5c10_norm() {
  local v
  v="$(printf '%s' "${1:-}" | tr '[:upper:]' '[:lower:]' | tr -d '"')"
  case "$v" in without-password) v="prohibit-password" ;; esac
  printf '%s' "$v"
}

# bhv5c10_decl KEY — first match of KEY in the raw declared stream (Match
# blocks skipped, inline comments stripped, value lowercased); mirrors the
# raw-config branch of sec_sshd_opt.
bhv5c10_decl() {
  [ "${#BH_SSH_CFG_LINES[@]}" -gt 0 ] 2>/dev/null || return 0
  printf '%s\n' "${BH_SSH_CFG_LINES[@]}" | awk -v k="$1" '
    { sub(/#.*/, "") }
    tolower($1)=="match" { inmatch=1; next }
    inmatch { next }
    tolower($1)==tolower(k){ $1=""; sub(/^[ \t]+/, ""); print tolower($0); exit }'
}

# bhv5c10_decl_ports — every Port value in the raw declared stream (Port is
# cumulative in sshd, unlike the single-value directives).
bhv5c10_decl_ports() {
  [ "${#BH_SSH_CFG_LINES[@]}" -gt 0 ] 2>/dev/null || return 0
  printf '%s\n' "${BH_SSH_CFG_LINES[@]}" | awk '
    { sub(/#.*/, "") }
    tolower($1)=="match" { inmatch=1; next }
    inmatch { next }
    tolower($1)=="port" { print tolower($2) }'
}

# bhv5c10_rsa_bits BLOB — RSA modulus bit count via base64+od+awk (SSH wire
# format: 4-byte BE len(type) + type + 4-byte BE len(mpint) + mpint; the
# leading zero bits of the first modulus byte are subtracted — a sign-marker
# 0x00 byte counts as exactly 8). Prints nothing when the blob is unusable.
# Fallback only for systems without ssh-keygen; never prints key material.
bhv5c10_rsa_bits() {
  local dec
  dec="$(printf '%s' "$1" | base64 -d 2>/dev/null | od -An -v -tu1 | tr -s ' \n' ' ')"
  [ -n "$dec" ] || return 0
  printf '%s\n' "$dec" | awk '
    { for (i = 1; i <= NF; i++) b[i] = $i }
    END {
      if (NF < 16) exit
      n1 = b[1]*16777216 + b[2]*65536 + b[3]*256 + b[4]
      if (n1 < 1 || n1 > 100) exit
      p = 4 + n1
      if (NF < p + 5) exit
      n2 = b[p+1]*16777216 + b[p+2]*65536 + b[p+3]*256 + b[p+4]
      if (n2 < 1 || n2 > 1024) exit
      lz = 0
      for (i = 7; i >= 0; i--) { if (int(b[p+5] / (2 ^ i)) % 2 == 1) break; lz++ }
      print n2 * 8 - lz
    }'
}

# (C1) sshd config syntax gate — `sshd -t` is a test-mode read (parses the
# config, loads nothing, starts nothing). A config that fails -t means the
# NEXT restart breaks SSH: [BAD]. Non-root: skip silently (host keys unread).
# Also records the daemon version (cheap, unprivileged) in BH_SSHD_VER.
bhv5c10_sshd_cfg_valid() {
  BH_SSHD_CFG_VALID="n/a"; BH_SSHD_VER=""
  [ -n "$BH_SSHD_BIN" ] || return 0
  local vout
  vout="$(bhv5c10_to_err 2 "$BH_SSHD_BIN" -V | head -n 1)"
  BH_SSHD_VER="$(printf '%s\n' "$vout" | sed -n 's/.*\(OpenSSH_[0-9][0-9.p]*\).*/\1/p')"
  if [ -z "$BH_SSHD_VER" ]; then
    vout="$(bhv5c10_to_err 2 "$BH_SSHD_BIN" -h | head -n 1)"
    BH_SSHD_VER="$(printf '%s\n' "$vout" | sed -n 's/.*\(OpenSSH_[0-9][0-9.p]*\).*/\1/p')"
  fi
  [ "$(id -u 2>/dev/null)" = "0" ] || { BH_SSHD_CFG_VALID="skipped (non-root)"; return 0; }
  local err rc msg
  err="$(bhv5c10_to_err 3 "$BH_SSHD_BIN" -t)"
  rc=$?
  if [ "$rc" = "0" ]; then
    BH_SSHD_CFG_VALID="ok"
    sec_line ok "sshd config syntax valid (sshd -t)"
  else
    BH_SSHD_CFG_VALID="invalid"
    msg="$(bhv5c10_sanitize "$(printf '%s\n' "$err" | head -n 1)")"
    if [ -n "$msg" ] && [ "${BH_REDACT:-0}" != "1" ]; then
      sec_line bad "sshd config INVALID — next restart will fail ssh: $msg"
    else
      sec_line bad "sshd config INVALID — next restart will fail ssh (no error detail)"
    fi
  fi
}

# (C2) declared vs effective config — when sshd -T worked, diff the raw
# (declared) first-match values against the effective ones: a difference
# means a Match block or drop-in overrode the global setting -> WARN.
bhv5c10_eff_decl() {
  BH_SSH_EFF_DECL="n/a"
  [ "$BH_SSH_T_OK" = "1" ] || return 0
  if [ "${#BH_SSH_CFG_LINES[@]}" -eq 0 ] 2>/dev/null; then
    # v4 only builds the raw line stream when sshd -T fails; build it here so
    # both views exist (sec_sshd_read is the same Include-aware reader).
    BH_SSH_CFG_LINES=()
    [ -r /etc/ssh/sshd_config ] && sec_sshd_read /etc/ssh/sshd_config 0
  fi
  [ "${#BH_SSH_CFG_LINES[@]}" -gt 0 ] 2>/dev/null || return 0
  local n=0 key d e dps eps
  for key in passwordauthentication permitrootlogin pubkeyauthentication \
             x11forwarding kbdinteractiveauthentication maxauthtries; do
    d="$(bhv5c10_norm "$(bhv5c10_decl "$key")")"
    e="$(bhv5c10_norm "$(sec_sshd_opt "$key" "")")"
    [ -n "$d" ] && [ -n "$e" ] || continue
    if [ "$d" != "$e" ]; then
      n=$((n + 1))
      sec_line warn "declared '$key $d' overridden to '$e' (Match/drop-in)"
    fi
  done
  # Port is cumulative (may repeat) — compare the sorted unique port SETS
  dps="$(bhv5c10_decl_ports | sed '/^$/d' | sort -n | uniq | paste -sd ',' -)"
  eps="$(sec_sshd_all port | tr ',' '\n' | sed '/^$/d' | sort -n | uniq | paste -sd ',' -)"
  if [ -n "$dps" ] && [ -n "$eps" ] && [ "$dps" != "$eps" ]; then
    n=$((n + 1))
    sec_line warn "declared 'Port $dps' overridden to '$eps' (Match/drop-in)"
  fi
  if [ "$n" -gt 0 ]; then
    BH_SSH_EFF_DECL="overrides:$n"
  else
    BH_SSH_EFF_DECL="declared=effective"
    sec_line ok "sshd declared config matches effective config (raw lines cross-checked with sshd -T)"
  fi
  return 0
}

# (C3) socket-activation false-positive guard — Ubuntu 24.04 / Debian 12 ship
# ssh.socket, so no daemon process exists until the first connection. When the
# socket units are active, flip the earlier "NOT detected" warn verdict to OK.
bhv5c10_socket_fp() {
  BH_SSH_SOCKET_FP=0
  [ "$BH_SSH_RUNNING" = "0" ] || return 0
  [ "$BH_SSH_FOUND" = "1" ] || return 0
  [ -d /run/systemd/system ] || return 0
  local u act=0 i flipped=0
  for u in ssh.socket sshd.socket; do
    if sec_to 3 systemctl is-active "$u" >/dev/null 2>&1; then act=1; break; fi
  done
  [ "$act" = "1" ] || return 0
  if [ "${#BH_SEC_LINES[@]}" -gt 0 ] 2>/dev/null; then
    for i in "${!BH_SEC_LINES[@]}"; do
      case "${BH_SEC_LINES[i]}" in
        *"sshd process: NOT detected"*)
          BH_SEC_LINES[i]="  [OK]  sshd via systemd socket-activation (no daemon process — normal on Ubuntu 24.04/Debian 12)"
          BH_SEC_WARN=$((BH_SEC_WARN - 1))
          BH_SEC_PASS=$((BH_SEC_PASS + 1))
          flipped=1
          ;;
      esac
    done
  fi
  BH_SSH_SOCKET_FP=1
  [ "$flipped" = "1" ] || sec_line ok "sshd via systemd socket-activation (no daemon process — normal on Ubuntu 24.04/Debian 12)"
  return 0
}

# (C4) authorized_keys deep scan behind sec_auth_keys: DSA key detection
# (removed in OpenSSH 9.8+), comment CLASS counting (never the comment
# content), key-file rotation age (>730 days), and an RSA bit-count fallback
# via od/awk when ssh-keygen is unavailable. Counts only — no key material,
# no usernames, no comment text ever reaches the report.
bhv5c10_ak_deep() {
  BH_AK_DSA=0; BH_AK_STALE=0; BH_AK_RSA_FB=0; BH_AK_DEEP_KEYS=0
  BH_AK_CMT_EMAIL=0; BH_AK_CMT_HOST=0; BH_AK_CMT_NONE=0; BH_AK_CMT_OTHER=0
  local have_kg=0 have_b64=0
  command_exists ssh-keygen && have_kg=1
  command_exists base64 && have_b64=1
  local d kf owner tok path now cutoff mt kt cls bits f_dsa seen=""
  local homes="/root"
  for d in /home/*; do [ -d "$d" ] && homes="$homes $d"; done
  now="$(date +%s 2>/dev/null)"
  case "$now" in ''|*[!0-9]*) now=0 ;; esac
  cutoff=$(( now - 730 * 86400 ))
  for d in $homes; do
    owner="$(stat -c %U "$d" 2>/dev/null)"
    [ -n "$owner" ] || owner="${d##*/}"
    for tok in ${BH_SEC_AUTHKEYS_PATH:-".ssh/authorized_keys"}; do
      path="$tok"
      case "$path" in *%h*) path="${path//%h/$d}" ;; esac
      case "$path" in *%u*) path="${path//%u/$owner}" ;; esac
      case "$path" in
        /*) : ;;
        *)  path="$d/$path" ;;
      esac
      # dedup like sec_auth_keys: absolute (%u-free) paths repeat per home
      case ",$seen," in *",${path},"*) continue ;; esac
      seen="$seen,$path"
      kf="$path"
      [ -f "$kf" ] && [ -r "$kf" ] || continue
      f_dsa=0
      # one awk pass per file: key type + comment CLASS per key line
      # (IFS=" " — with IFS= unset-field-splitting would put the whole line in $kt)
      while IFS=" " read -r kt cls; do
        [ -n "$kt" ] || continue
        BH_AK_DEEP_KEYS=$((BH_AK_DEEP_KEYS + 1))
        case "$kt" in
          ssh-dss*)
            f_dsa=1
            BH_AK_DSA=$((BH_AK_DSA + 1))
            # ssh-keygen -lf already counted DSA (1024 bits) as weak in v4;
            # only add here when that path is unavailable (no double count)
            [ "$have_kg" = "1" ] || BH_AK_WEAK=$((BH_AK_WEAK + 1))
            ;;
        esac
        case "$cls" in
          email) BH_AK_CMT_EMAIL=$((BH_AK_CMT_EMAIL + 1)) ;;
          host)  BH_AK_CMT_HOST=$((BH_AK_CMT_HOST + 1)) ;;
          other) BH_AK_CMT_OTHER=$((BH_AK_CMT_OTHER + 1)) ;;
          *)     BH_AK_CMT_NONE=$((BH_AK_CMT_NONE + 1)) ;;
        esac
      done < <(awk '
        {
          t = ""
          for (i = 1; i <= 6 && i <= NF; i++) {
            if ($i ~ /^(ssh-dss|ssh-rsa|ecdsa-sha2-|ssh-ed25519|sk-)/ && $i !~ /[",=]/) { t = $i; break }
          }
          if (t == "" || i + 1 > NF) next
          cls = "none"
          if (i + 2 <= NF) {
            c = $(i + 2)
            if (c ~ /@/) cls = "email"
            else if (c ~ /^[A-Za-z0-9._:-]+$/ && (c ~ /\./ || c ~ /^[0-9]+$/)) cls = "host"
            else cls = "other"
          }
          print t, cls
        }' "$kf")
      [ "$f_dsa" = "1" ] && sec_line warn "DSA key present (removed in OpenSSH 9.8+)"
      # RSA bit-count fallback when v4's ssh-keygen -lf path is unavailable
      if [ "$have_kg" = "0" ] && [ "$have_b64" = "1" ]; then
        while IFS= read -r bits; do
          [ -n "$bits" ] || continue
          BH_AK_RSA_FB=$((BH_AK_RSA_FB + 1))
          bits="$(bhv5c10_rsa_bits "$bits")"
          case "$bits" in
            ''|*[!0-9]*) : ;;
            *) [ "$bits" -lt 2048 ] && BH_AK_WEAK=$((BH_AK_WEAK + 1)) ;;
          esac
        done < <(awk '{ for (i = 1; i <= 6 && i <= NF; i++) if ($i == "ssh-rsa") { if (i + 1 <= NF) print $(i + 1); break } }' "$kf")
      fi
      mt="$(stat -c %Y "$kf" 2>/dev/null)"
      case "$mt" in
        ''|*[!0-9]*) : ;;
        *) [ "$now" -gt 0 ] && [ "$mt" -lt "$cutoff" ] && BH_AK_STALE=$((BH_AK_STALE + 1)) ;;
      esac
    done
  done
  if [ "$BH_AK_STALE" -gt 0 ]; then
    sec_line info "authorized_keys not rotated in >2y: $BH_AK_STALE file(s)"
  fi
  if [ "$BH_AK_DEEP_KEYS" -gt 0 ]; then
    local cmt_other=""
    [ "$BH_AK_CMT_OTHER" -gt 0 ] && cmt_other=" other:$BH_AK_CMT_OTHER"
    sec_line info "key comment classes: email:$BH_AK_CMT_EMAIL host:$BH_AK_CMT_HOST none:$BH_AK_CMT_NONE${cmt_other} (content never printed)"
  fi
  return 0
}

# (C5) host key audit — /etc/ssh/ssh_host_*_key.pub is world-readable by
# design: DSA -> deprecated warn, RSA < 2048 -> BAD, RSA 2048 -> prefer
# 3072+/ed25519 note, all keys sharing one mtime second -> image-clone note.
# Fingerprints print to 16 chars only. ssh-keygen -lf on a .pub is a pure read.
bhv5c10_hostkey_audit() {
  BH_HOSTKEY_AUDIT=""
  local f n=0 dsa=0 small=0 mid=0 first_mt="" same=1 out bits tp fp fps mt
  for f in /etc/ssh/ssh_host_*_key.pub; do
    [ -f "$f" ] && [ -r "$f" ] || continue
    n=$((n + 1))
    if command_exists ssh-keygen; then
      out="$(sec_to 2 ssh-keygen -lf "$f" | head -n 1)"
      bits="${out%%[[:space:]]*}"
      tp="$(printf '%s\n' "$out" | sed -n 's/.*(\([A-Za-z0-9-]*\)).*/\1/p')"
      fp="$(printf '%s\n' "$out" | awk '{print $2}')"
      fps=""
      [ -n "$fp" ] && fps=" (fp ${fp:0:16})"
      case "$tp" in
        DSA)
          dsa=$((dsa + 1))
          sec_line warn "host key type DSA deprecated${fps} — regenerate with ed25519"
          ;;
        RSA)
          case "$bits" in
            ''|*[!0-9]*) : ;;
            *)
              if [ "$bits" -lt 2048 ]; then
                small=$((small + 1))
                sec_line bad "host key RSA too small: $bits bits${fps} — regenerate with 3072+ bits or ed25519"
              elif [ "$bits" -eq 2048 ]; then
                mid=$((mid + 1))
                sec_line info "host key RSA 2048 bits${fps} — prefer 3072+ or ed25519"
              fi
              ;;
          esac
          ;;
      esac
    fi
    mt="$(stat -c %Y "$f" 2>/dev/null)"
    case "$mt" in
      ''|*[!0-9]*) : ;;
      *)
        if [ -z "$first_mt" ]; then first_mt="$mt"
        elif [ "$mt" != "$first_mt" ]; then same=0
        fi
        ;;
    esac
  done
  [ "$n" -gt 0 ] || return 0
  if [ "$n" -gt 1 ] && [ "$same" = "1" ] && [ -n "$first_mt" ]; then
    sec_line info "host keys copied from image (all public keys share one mtime second)"
  fi
  BH_HOSTKEY_AUDIT="keys:$n dsa:$dsa rsa_lt2048:$small rsa_2048:$mid"
  return 0
}

# (C6) certificate auth posture: TrustedUserCAKeys / AuthorizedKeysCommand /
# RevokedKeys / CASignatureAlgorithms from the effective (or declared) config.
bhv5c10_cert_auth() {
  BH_SSH_CA="none"
  [ "$BH_SSH_FOUND" = "1" ] || return 0
  local ca cmd rev casig
  ca="$(sec_sshd_opt trustedusercakeys "")"
  cmd="$(sec_sshd_opt authorizedkeyscommand "")"
  rev="$(sec_sshd_opt revokedkeys "")"
  casig="$(sec_sshd_opt casignaturealgorithms "")"
  case "$(bhv5c10_norm "$ca")" in ''|none) ca="" ;; esac
  case "$(bhv5c10_norm "$cmd")" in ''|none|internal) cmd="" ;; esac
  case "$(bhv5c10_norm "$rev")" in ''|none) rev="" ;; esac
  BH_SSH_CA=""
  [ -n "$ca" ] && BH_SSH_CA="ca"
  [ -n "$cmd" ] && BH_SSH_CA="${BH_SSH_CA:+$BH_SSH_CA+}command"
  [ -n "$BH_SSH_CA" ] || BH_SSH_CA="none"
  if [ -n "$ca" ]; then
    sec_line ok "certificate-based auth available (TrustedUserCAKeys configured${casig:+, CASignatureAlgorithms set})"
    if [ -z "$rev" ]; then
      sec_line info "certificate CA configured but no RevokedKeys — consider 'RevokedKeys /etc/ssh/revoked_keys'"
    fi
  fi
  [ -n "$cmd" ] && sec_line info "AuthorizedKeysCommand: external key source configured"
  return 0
}

# (C7) Match-block scan over the raw config stream: sftp-only chroot blocks
# (ForceCommand internal-sftp + ChrootDirectory) are counted, any external
# ForceCommand is flagged, and a missing Subsystem sftp is noted.
bhv5c10_match_sftp() {
  BH_SSH_MATCH_SFTP=""
  [ "$BH_SSH_FOUND" = "1" ] || return 0
  local res sftp_n=0 ext_n=0 has_sftp=""
  if [ "${#BH_SSH_CFG_LINES[@]}" -gt 0 ] 2>/dev/null; then
    # one "block" = everything up to the next Match line (a global ForceCommand
    # before any Match counts as the first block); BEGIN{seen=1} seeds it
    res="$(printf '%s\n' "${BH_SSH_CFG_LINES[@]}" | awk '
      BEGIN { seen = 1 }
      { sub(/#.*/, "") }
      tolower($1)=="match" {
        if (seen) { if (ch && sfc) sftp++; else if (efc) other++ }
        seen=1; sfc=0; efc=0; ch=0; next
      }
      tolower($1)=="forcecommand" {
        if (tolower($2) ~ /^internal-sftp/) sfc=1; else efc=1; next
      }
      tolower($1)=="chrootdirectory" { ch=1; next }
      END {
        if (seen) { if (ch && sfc) sftp++; else if (efc) other++ }
        print sftp + 0, other + 0
      }')"
  fi
  sftp_n="${res%% *}"; ext_n="${res#* }"
  case "$sftp_n" in ''|*[!0-9]*) sftp_n=0 ;; esac
  case "$ext_n" in ''|*[!0-9]*) ext_n=0 ;; esac
  if [ "$sftp_n" -gt 0 ]; then
    BH_SSH_MATCH_SFTP="$sftp_n block(s)"
    sec_line info "sftp-only chroot accounts: $sftp_n Match block(s) (ForceCommand internal-sftp + ChrootDirectory)"
  fi
  if [ "$ext_n" -gt 0 ]; then
    sec_line warn "ForceCommand runs an external command in $ext_n block(s) — review what it executes"
  fi
  if [ "${#BH_SSH_CFG_LINES[@]}" -gt 0 ] 2>/dev/null; then
    has_sftp="$(printf '%s\n' "${BH_SSH_CFG_LINES[@]}" | awk '{ sub(/#.*/, "") } tolower($1)=="subsystem" && tolower($2)=="sftp" { f=1 } END { print f + 0 }')"
  elif [ "$BH_SSH_T_OK" = "1" ] && [ -n "$BH_SSH_T_OUT" ]; then
    has_sftp="$(printf '%s\n' "$BH_SSH_T_OUT" | awk 'tolower($1)=="subsystem" && tolower($2)=="sftp" { f=1 } END { print f + 0 }')"
  fi
  [ "$has_sftp" = "0" ] && sec_line info "Subsystem sftp: not configured (SFTP file transfers unavailable)"
  return 0
}

# (C8) forwarding sweep: TCP/agent forwarding plus permissive root login is a
# pivot surface on multi-user boxes; PerSourcePenalties no (OpenSSH 9.8+)
# disables the per-source brute-force penalties.
bhv5c10_fwd_sweep() {
  BH_SSH_FWD=""
  [ "$BH_SSH_FOUND" = "1" ] || return 0
  local tcp agent tunnel gw pen lu multi=0 fwd_on=0
  tcp="$(sec_sshd_opt allowtcpforwarding "")"
  agent="$(sec_sshd_opt allowagentforwarding "")"
  tunnel="$(sec_sshd_opt permittunnel "")"
  gw="$(sec_sshd_opt gatewayports "")"
  pen="$(sec_sshd_opt persourcepenalties "")"
  BH_SSH_FWD="tcp:${tcp:-unset} agent:${agent:-unset} tunnel:${tunnel:-unset} gatewayports:${gw:-unset} penalties:${pen:-unset}"
  case "$(bhv5c10_norm "$tcp")" in yes|local|remote) fwd_on=1 ;; esac
  [ "$(bhv5c10_norm "$agent")" = "yes" ] && fwd_on=1
  lu="$(awk -F: '$7 ~ /(bash|zsh|ksh|sh)$/{n++} END{print n+0}' /etc/passwd 2>/dev/null)"
  [ "$lu" -gt 1 ] 2>/dev/null && multi=1
  if [ "$fwd_on" = "1" ] && [ "$BH_SSH_ROOTLOGIN" = "permissive" ] && [ "$multi" = "1" ]; then
    sec_line info "forwarding enabled (pivot surface): AllowTcpForwarding/AllowAgentForwarding on with PermitRootLogin permissive on a multi-user box"
  fi
  case "$(bhv5c10_norm "$pen")" in
    no) sec_line warn "PerSourcePenalties: no — per-source brute-force penalties disabled (OpenSSH 9.8+)" ;;
  esac
  return 0
}

# (C9) topology cross-check: listeners that are NOT in the configured Port
# set, the sshd master process count (sshd-session children excluded via
# PPid), and wildcard binds from the ss listener table.
bhv5c10_topology() {
  BH_SSH_TOPO=""
  [ "$BH_SSH_RUNNING" = "1" ] || return 0
  local p unconf="" masters="" kids=0 total=0 bind_wild=0 ssout line la
  if [ -n "$BH_SSH_LISTENING" ]; then
    for p in $(printf '%s\n' "$BH_SSH_LISTENING" | tr ',' ' '); do
      case ",$BH_SSH_PORTS," in *",${p},"*) : ;; *) unconf="${unconf:+$unconf,}$p" ;; esac
    done
    [ -n "$unconf" ] && sec_line warn "unconfigured sshd listener: port(s) $unconf — not in the sshd_config Port set"
  fi
  if command_exists pgrep; then
    local pids all pid ppid
    pids="$(pgrep -x sshd 2>/dev/null || true)"
    if [ -n "$pids" ]; then
      total="$(printf '%s\n' "$pids" | grep -c . || true)"
      all=" $(printf '%s\n' "$pids" | tr '\n' ' ')"
      for pid in $pids; do
        ppid="$(awk '/^PPid/{print $2}' "/proc/$pid/status" 2>/dev/null)"
        case "$all" in *" $ppid "*) kids=$((kids + 1)) ;; esac
      done
      masters=$(( total - kids ))
      [ "$masters" -lt 0 ] 2>/dev/null && masters=0
      if [ "$masters" -gt 1 ]; then
        sec_line warn "multiple sshd master processes detected ($masters) — one daemon should own the port(s)"
      fi
    fi
  fi
  if command_exists ss; then
    ssout="$(sec_to 3 ss -tlnpH || true)"
    [ -n "$ssout" ] || ssout="$(sec_to 3 ss -tlnH || true)"
    if [ -n "$ssout" ]; then
      while IFS= read -r line; do
        [ -n "$line" ] || continue
        # shellcheck disable=SC2086  # fixed-column split of an ss line
        set -- $line
        la="$4"
        case "$la" in ''|LISTEN) continue ;; esac
        case "$line" in
          *sshd*) : ;;
          *) case ",$BH_SSH_LISTENING," in *",${la##*:},"*) : ;; *) continue ;; esac ;;
        esac
        la="${la%:*}"
        case "$la" in
          0.0.0.0|\*|::|\[::\]) bind_wild=1 ;;
        esac
      done < <(printf '%s\n' "$ssout")
    fi
  fi
  BH_SSH_TOPO="cfg:${BH_SSH_PORTS:-?} listen:${BH_SSH_LISTENING:-none} masters:${masters:-n/a}${unconf:+ unconf:$unconf}"
  if [ "$bind_wild" = "1" ]; then
    BH_SSH_TOPO="$BH_SSH_TOPO bind:wildcard"
    sec_line info "sshd binds all interfaces (0.0.0.0/[::]) — confirm the firewall limits exposure"
  fi
  return 0
}

# (C10) auth-log deep view behind sec_failed_logins: accepted PASSWORD logins
# (proof password auth is live), distinct invalid-user names, btmp/lastb
# volume, fail2ban banned count. Counts only — no usernames, IPs or hosts.
bhv5c10_auth_log_deep() {
  BH_AUTH_PW_LOGIN=0; BH_AUTH_INVALID_USERS=0; BH_LASTB_N=0; BH_F2B_BANNED=-1
  BH_AUTH_LOG_SUM=""
  local pw=0 inv=0 src="" n=0 jout fb
  local jerr="$BH_RUNDIR/journal.err"
  # same journal gate as sec_failed_logins (journalctl "succeeds" with no files)
  if command_exists journalctl && journalctl -n 1 >/dev/null 2>&1; then
    if command_exists timeout; then
      jout="$(timeout 5 journalctl -u ssh -u sshd --since '-24 hours' --no-pager 2>"$jerr" || true)"
    else
      jout="$(journalctl -u ssh -u sshd --since '-24 hours' --no-pager 2>"$jerr" || true)"
    fi
    if [ -n "$jout" ] && ! grep -qi 'no journal files' "$jerr" 2>/dev/null; then
      src="journalctl"
      pw="$(printf '%s\n' "$jout" | grep -c 'Accepted password' || true)"
      inv="$(printf '%s\n' "$jout" | awk '/Invalid user/{print $8}' | sort -u | grep -c . || true)"
    fi
  fi
  if [ -z "$src" ] && [ -r /var/log/auth.log ]; then
    src="auth.log"
    pw="$(grep -hc 'Accepted password' /var/log/auth.log 2>/dev/null || true)"
    inv="$(grep -h 'Invalid user' /var/log/auth.log 2>/dev/null | awk '{print $8}' | sort -u | grep -c . || true)"
  fi
  case "$pw" in ''|*[!0-9]*) pw=0 ;; esac
  case "$inv" in ''|*[!0-9]*) inv=0 ;; esac
  BH_AUTH_PW_LOGIN="$pw"; BH_AUTH_INVALID_USERS="$inv"
  if [ -r /var/log/btmp ] && command_exists lastb; then
    n="$(sec_to 3 lastb -n 20 | awk 'NF && $0 !~ /btmp begins/ {n++} END{print n+0}')"
    case "$n" in ''|*[!0-9]*) n=0 ;; esac
    BH_LASTB_N="$n"
    [ "$n" -gt 0 ] && sec_line info "lastb: $n failed-login entr(ies) in /var/log/btmp (showing up to 20)"
  fi
  if command_exists fail2ban-client; then
    fb="$(sec_to 3 fail2ban-client status sshd | sed -n 's/.*Currently banned:[[:space:]]*\([0-9][0-9]*\).*/\1/p' | head -n 1)"
    case "$fb" in ''|*[!0-9]*) fb="" ;; esac
    if [ -n "$fb" ]; then
      BH_F2B_BANNED="$fb"
      [ "$fb" -gt 0 ] 2>/dev/null && sec_line info "fail2ban sshd jail: $fb IP(s) currently banned"
    fi
  fi
  if [ "$pw" -gt 0 ]; then
    sec_line warn "password logins observed in logs (live use): $pw accepted password login(s) in $src"
  fi
  if [ "$inv" -gt 0 ]; then
    sec_line info "invalid-user probes: $inv distinct name(s) — brute-force background noise (count only)"
  fi
  if [ -n "$src" ] || [ "$BH_LASTB_N" -gt 0 ] || [ "$BH_F2B_BANNED" -ge 0 ] 2>/dev/null; then
    local fl="$BH_SSH_FAILS_N"
    [ "$fl" -ge 0 ] 2>/dev/null || fl="n/a"
    BH_AUTH_LOG_SUM="fail:$fl invalid-users:$BH_AUTH_INVALID_USERS pw-accepted:$BH_AUTH_PW_LOGIN"
  fi
  return 0
}

# (C11) MFA posture: AuthenticationMethods plus a 2FA PAM stack; UsePAM no
# also means account policies (expiry/lockout) are bypassed for SSH logins.
bhv5c10_mfa() {
  BH_SSH_MFA=""
  [ "$BH_SSH_FOUND" = "1" ] || return 0
  local am up pam2fa=0
  am="$(sec_sshd_opt authenticationmethods "")"
  up="$(sec_sshd_opt usepam "")"
  if [ -r /etc/pam.d/sshd ] && grep -qsE 'pam_google_authenticator|pam_u2f|pam_oath|pam_duo' /etc/pam.d/sshd; then
    pam2fa=1
  fi
  case "$(bhv5c10_norm "$am")" in ''|any|none) am="" ;; esac
  if [ -n "$am" ] && [ "$pam2fa" = "1" ]; then
    BH_SSH_MFA="enforced"
    sec_line ok "MFA enforced (AuthenticationMethods: $am + 2FA PAM module in /etc/pam.d/sshd)"
  elif [ "$(bhv5c10_norm "$up")" = "no" ]; then
    BH_SSH_MFA="usepam-no"
    sec_line warn "UsePAM no — account policies (expiry/lockout/2FA hooks) bypassed for SSH"
  elif [ -n "$am" ]; then
    BH_SSH_MFA="methods-only"
    sec_line info "AuthenticationMethods: $am but no 2FA PAM module found in /etc/pam.d/sshd"
  else
    BH_SSH_MFA="none"
    sec_line info "MFA: not configured (single-factor SSH)"
  fi
  return 0
}

# run_sec_audit — gate used by main: honors --no-sec / BH_NO_SEC and sets
# BH_SEC_SKIPPED so the report can say why the audit is missing.
run_sec_audit() {
  if [ "${BH_NO_SEC:-0}" = "1" ]; then
    BH_SEC_SKIPPED=1
    log "SEC audit skipped (--no-sec)"
    return 0
  fi
  BH_SEC_SKIPPED=0
  sec_audit
}

sec_audit() {
  BH_SEC_PASS=0; BH_SEC_WARN=0; BH_SEC_BAD=0
  BH_SEC_LINES=()
  BH_SEC_POSTURE="n/a"

  log "SEC audit: sshd config, authorized_keys, firewall, local accounts..."
  sec_sshd_load

  # ---- SSH server configuration ----
  if [ "$BH_SSH_FOUND" = "1" ]; then
    BH_SSH_PORTS="$(sec_sshd_all port)"
    [ -n "$BH_SSH_PORTS" ] || BH_SSH_PORTS="22"
    BH_SSH_PWDAUTH="$(sec_sshd_opt passwordauthentication "")"
    BH_SSH_PUBKEY="$(sec_sshd_opt pubkeyauthentication "")"
    BH_SSH_ROOTLOGIN="$(sec_sshd_opt permitrootlogin "")"
    BH_SSH_MAXAUTH="$(sec_sshd_opt maxauthtries "")"
    BH_SSH_PERMPTY="$(sec_sshd_opt permitemptypasswords "")"
    BH_SSH_LOGINGRACE="$(sec_sshd_opt logingracetime "")"
    BH_SSH_X11="$(sec_sshd_opt x11forwarding "")"
    BH_SSH_KBDINT="$(sec_sshd_opt kbdinteractiveauthentication "")"
    BH_SSH_ALLOWUSERS="$(sec_sshd_opt allowusers "")"
    local ag
    ag="$(sec_sshd_opt allowgroups "")"
    [ -n "$ag" ] && BH_SSH_ALLOWUSERS="${BH_SSH_ALLOWUSERS:+$BH_SSH_ALLOWUSERS,}$ag"

    case "$BH_SSH_PWDAUTH" in
      no)  sec_line ok   "PasswordAuthentication: no (key-only login)" ;;
      yes) sec_line warn "PasswordAuthentication: yes — brute-force surface; set 'PasswordAuthentication no'" ;;
      *)   sec_line warn "PasswordAuthentication: not set (OpenSSH default: yes)" ;;
    esac
    case "$BH_SSH_PUBKEY" in
      no)  sec_line warn "PubkeyAuthentication: no" ;;
      *)   sec_line ok   "PubkeyAuthentication: ${BH_SSH_PUBKEY:-yes (default)}" ;;
    esac
    case "$BH_SSH_ROOTLOGIN" in
      yes) sec_line bad  "PermitRootLogin: yes — direct root brute-force possible" ;;
      no)  sec_line ok   "PermitRootLogin: no" ;;
      *)   sec_line info "PermitRootLogin: ${BH_SSH_ROOTLOGIN:-prohibit-password (default)} — 'no' is safer with a sudo user" ;;
    esac
    sec_line info "SSH port(s): $BH_SSH_PORTS${BH_SSH_MAXAUTH:+ | MaxAuthTries: $BH_SSH_MAXAUTH} | source: $BH_SSH_CFG_SRC"

    case "$BH_SSH_PERMPTY" in
      yes) sec_line bad "PermitEmptyPasswords: yes — accounts with empty passwords could log in" ;;
      no)  sec_line ok  "PermitEmptyPasswords: no" ;;
      *)   sec_line ok  "PermitEmptyPasswords: ${BH_SSH_PERMPTY:-no (default)}" ;;
    esac
    if [ -z "$BH_SSH_LOGINGRACE" ]; then
      sec_line info "LoginGraceTime: not set (OpenSSH default: 120s)"
    else
      local lgt_s
      lgt_s="$(sec_grace_secs "$BH_SSH_LOGINGRACE")"
      case "$lgt_s" in
        ''|*[!0-9]*) sec_line info "LoginGraceTime: $BH_SSH_LOGINGRACE (unrecognized value)" ;;
        0)           sec_line warn "LoginGraceTime: 0 (unlimited) — no deadline for authentication" ;;
        *)
          if [ "$lgt_s" -gt 120 ]; then
            sec_line warn "LoginGraceTime: ${lgt_s}s — long pre-auth window (default 120s)"
          else
            sec_line ok "LoginGraceTime: ${lgt_s}s"
          fi
          ;;
      esac
    fi
    case "$BH_SSH_X11" in
      yes) sec_line warn "X11Forwarding: yes — extra attack surface; disable unless X11 is really needed" ;;
      no)  sec_line ok   "X11Forwarding: no" ;;
      *)   sec_line ok   "X11Forwarding: ${BH_SSH_X11:-no (default)}" ;;
    esac
    if [ "$BH_SSH_KBDINT" = "yes" ]; then
      case "$BH_SSH_PWDAUTH" in
        yes) sec_line warn "KbdInteractiveAuthentication: yes + PasswordAuthentication: yes — keyboard-interactive + password auth both on" ;;
        *)   sec_line info "KbdInteractiveAuthentication: yes (PasswordAuthentication: ${BH_SSH_PWDAUTH:-not set})" ;;
      esac
    else
      sec_line info "KbdInteractiveAuthentication: ${BH_SSH_KBDINT:-yes (default)}"
    fi
    if [ -n "$BH_SSH_ALLOWUSERS" ]; then
      sec_line ok "SSH access restricted to: $BH_SSH_ALLOWUSERS (AllowUsers/AllowGroups)"
    else
      sec_line info "AllowUsers/AllowGroups: not set — every account may attempt SSH login"
    fi

    # ---- AuthorizedKeysFile (H3): effective paths feed the key inventory ----
    BH_SEC_AUTHKEYS_PATH="$(sec_sshd_opt authorizedkeysfile "")"
    [ -n "$BH_SEC_AUTHKEYS_PATH" ] || BH_SEC_AUTHKEYS_PATH=".ssh/authorized_keys"
    case "$BH_SEC_AUTHKEYS_PATH" in
      ".ssh/authorized_keys")
        sec_line info "AuthorizedKeysFile: .ssh/authorized_keys (default)" ;;
      *)
        sec_line info "AuthorizedKeysFile: $BH_SEC_AUTHKEYS_PATH (non-default — key inventory scans these paths too, %u/%h expanded)" ;;
    esac

    # ---- crypto hygiene (H1): weak Ciphers/MACs/KexAlgorithms ----
    local eff_cs eff_ms eff_kx
    eff_cs="$(sec_sshd_opt ciphers "")"
    eff_ms="$(sec_sshd_opt macs "")"
    eff_kx="$(sec_sshd_opt kexalgorithms "")"
    BH_SEC_WEAK_CRYPTO="$(sec_weak_tokens "$eff_cs,$eff_ms,$eff_kx")"
    BH_SEC_CIPHERS="$(sec_trunc "$eff_cs")"
    BH_SEC_KEX="$(sec_trunc "$eff_kx")"
    if [ -n "$BH_SEC_WEAK_CRYPTO" ]; then
      sec_line warn "Weak crypto algorithms enabled: $BH_SEC_WEAK_CRYPTO"
    elif [ -n "$eff_cs$eff_ms$eff_kx" ]; then
      sec_line ok "Weak crypto: none — Ciphers/MACs/KexAlgorithms contain no known-weak algorithms"
    else
      sec_line info "Weak crypto: none detected — Ciphers/MACs/KexAlgorithms not set (distro defaults apply)"
    fi
    [ -n "$BH_SEC_CIPHERS" ] && sec_line info "Effective Ciphers: $BH_SEC_CIPHERS"
    [ -n "$BH_SEC_KEX" ] && sec_line info "Effective KexAlgorithms: $BH_SEC_KEX"

    # ---- connection hygiene (H2) ----
    BH_SEC_MAXSTARTUPS="$(sec_sshd_opt maxstartups "")"
    [ -n "$BH_SEC_MAXSTARTUPS" ] || BH_SEC_MAXSTARTUPS="10:30:100 default"
    sec_line info "MaxStartups: $BH_SEC_MAXSTARTUPS (unauthenticated connection throttling)"
    local cai cacm
    cai="$(sec_sshd_opt clientaliveinterval "")"
    cacm="$(sec_sshd_opt clientalivecountmax "")"
    if [ -z "$cai" ] || [ "$cai" = "0" ]; then
      BH_SEC_ALIVE="disabled (default)"
    elif [ -n "$cacm" ]; then
      BH_SEC_ALIVE="ClientAliveInterval ${cai}s x ClientAliveCountMax ${cacm}"
    else
      BH_SEC_ALIVE="ClientAliveInterval ${cai}s x ClientAliveCountMax 3 (default)"
    fi
    sec_line info "Client keepalive: $BH_SEC_ALIVE (dead-session reaping)"

    # ---- pre-login banner leak (H8) ----
    sec_banner
    case "$BH_SEC_BANNER" in
      leaks*) sec_line warn "Pre-login banner: $BH_SEC_BANNER — reveals OS details to anyone probing the SSH port; set 'Banner none'" ;;
      custom) sec_line info "Pre-login banner: custom (no OS info detected)" ;;
      *)      sec_line info "Pre-login banner: none" ;;
    esac

    # ---- v5 deep checks (C10): syntax gate, declared-vs-effective diff, ----
    # ---- certificate auth, Match/SFTP scan, forwarding sweep, MFA      ----
    bhv5c10_sshd_cfg_valid
    bhv5c10_eff_decl
    bhv5c10_cert_auth
    bhv5c10_match_sftp
    bhv5c10_fwd_sweep
    bhv5c10_mfa
  else
    BH_SSH_PORTS=""
    sec_line info "sshd: not found on this machine (no SSH server installed)"
  fi

  # ---- OpenSSH version ('sshd -V' is not portable; 'ssh -V' prints to stderr) ----
  if command_exists ssh; then
    BH_SSH_VERSION="$(ssh -V 2>&1 | sed -n 's/^\(OpenSSH_[0-9.p]*\).*/\1/p' | head -n 1)"
  fi
  if [ -n "$BH_SSH_VERSION" ]; then
    sec_line info "OpenSSH version: $BH_SSH_VERSION"
  else
    sec_line info "OpenSSH version: n/a (ssh client not found)"
  fi
  # daemon and client versions can drift after partial upgrades — report the
  # daemon binary when it adds information beyond the client line above
  if [ -n "$BH_SSHD_VER" ] && [ "$BH_SSHD_VER" != "$BH_SSH_VERSION" ]; then
    if [ -n "$BH_SSH_VERSION" ]; then
      sec_line info "sshd daemon version: $BH_SSHD_VER (ssh client: $BH_SSH_VERSION — client/daemon differ)"
    else
      sec_line info "sshd daemon version: $BH_SSHD_VER (no ssh client for comparison)"
    fi
  fi

  # ---- sshd runtime state ----
  sec_sshd_runtime
  if [ "$BH_SSH_RUNNING" = "1" ]; then
    if [ -n "$BH_SSH_LISTENING" ]; then
      sec_line info "sshd process: running; listening on port(s): $BH_SSH_LISTENING"
    else
      sec_line info "sshd process: running; listening ports unknown (ss unavailable or no match)"
    fi
  elif [ "$BH_SSH_FOUND" = "1" ]; then
    sec_line warn "sshd process: NOT detected, but sshd config exists — SSH server may be down or disabled"
  else
    sec_line info "sshd process: not detected (no SSH server installed)"
  fi

  # ---- v5 (C3/C9): socket-activation false-positive guard + listener topology ----
  bhv5c10_socket_fp
  bhv5c10_topology

  # ---- authorized keys ----
  sec_auth_keys
  bhv5c10_ak_deep
  if [ "$BH_AK_TOTAL" -gt 0 ]; then
    local weaktxt=""
    [ "$BH_AK_WEAK" -gt 0 ] && weaktxt=" — $BH_AK_WEAK WEAK (<2048-bit)"
    sec_line ok "authorized_keys: $BH_AK_TOTAL key(s): ${BH_AK_TYPES:-unknown types}$weaktxt"
  else
    sec_line info "authorized_keys: none found (root + /home/*)"
  fi

  # ---- v5 (C5): host key audit (type/size/mtime; fingerprints truncated) ----
  bhv5c10_hostkey_audit

  # ---- failed logins ----
  sec_failed_logins
  if [ "$BH_SSH_FAILS_N" -ge 50 ] 2>/dev/null; then
    sec_line warn "Failed SSH logins: $BH_SSH_FAILS — looks like active brute-force; consider fail2ban + key-only auth"
  elif [ "$BH_SSH_FAILS_N" -ge 1 ] 2>/dev/null; then
    sec_line info "Failed SSH logins: $BH_SSH_FAILS"
  else
    sec_line info "Failed SSH logins: $BH_SSH_FAILS"
  fi
  bhv5c10_auth_log_deep

  # ---- firewall / fail2ban ----
  sec_firewall
  case "$BH_FW" in
    *INACTIVE*|"no firewall detected") sec_line warn "Firewall: $BH_FW — enable ufw/nftables and only open needed ports" ;;
    *) sec_line ok "Firewall: $BH_FW" ;;
  esac
  # ---- brute-force protection (fail2ban / sshguard / crowdsec) ----
  BH_F2B=0; BH_F2B_ACTIVE=0; BH_SSHGUARD=0; BH_CROWDSEC=0
  if command_exists fail2ban-client || [ -d /etc/fail2ban ]; then
    BH_F2B=1
    # "active" = systemd unit running OR the fail2ban-server process is alive
    if systemctl is-active fail2ban >/dev/null 2>&1 || pgrep -x fail2ban-server >/dev/null 2>&1; then
      BH_F2B_ACTIVE=1
      if command_exists fail2ban-client && fail2ban-client status sshd 2>/dev/null | grep -q "Jail"; then
        sec_line ok "fail2ban: active with sshd jail"
      else
        sec_line ok "fail2ban: active (sshd jail not confirmed — needs fail2ban-client read rights)"
      fi
    else
      sec_line warn "fail2ban: installed but NOT running — 'systemctl enable --now fail2ban'"
    fi
  fi
  if systemctl is-active sshguard >/dev/null 2>&1 || pgrep -x sshguard >/dev/null 2>&1 || [ -f /etc/sshguard.conf ]; then
    BH_SSHGUARD=1
    sec_line ok "sshguard: present (brute-force protection)"
  fi
  if systemctl is-active crowdsec >/dev/null 2>&1 || pgrep -x crowdsec >/dev/null 2>&1 || [ -d /etc/crowdsec ] || command_exists cscli; then
    BH_CROWDSEC=1
    sec_line ok "crowdsec: present (collaborative brute-force protection)"
  fi
  if [ "$BH_F2B" = "0" ] && [ "$BH_SSHGUARD" = "0" ] && [ "$BH_CROWDSEC" = "0" ]; then
    sec_line info "fail2ban: not installed (recommended when password auth is enabled)"
  fi

  # ---- local accounts / kernel / maintenance ----
  sec_misc
  if [ -n "$BH_UID0" ] && [ "$BH_UID0" != "root" ]; then
    sec_line bad "UID-0 accounts: $BH_UID0 — extra root-level accounts exist"
  else
    sec_line ok "UID-0 accounts: root only"
  fi
  case "$BH_EMPTY_PW" in
    n/a) sec_line info "Empty passwords: n/a (/etc/shadow not readable)" ;;
    0)   sec_line ok   "Empty passwords: none" ;;
    *)   sec_line bad  "Empty passwords: $BH_EMPTY_PW account(s) — CRITICAL" ;;
  esac
  sec_line info "Login-shell accounts: $BH_LOGIN_SHELLS"
  case "$BH_SUDO_NOPASS" in
    yes*) sec_line warn "sudo NOPASSWD: yes — passwordless root for some users" ;;
    no)   sec_line ok   "sudo NOPASSWD: no" ;;
    *)    sec_line info "sudo NOPASSWD: n/a (sudoers not readable)" ;;
  esac

  # ---- kernel / maintenance ----
  if [ "$BH_ASLR" = "2" ]; then
    sec_line ok "ASLR: full (randomize_va_space=2)"
  else
    sec_line info "ASLR: ${BH_ASLR:-n/a}"
  fi
  if [ "$BH_AUTO_UPD" = "not detected" ]; then
    sec_line info "Auto security updates: not detected"
  else
    sec_line ok "Auto security updates: $BH_AUTO_UPD"
  fi
  sec_line info "Listening TCP ports: ${BH_LISTEN:-n/a (ss unavailable)}"

  # ---- password/account hygiene (H4/H5) ----
  sec_pam_pw
  case "$BH_SEC_PAM_PW" in
    pwquality*|cracklib|passwdqc) sec_line ok "PAM password quality: $BH_SEC_PAM_PW" ;;
    none) sec_line info "PAM password quality: none — no pwquality/cracklib module in the PAM password stack" ;;
    *)    sec_line info "PAM password quality: unknown (PAM password config not readable)" ;;
  esac
  sec_aging
  if [ -n "$BH_SEC_PASS_MAX_DAYS" ]; then
    sec_line info "Password aging: PASS_MAX_DAYS=$BH_SEC_PASS_MAX_DAYS${BH_SEC_ROOT_EXPIRE:+ | root password expires: $BH_SEC_ROOT_EXPIRE}"
  else
    sec_line info "Password aging: n/a (/etc/login.defs not readable)"
  fi

  # ---- auditd / time sync (H6/H7) ----
  sec_auditd
  case "$BH_SEC_AUDITD" in
    running)               sec_line ok "auditd: running (kernel audit rules active)" ;;
    installed-not-running) sec_line warn "auditd: installed but NOT running — 'systemctl enable --now auditd'" ;;
    not-installed)         sec_line info "auditd: not installed (kernel audit framework)" ;;
    *)                     sec_line info "auditd: unknown" ;;
  esac
  sec_ntp
  case "$BH_SEC_NTP" in
    synced*)    sec_line ok "Time sync: $BH_SEC_NTP" ;;
    not-synced) sec_line warn "Time sync: not-synced — clock drift breaks TLS, logs and cron" ;;
    *)          sec_line info "Time sync: unknown (no systemd/chrony time source detected)" ;;
  esac

  # ---- hardening extras (lib/85-hardening.sh, optional module) ----
  # Guarded so this file still works when sourced standalone (tests do that).
  if command -v sec_hardening >/dev/null 2>&1; then
    sec_hardening
  fi

  # ---- v5 companion modules (86/87, another coder owns them) ----
  declare -F sec_system_sec >/dev/null 2>&1 && sec_system_sec
  declare -F sec_malware_hunt >/dev/null 2>&1 && sec_malware_hunt

  # ---- posture ----
  if [ "$BH_SEC_BAD" -gt 0 ]; then
    BH_SEC_POSTURE="WEAK"
  elif [ "$BH_SEC_WARN" -gt 2 ]; then
    BH_SEC_POSTURE="FAIR"
  else
    BH_SEC_POSTURE="GOOD"
  fi
  BH_SEC_LINES+=("  [POST]  Posture: $BH_SEC_POSTURE ($BH_SEC_PASS pass / $BH_SEC_WARN warn / $BH_SEC_BAD bad) — scope: this machine only")
}

# ============ lib/85-hardening.sh ============
# =====================================================================
# blackhole-vps-bench · 85-hardening.sh — system hardening audit
# Appended to the SSH & security section: sec_audit (80-ssh.sh) calls
# sec_hardening through a guarded `command -v` so this module stays
# optional and standalone-sourceable.
# Checks (v3): MAC layer (SELinux/AppArmor), pending package updates,
# risky wildcard listeners, cryptominer processes, docker.sock
# permissions, kernel security sysctls, /tmp mount hardening,
# cron/systemd timers.
# Checks (v4, X1-X8 — all passive, all degrade to n/a): world-writable
# entries in PATH dirs, SUID/SGID inventory + anomalies, core-dump
# settings, fs.protected_* race sysctls, legacy network-daemon packages,
# sudo/pkexec version age (INFO only), configured umask, forensics
# toolkit presence.
# Checks (v5 stage 2, C09): second-pass kernel sysctls (mmap_min_addr,
# sysrq bitmask, perf_event_paranoid, kexec_load_disabled,
# unprivileged_userns_clone), kernel lockdown mode, kernel taint decode,
# world-writable entries under /etc. All passive; absent sysctls/files
# (old kernels, hardened containers) are skipped silently.
# Offline contract: when BH_NO_NET=1 nothing here touches the network —
# apt reads are cache-only and stay, but dnf/yum check-update (which
# refreshes repo metadata over the network) is skipped entirely.
# No root required — every command is guarded and degrades gracefully
# (busybox/alpine safe: no GNU-only flags, stderr always discarded).
# POSIX-ish bash; no set -e; no sudo.
# =====================================================================
# shellcheck shell=bash

# ------- module globals (raw values; the report layer may read them) -------
BH_MAC=""            # SELinux state | "apparmor" | "none" | ""
BH_UPDATES="n/a"     # "N pending" | "n/a"
BH_UPDATES_N=-1      # pending update count (-1 = unknown)
BH_RISKY_PORTS=""    # e.g. "redis(6379),mysql(3306)" — wildcard binds only
BH_MINERS=0          # cryptominer process hits
BH_MINER_NAMES=""    # deduped, truncated to 120 chars
BH_DOCKER_SOCK=""    # "absent" | "mode NNN" | "unknown"
BH_SYSCTL_KPTR=""    # kernel.kptr_restrict raw value
BH_SYSCTL_DMESG=""   # kernel.dmesg_restrict raw value
BH_SYSCTL_BPF=""     # kernel.unprivileged_bpf_disabled raw ("" = file absent)
BH_SYSCTL_YAMA=""    # kernel.yama.ptrace_scope raw ("" = file absent)
BH_TMP_OPTS=""       # /tmp mount options (raw)
BH_TIMERS_N=""       # systemd timer count ("" = systemctl missing)
BH_CRON_N=""         # file count under /etc/cron*

# ---- v4 hardening globals (X1-X8; raw values, the report layer may read) ----
BH_SEC_PATH_WW="n/a"           # "0" | "N: /path1 /path2 …" — world-writable in PATH dirs
BH_SEC_SUID_COUNT="n/a"        # suid/sgid file count in the same PATH dirs
BH_SEC_SUID_ODD="n/a"          # basenames outside the whitelist (comma list) | "none"
BH_SEC_CORE="n/a"              # "dumpable=N ulimit=X pattern=Y" (+ WARN:… flags inside)
BH_SEC_PROTECTED_SYSCTL="n/a"  # "hardlinks:N regular:N fifos:N symlinks:N" (0 → "0!", missing → "?")
BH_SEC_LEGACY_PKGS="unknown"   # legacy daemons (comma list) | "none" | "unknown"
BH_SEC_SUDO_VER="unknown"      # first line of `sudo -V` (INFO-level only, never a WARN)
BH_SEC_PKEXEC_VER="unknown"    # first line of `pkexec --version` (INFO-level only, never a WARN)
BH_SEC_UMASK="n/a"             # "UMASK=NN (source)" (+ WARN:permissive) | "unset→distro default"
BH_SEC_FORENSICS="n/a"         # rkhunter/chkrootkit/clamscan/freshclam/aide found | "none"
BH_SEC_SCAN_DIRS=""            # internal: resolved bin dirs (≤3) shared by the X1/X2 scans

# ---- v5 hardening globals (stage 2, C09; raw values, report layer may read) ----
BH_SEC_MMAP_MIN="n/a"   # vm.mmap_min_addr raw ("n/a" = file absent/unreadable)
BH_SEC_SYSRQ="n/a"      # kernel.sysrq raw bitmask
BH_SEC_PERF_PAR="n/a"   # kernel.perf_event_paranoid raw (may be negative)
BH_SEC_KEXEC="n/a"      # kernel.kexec_load_disabled raw ("n/a" = file absent)
BH_SEC_USERNS="n/a"     # kernel.unprivileged_userns_clone raw ("n/a" = absent)
BH_SEC_LOCKDOWN="n/a"   # none | integrity | confidentiality | "n/a" (absent)
BH_SEC_TAINT="n/a"      # "0" | "N (W warning)" | "N (P proprietary…)" | "n/a"
BH_SEC_ETC_WW="n/a"     # "0" | "N: path1 path2 path3" — world-writable under /etc

# Standalone-sourceable: the real sec_line lives in 80-ssh.sh. When this
# module is sourced on its own (tests, one-off debugging) provide a quiet
# fallback so nothing ever errors; 80-ssh.sh overrides it when loaded.
if ! command -v sec_line >/dev/null 2>&1; then
  sec_line() { return 0; }
fi

# bh_run_to SECS CMD... — run a possibly-slow command under `timeout` when
# available; stderr and stdin are neutralized so audit output stays clean.
bh_run_to() {
  local secs="$1"; shift
  if command_exists timeout; then
    timeout "$secs" "$@" 2>/dev/null </dev/null
  else
    "$@" 2>/dev/null </dev/null
  fi
}

# 45s ceiling for package-manager update queries (they may refresh metadata;
# local caches answer in well under that).
bh_run45() { bh_run_to 45 "$@"; }

# ---- 1. MAC layer: SELinux first, then AppArmor, then "none" ----
sec_hardening_mac() {
  if command_exists getenforce; then
    BH_MAC="$(getenforce 2>/dev/null)"
    case "$BH_MAC" in
      Enforcing)  sec_line ok   "MAC: SELinux enforcing" ;;
      Permissive) sec_line warn "MAC: SELinux permissive — 'setenforce 1' would harden" ;;
      *)          BH_MAC="Disabled"
                  sec_line info "MAC: SELinux disabled" ;;
    esac
    return 0
  fi
  if grep -q '^Y' /sys/module/apparmor/parameters/enabled 2>/dev/null; then
    BH_MAC="apparmor"
    # aa-status usually wants root; on failure just report "enabled" plain.
    local profs
    profs="$(bh_run45 aa-status | awk '/profiles are loaded/{print $1; exit}')"
    case "$profs" in
      ''|*[!0-9]*) sec_line ok "MAC: AppArmor enabled" ;;
      *)           sec_line ok "MAC: AppArmor enabled ($profs profiles loaded)" ;;
    esac
    return 0
  fi
  BH_MAC="none"
  sec_line info "MAC: none (no SELinux/AppArmor)"
}

# ---- 2. pending package updates — first usable package manager wins ----
# BH_NO_NET contract: apt/apk/pacman reads below are cache-only (they make
# NO network calls) and always run; dnf/yum check-update REFRESHES repo
# metadata over the network and is skipped entirely when BH_NO_NET=1.
# BH_NO_SEC contract: the whole path also bails out early (the audit entry
# point gates it too). Every query stays timeout-wrapped.
sec_hardening_updates() {
  [ "${BH_NO_SEC:-0}" = "1" ] && return 0   # no update counts when sec is off
  local n=-1 mgr="" alist aout cout rc
  if command_exists apt; then
    mgr="apt"
    alist="$(bh_run45 apt list --upgradable)"
    if [ -n "$alist" ]; then
      # line 1 is the "Listing..." header; WARNING chatter filtered out
      n="$(printf '%s\n' "$alist" | tail -n +2 | grep -vc '^WARNING')"
    else
      # old/broken apt: simulate the upgrade set from the local cache
      n="$(bh_run45 apt-get -s dist-upgrade | grep -c '^Inst ')"
    fi
  elif command_exists dnf || command_exists yum; then
    # OFFLINE GATE — dnf/yum check-update contacts the repo mirrors to
    # refresh metadata even when local caches exist, so it must never run
    # with BH_NO_NET=1. Degrade to "unknown" instead.
    if [ "$BH_NO_NET" = "1" ]; then
      mgr="dnf/yum"
      BH_UPDATES_N=-1
      BH_UPDATES="n/a"
      sec_line info "pending updates: skipped (offline mode — dnf/yum check-update refreshes repo metadata over the network)"
      return 0
    fi
    mgr="dnf/yum"
    local pkg=dnf
    command_exists dnf || pkg=yum
    aout="$(bh_run45 "$pkg" check-update -q)"; rc=$?
    # rc 100 = updates available, 0 = none, anything else = check failed
    case "$rc" in
      0)   n=0 ;;
      100) n="$(printf '%s\n' "$aout" | grep -cE '.+-[0-9]')"
           [ "$n" -gt 0 ] 2>/dev/null || n=-1 ;;
      *)   n=-1 ;;
    esac
  elif command_exists apk; then
    mgr="apk"
    # busybox apk prints one "<" per upgradable package; empty = nothing pending
    n="$(bh_run45 apk version -l '<' | tail -n +2 | grep -c '<')"
  elif command_exists pacman; then
    mgr="pacman"
    if command_exists checkupdates; then
      cout="$(bh_run45 checkupdates)"; rc=$?
      case "$rc" in
        0) n="$(printf '%s\n' "$cout" | grep -c .)" ;;
        *) n=-1 ;;
      esac
    fi # checkupdates missing (pacman-contrib not installed) -> stays -1
  fi
  case "$n" in ''|*[!0-9]*) n=-1 ;; esac
  BH_UPDATES_N="$n"
  if [ "$n" -lt 0 ]; then
    BH_UPDATES="n/a"
    if [ -n "$mgr" ]; then
      sec_line info "pending updates: unknown ($mgr present, update check failed)"
    else
      sec_line info "pending updates: unknown (no package manager usable)"
    fi
  elif [ "$n" -eq 0 ]; then
    BH_UPDATES="0 pending"
    sec_line ok "all packages up to date (or repo metadata fresh)"
  elif [ "$n" -le 50 ]; then
    BH_UPDATES="$n pending"
    sec_line info "$n package updates pending"
  else
    BH_UPDATES="$n pending"
    sec_line warn "$n package updates pending — patch cycle looks stale"
  fi
}

# ---- 3. risky services bound on wildcard addresses ----
# bad: telnet/redis/memcached/mongodb (unauthenticated root-equivalent access)
# warn: ftp/smb/mssql/mysql/rdp/postgres/vnc/elasticsearch
sec_hardening_listeners() {
  if ! command_exists ss; then
    sec_line info "listening-service scan skipped (ss unavailable)"
    return 0
  fi
  local ssout rc found="" seen="|" entry addr port svc
  ssout="$(ss -tulnH 2>/dev/null)"; rc=$?
  if [ "$rc" != "0" ]; then
    ssout="$(ss -tuln 2>/dev/null)"; rc=$?   # old ss without -H; awk drops header
  fi
  if [ "$rc" != "0" ]; then
    sec_line info "listening-service scan skipped (ss unusable)"
    return 0
  fi
  while IFS= read -r entry; do
    [ -n "$entry" ] || continue
    addr="${entry%:*}"; port="${entry##*:}"
    case "$port" in ''|*[!0-9]*) continue ;; esac
    addr="${addr#\[}"; addr="${addr%\]}"   # [::] -> ::
    case "$addr" in
      0.0.0.0|::|\*|"") : ;;               # wildcard binds only
      *) continue ;;
    esac
    case "$seen" in *"|$port|"*) continue ;; esac
    seen="$seen$port|"
    case "$port" in
      21)    svc="ftp" ;;
      23)    svc="telnet" ;;
      445)   svc="smb" ;;
      1433)  svc="mssql" ;;
      3306)  svc="mysql" ;;
      3389)  svc="rdp" ;;
      5432)  svc="postgres" ;;
      5900)  svc="vnc" ;;
      6379)  svc="redis" ;;
      9200)  svc="elasticsearch" ;;
      11211) svc="memcached" ;;
      27017) svc="mongodb" ;;
      *)     continue ;;
    esac
    found="${found:+$found,}$svc($port)"
    case "$port" in
      23|6379|11211|27017)
        sec_line bad "port $port ($svc) exposed on all interfaces — bind to 127.0.0.1 or firewall it" ;;
      *)
        sec_line warn "port $port ($svc) exposed on all interfaces — bind to 127.0.0.1 or firewall it" ;;
    esac
  done < <(printf '%s\n' "$ssout" | awk '$1 ~ /^(tcp|udp|tcp6|udp6)$/ && NF>=5 {print $5}')
  if [ -n "$found" ]; then
    BH_RISKY_PORTS="$found"
    sec_line info "risky wildcard binds: $BH_RISKY_PORTS"
  else
    sec_line ok "no risky services on wildcard binds"
  fi
}

# ---- 4. known cryptominer processes ----
sec_hardening_miners() {
  if ! command_exists pgrep; then
    sec_line info "cryptominer scan skipped (pgrep unavailable)"
    return 0
  fi
  local pid ppid gp cl comm n=0 names=""
  # NOTE: intentionally NOT wrapped in timeout — `timeout 45 pgrep -f PATTERN`
  # would put PATTERN into the timeout process argv and pgrep would flag it.
  # Self-match guard (QA v3): skip our own PID, our direct forks (PPid == $$),
  # our parent/grandparent shells, and any cmdline that merely mentions this
  # tool or the test suite — otherwise a report saved as /tmp/xmrig-report.txt
  # would flag the tool itself as a miner.
  gp="$(awk '/^PPid/{print $2}' "/proc/$$/status" 2>/dev/null)"
  for pid in $(pgrep -f 'xmrig|kdevtmpfsi|kinsing|minergate|stratum\+tcp|cpuminer' 2>/dev/null); do
    [ "$pid" = "$$" ] && continue
    ppid="$(awk '/^PPid/{print $2}' "/proc/$pid/status" 2>/dev/null)"
    [ "$ppid" = "$$" ] && continue
    [ -n "$gp" ] && [ "$ppid" = "$gp" ] && continue
    cl="$(tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null)"
    # vanished race (process exited between pgrep and this read) or kernel
    # thread with empty cmdline — cannot verify, must NOT flag
    [ -n "$cl" ] || continue
    case "$cl" in
      *blackhole-vps-bench*|*run-tests.sh*) continue ;;
    esac
    comm="$(awk '{print $1}' "/proc/$pid/comm" 2>/dev/null)"
    [ -n "$comm" ] || comm="pid:$pid"
    n=$((n + 1))
    names="$names $comm"
  done
  if [ "$n" -eq 0 ]; then
    BH_MINERS=0
    BH_MINER_NAMES=""
    sec_line ok "no known cryptominer processes"
    return 0
  fi
  BH_MINERS="$n"
  names="$(printf '%s\n' "$names" | tr ' ' '\n' | sed '/^$/d' | sort -u | paste -sd ',' -)"
  BH_MINER_NAMES="${names:0:120}"
  sec_line bad "possible cryptominer: $BH_MINER_NAMES ($BH_MINERS process(es))"
}

# ---- 5. docker.sock permissions (world/group access = root-equivalent) ----
sec_hardening_docker() {
  if [ ! -S /var/run/docker.sock ]; then
    BH_DOCKER_SOCK="absent"
    return 0   # no docker here — no verdict line by design
  fi
  local perms
  perms="$(stat -c %a /var/run/docker.sock 2>/dev/null)"
  case "$perms" in
    ''|*[!0-9]*)
      BH_DOCKER_SOCK="unknown"
      sec_line info "docker.sock present but mode unknown (stat unavailable)"
      return 0 ;;
  esac
  BH_DOCKER_SOCK="mode $perms"
  local others group
  others="${perms: -1}"     # other-bits digit
  group="${perms: -2:1}"    # group-bits digit
  case "$others" in
    0) : ;;
    *) sec_line bad "docker.sock world-accessible (root-equivalent) — mode $perms"
       return 0 ;;
  esac
  case "$group" in
    2|3|6|7) sec_line warn "docker.sock group-writable — mode $perms (group members get root)" ;;
    *)       sec_line ok "docker.sock root:docker only — mode $perms" ;;
  esac
}

# ---- 6. kernel security sysctls ----
sec_hardening_sysctl() {
  BH_SYSCTL_KPTR="$(cat /proc/sys/kernel/kptr_restrict 2>/dev/null)"
  BH_SYSCTL_DMESG="$(cat /proc/sys/kernel/dmesg_restrict 2>/dev/null)"
  BH_SYSCTL_BPF="$(cat /proc/sys/kernel/unprivileged_bpf_disabled 2>/dev/null)"
  BH_SYSCTL_YAMA="$(cat /proc/sys/kernel/yama/ptrace_scope 2>/dev/null)"
  if [ ! -d /proc/sys/kernel ]; then
    sec_line info "kernel sysctls: n/a (/proc/sys not readable)"
    return 0
  fi
  case "$BH_SYSCTL_KPTR" in
    ''|*[!0-9]*) : ;;   # unreadable/absent — skip quietly
    0) sec_line warn "kptr_restrict=0 — kernel pointers exposed to unprivileged users" ;;
    *) sec_line ok "kptr_restrict=$BH_SYSCTL_KPTR — kernel pointers hidden" ;;
  esac
  case "$BH_SYSCTL_DMESG" in
    ''|*[!0-9]*) : ;;
    0) sec_line warn "dmesg_restrict=0 — dmesg open to unprivileged users" ;;
    *) sec_line ok "dmesg_restrict=$BH_SYSCTL_DMESG — dmesg restricted" ;;
  esac
  case "$BH_SYSCTL_BPF" in
    ''|*[!0-9]*) : ;;   # often missing on older kernels — skip
    0) sec_line warn "unprivileged BPF enabled (unprivileged_bpf_disabled=0)" ;;
    *) sec_line ok "unprivileged BPF disabled (unprivileged_bpf_disabled=$BH_SYSCTL_BPF)" ;;
  esac
  case "$BH_SYSCTL_YAMA" in
    ''|*[!0-9]*) : ;;   # Yama is optional — skip when absent
    0) sec_line info "ptrace_scope=0 — Yama not restricting ptrace" ;;
    *) sec_line ok "ptrace_scope=$BH_SYSCTL_YAMA — ptrace restricted (Yama)" ;;
  esac
}

# ---- 7. /tmp mount hardening (noexec + nosuid) ----
sec_hardening_tmp() {
  BH_TMP_OPTS="$(findmnt -no OPTIONS /tmp 2>/dev/null)"
  if [ -z "$BH_TMP_OPTS" ]; then
    # fallback for busybox/alpine (no findmnt): /proc/mounts field 4
    BH_TMP_OPTS="$(grep ' /tmp ' /proc/mounts 2>/dev/null | awk '{print $4; exit}')"
  fi
  local noexec=0 nosuid=0
  case ",${BH_TMP_OPTS:-}," in *,noexec,*) noexec=1 ;; esac
  case ",${BH_TMP_OPTS:-}," in *,nosuid,*) nosuid=1 ;; esac
  if [ -z "$BH_TMP_OPTS" ]; then
    sec_line info "/tmp: not a separate mount — options unknown"
  elif [ "$noexec" = "1" ] && [ "$nosuid" = "1" ]; then
    sec_line ok "/tmp hardened (noexec,nosuid)"
  elif [ "$noexec" = "1" ] || [ "$nosuid" = "1" ]; then
    sec_line info "/tmp: $BH_TMP_OPTS (partial — add the missing noexec/nosuid)"
  else
    sec_line info "/tmp: $BH_TMP_OPTS (consider noexec,nosuid)"
  fi
}

# ---- 8. cron entries and systemd timers (informational) ----
sec_hardening_cron() {
  local d seen="|" n=0
  for d in /etc/cron.d /etc/cron.hourly /etc/cron.daily /etc/cron.weekly /etc/cron.monthly; do
    [ -d "$d" ] || continue
    d="$(readlink -f "$d" 2>/dev/null || echo "$d")"   # dedupe aliased dirs
    case "$seen" in *"|$d|"*) continue ;; esac
    seen="$seen$d|"
    # find (not ls) — handles dotfiles and any filename; busybox-safe
    n=$(( n + $(find "$d" -mindepth 1 -maxdepth 1 2>/dev/null | wc -l | tr -d ' ') ))
  done
  BH_CRON_N="$n"
  if [ "$n" -gt 0 ] 2>/dev/null; then
    sec_line info "cron entries: $n file(s) in /etc/cron*"
  fi
  if command_exists systemctl; then
    BH_TIMERS_N="$(systemctl list-timers --no-legend 2>/dev/null | wc -l | tr -d ' ')"
    case "$BH_TIMERS_N" in ''|*[!0-9]*) BH_TIMERS_N="" ;; esac
    if [ -n "$BH_TIMERS_N" ] && [ "$BH_TIMERS_N" -gt 0 ] 2>/dev/null; then
      sec_line info "systemd timers: $BH_TIMERS_N active"
    fi
  fi
}

# ---- 9. PATH-dir world-writables (X1) ----
# Scans the first 3 DISTINCT standard bin dirs (maxdepth 1, one filesystem,
# 2s budget) for world-writable FILES and for world-writable DIRECTORIES
# missing the sticky bit — both are classic root-escalation bait.
bh_sec_bin_dirs() {  # sets BH_SEC_SCAN_DIRS: deduped, capped at 3 dirs
  BH_SEC_SCAN_DIRS=""
  local d r n=0 seen="|"
  for d in /usr/local/bin /usr/bin /bin /usr/sbin /sbin; do
    [ -d "$d" ] || continue
    r="$(readlink -f "$d" 2>/dev/null)"
    [ -n "$r" ] && [ -d "$r" ] || r="$d"
    case "$seen" in *"|$r|"*) continue ;; esac
    seen="$seen$r|"
    BH_SEC_SCAN_DIRS="$BH_SEC_SCAN_DIRS $r"
    n=$((n + 1))
    [ "$n" -ge 3 ] && break
  done
  BH_SEC_SCAN_DIRS="${BH_SEC_SCAN_DIRS# }"
  return 0
}

sec_hardening_path_ww() {
  BH_SEC_PATH_WW="n/a"
  if ! command_exists find; then
    sec_line info "PATH world-writable scan skipped (find unavailable)"
    return 0
  fi
  bh_sec_bin_dirs
  if [ -z "$BH_SEC_SCAN_DIRS" ]; then
    sec_line info "PATH world-writable scan skipped (no standard bin dirs)"
    return 0
  fi
  # standard system bin dirs, no spaces — word splitting is intended
  # shellcheck disable=SC2086
  local out rc n disp trunc=0
  # shellcheck disable=SC2086
  out="$(bh_run_to 2 find $BH_SEC_SCAN_DIRS -maxdepth 1 -xdev \
        \( -type f -perm -0002 -o -type d -perm -0002 \! -perm -1000 \) -print)"
  rc=$?
  n="$(printf '%s\n' "$out" | sed '/^$/d' | wc -l | tr -d ' ')"
  case "$n" in ''|*[!0-9]*) n=0 ;; esac
  if [ "$n" -eq 0 ]; then
    if [ -z "$out" ] && [ "$rc" -gt 1 ]; then
      sec_line info "PATH world-writable scan failed (find rc=$rc)"
      return 0                      # BH_SEC_PATH_WW stays "n/a"
    fi
    BH_SEC_PATH_WW="0"
    sec_line ok "PATH dirs: no world-writable files / unsticky dirs"
    return 0
  fi
  disp="$(printf '%s\n' "$out" | sed '/^$/d' | head -n 5 | tr '\n' ' ')"
  disp="${disp% }"
  [ ${#disp} -gt 140 ] && { disp="${disp:0:140}"; trunc=1; }
  [ "$n" -gt 5 ] && trunc=1
  [ "$trunc" = "1" ] && disp="$disp …"
  BH_SEC_PATH_WW="$n: $disp"
  sec_line warn "PATH world-writable entries: $BH_SEC_PATH_WW — root-escalation bait"
}

# ---- 10. SUID/SGID inventory (X2) ----
# Same dirs/budget as X1. BH_SEC_SUID_COUNT counts setuid/setgid files,
# BH_SEC_SUID_ODD lists basenames outside the known-good whitelist
# ("none" when every hit is a standard binary).
sec_hardening_suid() {
  BH_SEC_SUID_COUNT="n/a"
  BH_SEC_SUID_ODD="n/a"
  if ! command_exists find; then
    sec_line info "SUID/SGID scan skipped (find unavailable)"
    return 0
  fi
  bh_sec_bin_dirs
  if [ -z "$BH_SEC_SCAN_DIRS" ]; then
    sec_line info "SUID/SGID scan skipped (no standard bin dirs)"
    return 0
  fi
  local ok_names="|sudo|su|mount|umount|passwd|chfn|chsh|newgrp|gpasswd|chage|pkexec|mount.nfs|fusermount|fusermount3|ping|staprun|Xorg.wrap|crontab|at|bsd-write|ssh-agent|expiry|wall|"
  # shellcheck disable=SC2086
  local out rc n p b odd="" odd_n=0 seen="|"
  # shellcheck disable=SC2086
  out="$(bh_run_to 2 find $BH_SEC_SCAN_DIRS -maxdepth 1 -xdev -type f \( -perm -4000 -o -perm -2000 \) -print)"
  rc=$?
  n="$(printf '%s\n' "$out" | sed '/^$/d' | wc -l | tr -d ' ')"
  case "$n" in ''|*[!0-9]*) n=0 ;; esac
  if [ "$n" -eq 0 ] && [ -z "$out" ] && [ "$rc" -gt 1 ]; then
    sec_line info "SUID/SGID scan failed (find rc=$rc)"
    return 0                        # globals stay "n/a"
  fi
  BH_SEC_SUID_COUNT="$n"
  if [ "$n" -gt 0 ]; then
    while IFS= read -r p; do
      [ -n "$p" ] || continue
      b="${p##*/}"
      case "$ok_names" in *"|$b|"*) continue ;; esac
      case "$seen" in *"|$b|"*) continue ;; esac
      seen="$seen$b|"
      [ "$odd_n" -lt 8 ] && odd="${odd:+$odd,}$b"
      odd_n=$((odd_n + 1))
    done < <(printf '%s\n' "$out")
  fi
  if [ "$odd_n" -eq 0 ]; then
    BH_SEC_SUID_ODD="none"
    sec_line ok "SUID/SGID: $n file(s), all standard"
  else
    BH_SEC_SUID_ODD="$odd"
    [ "$odd_n" -gt 8 ] && BH_SEC_SUID_ODD="$odd,…"
    sec_line warn "SUID/SGID: $n file(s), non-standard: $BH_SEC_SUID_ODD — review each one"
  fi
}

# ---- 11. core dumps (X3) ----
# suid_dumpable != 0 or a piped core_pattern mean the kernel may hand out
# memory images; WARN flags go INSIDE the value string so the report layer
# can re-read BH_SEC_CORE without re-running anything.
sec_hardening_coredump() {
  local d u p flagged=0
  d="$(cat /proc/sys/fs/suid_dumpable 2>/dev/null)"
  u="$(ulimit -c 2>/dev/null)"      # $( ) runs it in a subshell — our limit is untouched
  p="$(cat /proc/sys/kernel/core_pattern 2>/dev/null)"
  if [ -z "$d" ] && [ -z "$u" ] && [ -z "$p" ]; then
    BH_SEC_CORE="n/a"
    sec_line info "core-dump settings: n/a (nothing readable)"
    return 0
  fi
  d="${d:-?}"; u="${u:-?}"; p="${p:-n/a}"
  p="${p:0:48}"
  BH_SEC_CORE="dumpable=$d ulimit=$u pattern=$p"
  case "$d" in ''|*[!0-9]*) : ;; 0) : ;; *)
    BH_SEC_CORE="$BH_SEC_CORE WARN:dumpable!=0"; flagged=1 ;; esac
  [ "${p#|}" != "$p" ] && { BH_SEC_CORE="$BH_SEC_CORE WARN:pattern-piped"; flagged=1; }
  if [ "$flagged" = "1" ]; then
    sec_line warn "core dumps: $BH_SEC_CORE — set fs.suid_dumpable=0 and a plain 'core' pattern"
  else
    sec_line ok "core dumps: $BH_SEC_CORE"
  fi
}

# ---- 12. fs.protected_* race sysctls (X4) ----
# "!" suffix marks protection OFF (value 0), "?" marks unreadable/absent;
# all four unreadable (unprivileged container) → whole value is "n/a".
sec_hardening_race_sysctls() {
  local h r f s bad=0
  h="$(cat /proc/sys/fs/protected_hardlinks 2>/dev/null)"
  r="$(cat /proc/sys/fs/protected_regular 2>/dev/null)"
  f="$(cat /proc/sys/fs/protected_fifos 2>/dev/null)"
  s="$(cat /proc/sys/fs/protected_symlinks 2>/dev/null)"
  if [ -z "$h$r$f$s" ]; then
    BH_SEC_PROTECTED_SYSCTL="n/a"
    sec_line info "fs.protected_* sysctls: n/a (unreadable — common in unprivileged containers)"
    return 0
  fi
  case "$h" in ''|*[!0-9]*) h="?" ;; esac
  case "$r" in ''|*[!0-9]*) r="?" ;; esac
  case "$f" in ''|*[!0-9]*) f="?" ;; esac
  case "$s" in ''|*[!0-9]*) s="?" ;; esac
  case "$h" in 0) h="0!"; bad=1 ;; esac
  case "$r" in 0) r="0!"; bad=1 ;; esac
  case "$f" in 0) f="0!"; bad=1 ;; esac
  case "$s" in 0) s="0!"; bad=1 ;; esac
  BH_SEC_PROTECTED_SYSCTL="hardlinks:$h regular:$r fifos:$f symlinks:$s"
  if [ "$bad" = "1" ]; then
    sec_line warn "fs.protected_*: $BH_SEC_PROTECTED_SYSCTL — '!' marks protection OFF (symlink/hardlink/TOCTOU races)"
  else
    sec_line ok "fs.protected_*: $BH_SEC_PROTECTED_SYSCTL"
  fi
}

# ---- 13. legacy network-daemon packages (X5) ----
# nis/rsh/telnet/talk/xinetd/tftp families — plaintext creds or dead
# protocols; present on a modern VPS only by accident.
sec_hardening_legacy_pkgs() {
  BH_SEC_LEGACY_PKGS="unknown"
  local list="" hits
  if command_exists dpkg-query; then
    list="$(bh_run_to 5 dpkg-query -W -f='${Package}\n')"
  elif command_exists rpm; then
    list="$(bh_run_to 5 rpm -qa --qf '%{NAME}\n')"
  else
    sec_line info "legacy daemons (nis/rsh/telnet/talk/xinetd/tftp): unknown (no dpkg/rpm)"
    return 0
  fi
  if [ -z "$list" ]; then
    sec_line info "legacy daemons: unknown (package list empty/unreadable)"
    return 0
  fi
  hits="$(printf '%s\n' "$list" | grep -E '^(nis|rsh-client|rsh-server|telnet|telnetd|talkd|xinetd|tftpd|tftp-server|yp-tools|rsh-redone-client)$' | sort -u | paste -sd ',' -)"
  if [ -z "$hits" ]; then
    BH_SEC_LEGACY_PKGS="none"
    sec_line ok "legacy network daemons (nis/rsh/telnet/talk/xinetd/tftp): none installed"
  else
    BH_SEC_LEGACY_PKGS="$hits"
    sec_line warn "legacy network daemons installed: $hits — remove unless truly needed"
  fi
}

# ---- 14. sudo/pkexec version age (X6 — INFO only, per R3: never a WARN) ----
# Unknown or unparseable output degrades to "unknown" in the globals; no
# verdict line is emitted then at all. Version age alone is not a finding.
sec_hardening_versions() {
  BH_SEC_SUDO_VER="unknown"
  BH_SEC_PKEXEC_VER="unknown"
  local v
  if command_exists sudo; then
    v="$(bh_run_to 5 sudo -V 2>/dev/null | head -n 1)"
    if [ -n "$v" ]; then
      BH_SEC_SUDO_VER="$v"
      sec_line info "sudo version: $BH_SEC_SUDO_VER (info only — CVE fixes are distro-backported, age is not a verdict)"
    fi
  fi
  if command_exists pkexec; then
    v="$(bh_run_to 5 pkexec --version 2>/dev/null | head -n 1)"
    if [ -n "$v" ]; then
      BH_SEC_PKEXEC_VER="$v"
      sec_line info "pkexec version: $BH_SEC_PKEXEC_VER (info only — PwnKit fixes are distro-backported)"
    fi
  fi
}

# ---- 15. configured umask (X7) ----
# First hit wins: /etc/login.defs UMASK, then umask lines in
# /etc/profile.d/*.sh, then /etc/profile. 000/002 are flagged permissive
# INSIDE the value string.
sec_hardening_umask() {
  BH_SEC_UMASK="unset→distro default"
  local v="" src="" line f n permissive=0
  line="$(grep -hE '^[[:space:]]*UMASK[[:space:]]' /etc/login.defs 2>/dev/null | head -n 1)"
  if [ -n "$line" ]; then
    v="$(printf '%s\n' "$line" | awk '{print $2}')"
    src="login.defs"
  else
    for f in /etc/profile.d/*.sh /etc/profile; do
      [ -f "$f" ] || continue
      line="$(grep -hE '^[[:space:]]*umask[[:space:]]+0?[0-7]{2,4}([[:space:]]|$)' "$f" 2>/dev/null | head -n 1)"
      if [ -n "$line" ]; then
        v="$(printf '%s\n' "$line" | awk '{print $2}')"
        src="$f"
        break
      fi
    done
  fi
  if [ -z "$src" ] || [ -z "$v" ]; then
    sec_line info "umask: not configured in login.defs/profile — distro default applies"
    return 0
  fi
  case "$v" in ''|*[!0-7]*)
    BH_SEC_UMASK="UMASK=$v ($src) unparseable"
    sec_line info "umask: $BH_SEC_UMASK"
    return 0 ;;
  esac
  n=$(( 8#$v ))
  case "$n" in 0|2) permissive=1 ;; esac
  if [ "$src" = "login.defs" ]; then
    BH_SEC_UMASK="UMASK=$v ($src)"
  else
    BH_SEC_UMASK="umask=$v ($src)"
  fi
  if [ "$permissive" = "1" ]; then
    BH_SEC_UMASK="$BH_SEC_UMASK WARN:permissive"
    sec_line warn "umask: $BH_SEC_UMASK — group/other-writable files by default; use 022 or stricter"
  else
    sec_line ok "umask: $BH_SEC_UMASK"
  fi
}

# ---- 16. forensics toolkit (X8) ----
# Pure command -v probes — no execution, instant. (Password aging was
# moved to 80-ssh; do NOT re-add PASS_MAX_DAYS here.)
sec_hardening_forensics() {
  local t found=""
  for t in rkhunter chkrootkit clamscan freshclam aide; do
    command_exists "$t" && found="${found:+$found,}$t"
  done
  if [ -z "$found" ]; then
    BH_SEC_FORENSICS="none"
    sec_line info "forensics toolkit: none installed (rkhunter/chkrootkit/clamav/aide — optional)"
  else
    BH_SEC_FORENSICS="$found"
    sec_line ok "forensics toolkit present: $found"
  fi
}

# =====================================================================
# v5 stage 2 (C09) — second-pass kernel hardening + /etc write audit.
# Strictly read-only; every backing file/sysctl is probed for existence
# first and missing pieces are skipped silently (old kernels, unprivi-
# leged containers, hardened /sys). Deliberately does NOT re-touch the
# v3 sysctls above (kptr/dmesg/bpf/yama live in sec_hardening_sysctl).
# =====================================================================

# bhv5c9_in_container — best-effort container probe (docker/lxc/podman/k8s)
bhv5c9_in_container() {
  [ -f /.dockerenv ] && return 0
  [ -f /run/.containerenv ] && return 0
  grep -qaE 'docker|lxc|containerd|kubepods|libpod|podman' /proc/1/cgroup 2>/dev/null && return 0
  return 1
}

bhv5c9_stage2_sysctl() {
  local v
  # vm.mmap_min_addr — 0 lets unprivileged users map page 0 (NULL-deref bait)
  v="$(cat /proc/sys/vm/mmap_min_addr 2>/dev/null)"
  case "$v" in ''|*[!0-9]*) : ;; *)
    v=$(( 10#$v ))
    BH_SEC_MMAP_MIN="$v"
    if [ "$v" -eq 0 ]; then
      sec_line bad "mmap_min_addr=0 — page-0 mmap allowed for unprivileged users (NULL-deref exploit bait)"
    else
      sec_line ok "mmap_min_addr=$v — low virtual-memory mappings blocked"
    fi
  ;; esac
  # kernel.sysrq — decode the magic-SysRq bitmask (bit 64 sync, 128 reboot)
  v="$(cat /proc/sys/kernel/sysrq 2>/dev/null)"
  case "$v" in ''|*[!0-9]*) : ;; *)
    v=$(( 10#$v ))
    BH_SEC_SYSRQ="$v"
    if [ "$v" -eq 0 ]; then
      sec_line ok "sysrq disabled (kernel.sysrq=0)"
    elif [ $(( v & 128 )) -ne 0 ] || [ $(( v & 64 )) -ne 0 ]; then
      sec_line warn "kernel.sysrq=$v — reboot/poweroff via sysrq enabled (bits 64/128 set); set kernel.sysrq=0"
    else
      sec_line info "kernel.sysrq=$v (limited bitmask — no reboot/poweroff bit)"
    fi
  ;; esac
  # kernel.perf_event_paranoid — <=1 hands profiling counters to non-root;
  # only a WARN on boxes that actually have interactive (multi-)users
  v="$(cat /proc/sys/kernel/perf_event_paranoid 2>/dev/null)"
  case "$v" in ''|*[!0-9-]*) : ;; *)
    case "$v" in -*) case "${v#-}" in ''|*[!0-9]*) : ;; *)
      BH_SEC_PERF_PAR="$v"
      bhv5c9_perf_verdict "$v"
    ;; esac ;; *)
      BH_SEC_PERF_PAR="$v"
      bhv5c9_perf_verdict "$v"
    ;; esac
  ;; esac
  # kernel.kexec_load_disabled — 0 means runtime kernel replacement is open
  v="$(cat /proc/sys/kernel/kexec_load_disabled 2>/dev/null)"
  case "$v" in ''|*[!0-9]*) : ;; *)
    v=$(( 10#$v ))
    BH_SEC_KEXEC="$v"
    if [ "$v" -eq 0 ]; then
      sec_line info "kexec_load_disabled=0 — runtime kernel replacement permitted (set 1 to harden)"
    else
      sec_line ok "kexec_load_disabled=1 — runtime kexec loads blocked"
    fi
  ;; esac
  # kernel.unprivileged_userns_clone (Debian/Ubuntu patch; absent elsewhere)
  v="$(cat /proc/sys/kernel/unprivileged_userns_clone 2>/dev/null)"
  case "$v" in ''|*[!0-9]*) : ;; *)
    v=$(( 10#$v ))
    BH_SEC_USERNS="$v"
    if [ "$v" -eq 0 ]; then
      sec_line ok "unprivileged_userns_clone=0 — unprivileged user namespaces blocked"
    elif bhv5c9_in_container; then
      sec_line info "unprivileged_userns_clone=1 (container) — userns sandboxing open to all users"
    else
      sec_line info "unprivileged_userns_clone=1 — userns sandboxing open to all users"
    fi
  ;; esac
}

# bhv5c9_perf_verdict N — verdict for a validated (possibly negative)
# perf_event_paranoid value. Split out so the caller stays flat.
bhv5c9_perf_verdict() {
  local users
  if [ "$1" -ge 2 ]; then
    sec_line ok "perf_event_paranoid=$1 — kernel profiling restricted to root"
    return 0
  fi
  users="$(awk -F: '$3+0>=1000 && $7 !~ /(false|nologin|sync|halt|shutdown)$/ {n++} END {print n+0}' /etc/passwd 2>/dev/null)"
  case "$users" in ''|*[!0-9]*) users=0 ;; esac
  if [ "$users" -gt 0 ]; then
    sec_line warn "perf_event_paranoid=$1 with $users interactive account(s) — perf counters open to non-root (info leak); set kernel.perf_event_paranoid=2"
  else
    sec_line info "perf_event_paranoid=$1 (single-user box — acceptable)"
  fi
}

# lockdown — /sys/kernel/security/lockdown reads e.g. "none [integrity]
# confidentiality"; the bracketed token is the ACTIVE mode.
bhv5c9_stage2_lockdown() {
  [ -r /sys/kernel/security/lockdown ] || return 0
  local mode
  mode="$(awk '{ for (i = 1; i <= NF; i++) if ($i ~ /^\[.*\]$/) { gsub(/[][]/, "", $i); print $i; exit } }' /sys/kernel/security/lockdown 2>/dev/null)"
  [ -n "$mode" ] || return 0
  BH_SEC_LOCKDOWN="$mode"
  case "$mode" in
    integrity|confidentiality) sec_line ok "kernel lockdown: $mode (write-protected kernel interfaces)" ;;
    *) sec_line info "kernel lockdown: $mode (inactive — boot with 'lockdown=integrity' to harden)" ;;
  esac
}

# taint — /proc/sys/kernel/tainted bitfield. Only hardware/kernel-fault
# bits (4 M, 5 B, 7 D, 9 W, 14 L) WARN; proprietary-module bits (0 P,
# 12 O, 13 E) are INFO-only because they are VPS-common and benign.
bhv5c9_stage2_taint() {
  local t wtxt="" itxt="" bit
  t="$(cat /proc/sys/kernel/tainted 2>/dev/null)"
  case "$t" in ''|*[!0-9]*) return 0 ;; esac
  t=$(( 10#$t ))
  if [ "$t" -eq 0 ]; then
    BH_SEC_TAINT="0"
    sec_line ok "kernel untainted (taint=0)"
    return 0
  fi
  bit=4;  [ $(( t & (1 << bit) )) -ne 0 ] && wtxt="M machine-check"
  bit=5;  [ $(( t & (1 << bit) )) -ne 0 ] && wtxt="${wtxt:+$wtxt, }B bad-page"
  bit=7;  [ $(( t & (1 << bit) )) -ne 0 ] && wtxt="${wtxt:+$wtxt, }D oops"
  bit=9;  [ $(( t & (1 << bit) )) -ne 0 ] && wtxt="${wtxt:+$wtxt, }W warning"
  bit=14; [ $(( t & (1 << bit) )) -ne 0 ] && wtxt="${wtxt:+$wtxt, }L lockup"
  bit=0;  [ $(( t & (1 << bit) )) -ne 0 ] && itxt="P proprietary"
  bit=12; [ $(( t & (1 << bit) )) -ne 0 ] && itxt="${itxt:+$itxt, }O out-of-tree"
  bit=13; [ $(( t & (1 << bit) )) -ne 0 ] && itxt="${itxt:+$itxt, }E unsigned"
  if [ -n "$wtxt" ]; then
    BH_SEC_TAINT="$t ($wtxt)"
    sec_line warn "kernel tainted: taint=$t ($wtxt) — check dmesg for the source"
  elif [ -n "$itxt" ]; then
    BH_SEC_TAINT="$t ($itxt)"
    sec_line info "kernel tainted: taint=$t ($itxt) — proprietary/out-of-tree modules (VPS-common)"
  else
    BH_SEC_TAINT="$t (unclassified)"
    sec_line info "kernel tainted: taint=$t (bits outside M/B/D/W/L/P/O/E)"
  fi
}

# /etc world-writables — files with o+w and dirs with o+w and no sticky
# bit (same predicate as sec_hardening_path_ww, but rooted at /etc).
bhv5c9_stage2_etcww() {
  BH_SEC_ETC_WW="n/a"
  if ! command_exists find; then
    sec_line info "/etc world-writable scan skipped (find unavailable)"
    return 0
  fi
  local out rc n disp trunc=0
  out="$(bh_run_to 3 find /etc -xdev \( -type f -perm -0002 -o -type d -perm -0002 \! -perm -1000 \) -print)"
  rc=$?
  n="$(printf '%s\n' "$out" | sed '/^$/d' | wc -l | tr -d ' ')"
  case "$n" in ''|*[!0-9]*) n=0 ;; esac
  if [ "$n" -eq 0 ]; then
    if [ -z "$out" ] && [ "$rc" -gt 1 ]; then
      sec_line info "/etc world-writable scan failed (find rc=$rc)"
      return 0                      # BH_SEC_ETC_WW stays "n/a"
    fi
    BH_SEC_ETC_WW="0"
    sec_line ok "/etc: no world-writable files / unsticky dirs"
    return 0
  fi
  disp="$(printf '%s\n' "$out" | sed '/^$/d' | head -n 3 | tr '\n' ' ')"
  disp="${disp% }"
  [ ${#disp} -gt 140 ] && { disp="${disp:0:140}"; trunc=1; }
  [ "$n" -gt 3 ] && trunc=1
  [ "$trunc" = "1" ] && disp="$disp …"
  BH_SEC_ETC_WW="$n: $disp"
  sec_line warn "/etc world-writable entries: $BH_SEC_ETC_WW — root-escalation bait"
}

# bhv5c9_stage2 — v5 stage-2 orchestrator (called at the end of sec_hardening)
bhv5c9_stage2() {
  bhv5c9_stage2_sysctl
  bhv5c9_stage2_lockdown
  bhv5c9_stage2_taint
  bhv5c9_stage2_etcww
  return 0
}

# sec_hardening — entry point called (guarded) at the end of sec_audit.
# Every verdict goes through sec_line; posture counting is automatic.
sec_hardening() {
  [ "${BH_NO_SEC:-0}" = "1" ] && return 0   # belt & braces (run_sec_audit gates too)
  sec_hardening_mac
  sec_hardening_updates
  sec_hardening_listeners
  sec_hardening_miners
  sec_hardening_docker
  sec_hardening_sysctl
  sec_hardening_tmp
  sec_hardening_cron
  # v4 additions (X1-X8) — passive, every one degrades to n/a
  sec_hardening_path_ww
  sec_hardening_suid
  sec_hardening_coredump
  sec_hardening_race_sysctls
  sec_hardening_legacy_pkgs
  sec_hardening_versions
  sec_hardening_umask
  sec_hardening_forensics
  # v5 stage 2 (C09) — lockdown/taint + 2nd-pass sysctls + /etc write audit
  bhv5c9_stage2
  return 0
}

# ============ lib/86-system-sec.sh ============
# =====================================================================
# blackhole-vps-bench · 86-system-sec.sh — system security posture (v5, C09)
# Called (via a guarded `declare -F sec_system_sec`) from run_sec_audit
# (80-ssh.sh) alongside sec_hardening; standalone-sourceable like
# 85-hardening.sh (its sec_line fallback guard is replicated here).
# Checks (all passive, all read-only, all degrade to n/a):
#   1. PAM 2FA + login lockout (pam_google_authenticator/u2f/oath/duo,
#      pam_faillock/pam_tally2) — WARN only when PasswordAuthentication
#      is "yes" (BH_SSH_PWDAUTH, set by 80-ssh.sh) and no lockout exists.
#   2. EDR/monitoring census — INFO only, never a verdict: osquery, wazuh,
#      falco, suricata, ossec, elastic-agent, zabbix, crowdsec (from v4's
#      BH_CROWDSEC), plus the auditd rule count when auditd is running.
#   3. cron content triage — pipe-to-shell / base64-decode / /dev/tcp
#      one-liners in the readable cron trees (the \b guard keeps
#      "flush"/"shadow" style words from false-matching).
#   4. reboot-required — /var/run/reboot-required flag (+ package names),
#      running-vs-newest-installed kernel (exact sort -V compare of kernel
#      RELEASES, not package versions), needs-restarting -r on RHEL.
#   5. journald persistence — volatile logs with no syslog fallback mean a
#      forensic evidence gap after the next reboot.
#   6. auto-update timer truth — a configured-but-inactive timer means
#      patching is NOT actually happening (reuses v4's BH_AUTO_UPD).
# Offline contract: nothing here touches the network, ever. No root
# required — unreadable paths degrade gracefully and say so.
# Every external command is timeout-wrapped: bhv5c9_to reuses bh_run_to
# from 85-hardening.sh when present (plain timeout fallback otherwise).
# Verdicts go through sec_line EXACTLY like 85-hardening.sh, so the
# BH_SEC_WARN / BH_SEC_BAD counters (and the --fail-on exit gate) stay
# consistent. mawk-safe (no gawk-isms); POSIX-ish bash; no set -e; no
# sudo; English only, no emoji. BH_REDACT=1: cron paths under /var/spool
# (which carry the owning username) are never printed.
# =====================================================================
# shellcheck shell=bash

# ------- module globals (raw values; the report layer may read them) -------
BH_SYSSEC_PAM_2FA="n/a"        # wired | none | unknown
BH_SYSSEC_PAM_LOCKOUT="n/a"    # pam_faillock | pam_tally2 | none | unknown
BH_SYSSEC_EDR="n/a"            # census string (crowdsec, falco, auditd N rules, …)
BH_SYSSEC_AUDIT_RULES="n/a"    # auditd rule count ("n/a" = not counted)
BH_SYSSEC_CRON_SUSPECT=0       # cron files matching the pipe-to-shell patterns
BH_SYSSEC_REBOOT="unknown"     # "required (…)" | "kernel-pending" | "none" | "unknown"
BH_SYSSEC_JOURNAL="n/a"        # persistent | volatile | syslog | n/a
BH_SYSSEC_TIMER="n/a"          # "active: <timer>" | "inactive" | "none" | "n/a"

# Standalone-sourceable: the real sec_line lives in 80-ssh.sh. When this
# module is sourced on its own (tests, one-off debugging) provide a quiet
# fallback so nothing ever errors; 80-ssh.sh overrides it when loaded.
if ! command -v sec_line >/dev/null 2>&1; then
  sec_line() { return 0; }
fi
# Posture counters live in 80-ssh.sh; fill them ONLY when missing so a
# standalone source still reports sane numbers (never clobbers 80's values).
: "${BH_SEC_PASS:=0}"; : "${BH_SEC_WARN:=0}"; : "${BH_SEC_BAD:=0}"

# bhv5c9_to SECS CMD... — bh_run_to (85-hardening.sh) when available, else a
# plain `timeout` wrapper. Guarantees no external call here can hang.
bhv5c9_to() {
  local secs="$1"; shift
  if command -v bh_run_to >/dev/null 2>&1; then
    bh_run_to "$@"
    return $?
  fi
  if command_exists timeout; then
    timeout "$secs" "$@" 2>/dev/null </dev/null
  else
    "$@" 2>/dev/null </dev/null
  fi
}

# bhv5c9_redact_on — true when BH_REDACT=1 (reuses 12-cloud's bh_redact_on
# when loaded; same env contract, so behaviour is identical either way).
bhv5c9_redact_on() {
  if command -v bh_redact_on >/dev/null 2>&1; then
    bh_redact_on
    return $?
  fi
  [ "${BH_REDACT:-0}" = "1" ]
}

# bhv5c9_disp_path PATH — display form for cron-file paths. /var/spool/cron
# entries are NAMED AFTER their owning user, so with BH_REDACT=1 the username
# must never be printed: spool paths collapse to the fixed prefix; /etc/cron*
# names (system job names, not users) shrink to the basename.
bhv5c9_disp_path() {
  local p="$1"
  case "$p" in
    /var/spool/*)
      if bhv5c9_redact_on; then printf '%s' "/var/spool/cron/*"; else printf '%s' "$p"; fi
      return 0 ;;
  esac
  if bhv5c9_redact_on; then printf '%s' "${p##*/}"; else printf '%s' "$p"; fi
}

# ---- 1. PAM 2FA + login lockout -------------------------------------------
bhv5c9_pam_2fa() {
  local lockout=""
  # grep -s: silently skip the files that do not exist (distro layouts differ)
  if grep -qsE 'pam_google_authenticator|pam_u2f|pam_oath|pam_duo' \
       /etc/pam.d/sshd /etc/pam.d/common-auth /etc/pam.d/system-auth 2>/dev/null; then
    BH_SYSSEC_PAM_2FA="wired"
    sec_line ok "2FA module wired in PAM (google-authenticator/u2f/oath/duo)"
  else
    BH_SYSSEC_PAM_2FA="none"
    sec_line info "PAM 2FA: no TOTP/U2F/oath/duo module in sshd/common-auth/system-auth (second factor absent)"
  fi
  if grep -qsE 'pam_faillock' /etc/pam.d/sshd /etc/pam.d/common-auth /etc/pam.d/system-auth 2>/dev/null; then
    lockout="pam_faillock"
  elif grep -qsE 'pam_tally2' /etc/pam.d/sshd /etc/pam.d/common-auth /etc/pam.d/system-auth 2>/dev/null; then
    lockout="pam_tally2"
  fi
  case "$lockout" in
    pam_faillock|pam_tally2)
      BH_SYSSEC_PAM_LOCKOUT="$lockout"
      sec_line ok "login lockout: $lockout active in PAM (brute-force lockout)" ;;
    *)
      BH_SYSSEC_PAM_LOCKOUT="none"
      # WARN only when passwords can actually reach PAM (BH_SSH_PWDAUTH=yes,
      # set by 80-ssh.sh); unset/unknown degrades to a plain info line.
      case "${BH_SSH_PWDAUTH:-}" in
        yes) sec_line warn "no PAM lockout (pam_faillock/pam_tally2) while PasswordAuthentication: yes — enable faillock" ;;
        *)   sec_line info "login lockout: none in PAM (password auth off or unknown — low exposure)" ;;
      esac ;;
  esac
}

# ---- 2. EDR / monitoring census (INFO only — never a verdict) -------------
bhv5c9_edr_census() {
  local found="" a f cnt n=0 audit_running=0
  case "${BH_CROWDSEC:-x}" in
    1) found="crowdsec (from v4)" ;;
    # BH_CROWDSEC unset (standalone source): self-detect, quietly
    x) if [ -d /etc/crowdsec ] || command_exists cscli; then found="crowdsec"; fi ;;
  esac
  for a in osqueryd wazuh-agent falco suricata ossec-analysisd elastic-agent zabbix-agent2; do
    command_exists "$a" && { found="${found:+$found, }$a"; continue; }
    command_exists pgrep && pgrep -x "$a" >/dev/null 2>&1 && found="${found:+$found, }$a"
  done
  # auditd rule count — only meaningful when the daemon is actually running
  case "${BH_SEC_AUDITD:-}" in
    running) audit_running=1 ;;
    "")      command_exists pgrep && pgrep -x auditd >/dev/null 2>&1 && audit_running=1 ;;
  esac
  if [ "$audit_running" = "1" ]; then
    for f in /etc/audit/rules.d/*.rules /etc/audit/audit.rules; do
      [ -f "$f" ] && [ -r "$f" ] || continue
      cnt="$(grep -cvE '^[[:space:]]*(#|$)' "$f" 2>/dev/null)"
      case "$cnt" in ''|*[!0-9]*) cnt=0 ;; esac
      n=$(( n + cnt ))
    done
    BH_SYSSEC_AUDIT_RULES="$n"
    found="${found:+$found, }auditd $n rules"
  fi
  if [ -n "$found" ]; then
    BH_SYSSEC_EDR="$found"
    sec_line info "edr/monitor census: $found (INFO only — no verdict)"
  else
    BH_SYSSEC_EDR="none"
    sec_line info "edr/monitor census: none detected (osquery/wazuh/falco/suricata/ossec/elastic-agent/zabbix — INFO only)"
  fi
}

# ---- 3. cron content triage ------------------------------------------------
# Looks for the classic persistence one-liners: curl|wget piped straight into
# a shell, base64 -d stagers, /dev/tcp reverse shells. The (ba)?sh\b guard
# keeps words like "flush" or "shadow" from matching. Readable files only —
# root-only spool crontabs can hide more (noted on the line).
bhv5c9_cron_triage() {
  BH_SYSSEC_CRON_SUSPECT=0
  local d any=0 f hits n=0 d1="" d2="" cnt=0 list=""
  for d in /etc/cron.d /etc/cron.daily /etc/cron.hourly /etc/cron.weekly /etc/cron.monthly /var/spool/cron; do
    [ -e "$d" ] && { any=1; break; }
  done
  if [ "$any" = "0" ]; then
    sec_line info "cron triage skipped (no cron dirs present)"
    return 0
  fi
  hits="$(bhv5c9_to 3 grep -RIlE '(curl|wget)[^|]*\|[[:space:]]*(ba)?sh\b|base64[[:space:]]+(-d|--decode)|/dev/tcp/' \
        /etc/cron.d /etc/cron.daily /etc/cron.hourly /etc/cron.weekly /etc/cron.monthly /var/spool/cron)"
  n="$(printf '%s\n' "$hits" | sed '/^$/d' | wc -l | tr -d ' ')"
  case "$n" in ''|*[!0-9]*) n=0 ;; esac
  BH_SYSSEC_CRON_SUSPECT="$n"
  if [ "$n" -eq 0 ]; then
    sec_line ok "cron content: no pipe-to-shell / base64-decode / /dev/tcp patterns (readable files only)"
    return 0
  fi
  # up to 2 filenames, redact-safe (spool paths embed the owning username)
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    cnt=$((cnt + 1))
    if [ -z "$d1" ]; then d1="$(bhv5c9_disp_path "$f")"
    elif [ -z "$d2" ]; then d2="$(bhv5c9_disp_path "$f")"
    fi
    [ "$cnt" -ge 2 ] && break
  done <<< "$hits"
  list="$d1"
  [ -n "$d2" ] && list="$list $d2"
  sec_line warn "cron pipes to shell: $n file(s) — $list (readable files only; root-only spool entries may hide more)"
}

# ---- 4. reboot required -----------------------------------------------------
# Precedence: flag file > running-vs-installed kernel > needs-restarting.
# The kernel compare uses the RELEASE embedded in the package NAME (and an
# exact sort -V compare) — comparing package Versions would fire whenever a
# metapackage (linux-image-generic) had a newer packaging version than the
# running kernel, i.e. a false "reboot pending" on every apt run.
bhv5c9_reboot() {
  BH_SYSSEC_REBOOT="unknown"
  local pkgs="" line cnt=0 run="" newest="" rel="" ver="" rc=0
  if [ -f /var/run/reboot-required ]; then
    if [ -r /var/run/reboot-required.pkgs ]; then
      while IFS= read -r line && [ "$cnt" -lt 3 ]; do
        [ -n "$line" ] || continue
        pkgs="${pkgs:+$pkgs, }$line"
        cnt=$((cnt + 1))
      done < /var/run/reboot-required.pkgs
    fi
    BH_SYSSEC_REBOOT="required${pkgs:+ (packages: $pkgs)}"
    sec_line warn "reboot required (flag file /var/run/reboot-required present)${pkgs:+ — packages: $pkgs}"
    return 0
  fi
  run="$(bhv5c9_to 2 uname -r)"
  # sort -V feature test (busybox sort may lack it); without it we cannot
  # order versions confidently, so the compare is skipped entirely.
  if printf 'a\nb\n' | sort -V >/dev/null 2>&1; then
    if command_exists dpkg-query; then
      newest="$(bhv5c9_to 5 dpkg-query -W -f='${db:Status-Abbrev}${Package} ${Version}\n' 'linux-image*' \
                | grep '^ii' \
                | sed -e 's/^ii[[:space:]]*//' -e 's/^linux-image-unsigned-//' -e 's/^linux-image-//' \
                | awk '$1 ~ /^[0-9]/ { print }' | sort -V | tail -n 1)"
      rel="${newest%% *}"; ver="${newest#* }"
      [ "$ver" = "$rel" ] && ver=""       # single-field line → no version part
      case "$rel" in
        ''|*[!0-9A-Za-z._-]*) rel="" ;;   # defensive: junk line → skip
      esac
      case "$rel" in [0-9]*) : ;; *) rel="" ;; esac
      if [ -n "$rel" ] && [ -n "$run" ]; then
        if [ "$run" = "$rel" ]; then
          BH_SYSSEC_REBOOT="none"
          sec_line ok "running kernel $run is the newest installed (dpkg)"
          return 0
        fi
        if [ "$(printf '%s\n%s\n' "$run" "$rel" | sort -V | tail -n 1)" = "$rel" ]; then
          BH_SYSSEC_REBOOT="kernel-pending"
          sec_line warn "running kernel $run older than installed $rel${ver:+ (pkg $ver)} — reboot pending"
          return 0
        fi
        BH_SYSSEC_REBOOT="none"
        sec_line ok "running kernel $run is the newest installed (dpkg)"
        return 0
      fi
    elif command_exists rpm; then
      newest="$(bhv5c9_to 5 rpm -q kernel 2>/dev/null | sed 's/^kernel-//' | sort -V | tail -n 1)"
      case "$newest" in
        ''|*[!0-9A-Za-z._-]*) newest="" ;;
      esac
      if [ -n "$newest" ] && [ -n "$run" ]; then
        if [ "$run" = "$newest" ]; then
          BH_SYSSEC_REBOOT="none"
          sec_line ok "running kernel $run is the newest installed (rpm)"
          return 0
        fi
        if [ "$(printf '%s\n%s\n' "$run" "$newest" | sort -V | tail -n 1)" = "$newest" ]; then
          BH_SYSSEC_REBOOT="kernel-pending"
          sec_line warn "running kernel $run older than installed $newest — reboot pending"
          return 0
        fi
        BH_SYSSEC_REBOOT="none"
        sec_line ok "running kernel $run is the newest installed (rpm)"
        return 0
      fi
    fi
  fi
  # RHEL belt: needs-restarting -r exits 1 when a core update needs a reboot
  if command_exists needs-restarting; then
    bhv5c9_to 10 needs-restarting -r >/dev/null 2>&1
    rc=$?
    if [ "$rc" -eq 1 ]; then
      BH_SYSSEC_REBOOT="required (needs-restarting)"
      sec_line warn "reboot required (needs-restarting -r reports core updates pending a reboot)"
      return 0
    fi
  fi
  BH_SYSSEC_REBOOT="unknown"
  sec_line info "reboot status unknown (no dpkg/rpm kernel data and no reboot-required flag)"
}

# ---- 5. journald persistence ------------------------------------------------
bhv5c9_journal() {
  BH_SYSSEC_JOURNAL="n/a"
  if [ ! -d /run/systemd/system ]; then
    sec_line info "journald persistence: n/a (no systemd)"
    return 0
  fi
  local st="" syslog=0
  # first Storage= line wins (journald.conf semantics); default is auto
  st="$(grep -hE '^[[:space:]]*Storage[[:space:]]*=' /etc/systemd/journald.conf 2>/dev/null \
        | head -n 1 | sed 's/^[^=]*=//' | tr -d '[:space:]' | tr '[:upper:]' '[:lower:]')"
  case "$st" in
    ""|auto)
      if [ -d /var/log/journal ]; then st="persistent"; else st="volatile"; fi ;;
  esac
  command_exists pgrep && \
    { pgrep -x rsyslogd >/dev/null 2>&1 || pgrep -x syslog-ng >/dev/null 2>&1; } && syslog=1
  case "$st" in
    persistent)
      BH_SYSSEC_JOURNAL="persistent"
      sec_line ok "journald: persistent on disk (/var/log/journal — logs survive reboot)" ;;
    volatile|none)
      BH_SYSSEC_JOURNAL="volatile"
      if [ "$syslog" = "1" ]; then
        sec_line ok "journald: volatile but logs forwarded to a syslog daemon (rsyslogd/syslog-ng running)"
      else
        sec_line warn "journald: volatile — logs lost on reboot (forensic evidence gap; mkdir /var/log/journal or set Storage=persistent)"
      fi ;;
    *)
      BH_SYSSEC_JOURNAL="$st"
      sec_line info "journald: Storage=$st (unrecognized journald.conf value)" ;;
  esac
}

# ---- 6. auto-update timer truth ---------------------------------------------
bhv5c9_timer() {
  BH_SYSSEC_TIMER="n/a"
  if [ ! -d /run/systemd/system ] || ! command_exists systemctl; then
    sec_line info "auto-update timer: n/a (no systemd)"
    return 0
  fi
  local t=""
  if bhv5c9_to 3 systemctl is-active apt-daily-upgrade.timer >/dev/null 2>&1; then
    t="apt-daily-upgrade.timer"
  elif bhv5c9_to 3 systemctl is-active dnf-automatic.timer >/dev/null 2>&1; then
    t="dnf-automatic.timer"
  fi
  if [ -n "$t" ]; then
    BH_SYSSEC_TIMER="active: $t"
    sec_line ok "auto-update timer active: $t (patching will actually run)"
    return 0
  fi
  # configured-but-inactive: reuse v4's BH_AUTO_UPD (set by sec_misc in 80)
  case "${BH_AUTO_UPD:-not detected}" in
    ""|"not detected"|"n/a")
      BH_SYSSEC_TIMER="none"
      sec_line info "auto-update timer: none active (auto-updates not configured — patch manually)" ;;
    *)
      BH_SYSSEC_TIMER="inactive"
      sec_line warn "auto-upgrade configured ($BH_AUTO_UPD) but timer inactive — updates are NOT being applied automatically" ;;
  esac
}

# sec_system_sec — entry point, called (guarded `declare -F`) from
# run_sec_audit in 80-ssh.sh. Every verdict goes through sec_line, so
# BH_SEC_WARN/BH_SEC_BAD and the posture/exit gates pick these up.
sec_system_sec() {
  [ "${BH_NO_SEC:-0}" = "1" ] && return 0   # belt & braces (run_sec_audit gates too)
  bhv5c9_pam_2fa
  bhv5c9_edr_census
  bhv5c9_cron_triage
  bhv5c9_reboot
  bhv5c9_journal
  bhv5c9_timer
  return 0
}

# ============ lib/87-malware-hunt.sh ============
# =====================================================================
# blackhole-vps-bench · 87-malware-hunt.sh — live process malware hunt (v5, C09)
# Called (via a guarded `declare -F sec_malware_hunt`) from run_sec_audit
# (80-ssh.sh); standalone-sourceable like 85-hardening.sh.
# What it does — one pass over /proc/[0-9]*/exe (readlink only; find is NOT
# used here so the whole hunt stays inside a ~2s budget):
#   - exe ending " (deleted)"  → WARN  "N process(es) running deleted binaries"
#     (up to 3 PIDs listed; the cmdline is NEVER printed — args can carry
#     secrets — only the short comm name)
#   - exe inside /tmp/* /var/tmp/* /dev/shm/* /run/user/* (world-writable
#     dirs) → BAD "process executing from world-writable dir: <path> (pid N)"
#     (up to 3 lines; with BH_REDACT=1 only the basename is shown)
#   - /memfd:*                 → INFO only (runtime-legit: JVM/.NET in-memory
#     exec, credential helpers) — never a warn
# Non-root can only readlink exe links of their own UID, so every verdict
# line gets an "(own-user view)" suffix when EUID != 0.
# Robustness: /proc/X/exe may vanish between the glob and the readlink
# (process race) — an empty result is skipped silently, never flagged.
# Every verdict goes through sec_line EXACTLY like 85-hardening.sh so
# BH_SEC_WARN / BH_SEC_BAD (and the --fail-on exit gate) stay consistent;
# capped at 3 BAD + 3 WARN lines. mawk-safe; POSIX-ish bash; no set -e;
# no sudo; English only, no emoji; strictly read-only.
# =====================================================================
# shellcheck shell=bash

# ------- module globals (raw values; the report layer may read them) -------
BH_MH_DELETED=0      # processes running binaries deleted from disk
BH_MH_WWEXEC=0       # processes executing from world-writable dirs
BH_MH_MEMFD=0        # memfd-backed processes (runtime-legit, INFO only)
BH_MH_SCANNED=0      # /proc entries whose exe link was actually readable
BH_MH_PARTIAL=0      # 1 = scan bailed early on the wall-clock budget

# Standalone-sourceable: the real sec_line lives in 80-ssh.sh. When this
# module is sourced on its own (tests, one-off debugging) provide a quiet
# fallback so nothing ever errors; 80-ssh.sh overrides it when loaded.
if ! command -v sec_line >/dev/null 2>&1; then
  sec_line() { return 0; }
fi
# Posture counters live in 80-ssh.sh; fill them ONLY when missing so a
# standalone source still reports sane numbers (never clobbers 80's values).
: "${BH_SEC_PASS:=0}"; : "${BH_SEC_WARN:=0}"; : "${BH_SEC_BAD:=0}"

# bhv5c9_to SECS CMD... — bh_run_to (85-hardening.sh) when available, else a
# plain `timeout` wrapper. Guarantees no external call here can hang.
bhv5c9_to() {
  local secs="$1"; shift
  if command -v bh_run_to >/dev/null 2>&1; then
    bh_run_to "$@"
    return $?
  fi
  if command_exists timeout; then
    timeout "$secs" "$@" 2>/dev/null </dev/null
  else
