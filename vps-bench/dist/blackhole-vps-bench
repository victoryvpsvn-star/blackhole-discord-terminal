# ---- R3-approved deep-scan verdicts (optional: ""/0 when undetermined) ----
BH_VIRT_NESTED=""      # C4: exposed | masked | native | ""  (nested-virt tri-state)
BH_CONF_COMPUTING=""   # C1: amd-sev|amd-sev-es|amd-sev-snp|intel-tdx|intel-sgx|arm-cca|""
BH_IRQ_VMM=""          # C7: comma list of VMM handler names from /proc/interrupts
BH_VIRTIO_DEVS=""      # C8: comma list of virtio driver names (virtio_blk,virtio_net)
BH_IRQ_VMM_RE='kvm[a-z-]*|xen[a-z-]*|hv_[a-z]+|vmbus|dragonball[.a-z0-9]*|virtio[0-9]*|vfio|firecracker|cloud-hypervisor'

# ---- v5 deep tells (C03): evidence-only fingerprints + orthogonal verdicts ----
BH_VMM_TELLS=""        # comma list of VMM evidence IDs: nicdrv,pcivendor,modules,dmesg,cmdline,dt,xenver,emu-nic,pci-off
BH_QEMU_ACCEL=""       # kvm | tcg | "" — QEMU/Bochs DMI only; hardware accel vs emulated (benchmark caveat)
BH_ACPI_OEM=""         # mapped ACPI DSDT OEM ID (QEMU | Xen | VBox | VMware) or "" when unknown/unreadable
BH_DMI_SPOOF=0         # 1 = hypervisor evidence contradicts a physical-vendor/physical-chassis DMI
BH_XEN_VER=""          # /sys/hypervisor/version when /sys/hypervisor/type = xen

dmi_read() {
  local f="/sys/class/dmi/id/$1" v=""
  if [ -r "$f" ]; then v="$(tr -d '\n' < "$f" 2>/dev/null)"; fi
  printf '%s' "$v"
}

read_all_dmi() {
  BH_DMI_VENDOR="$(dmi_read sys_vendor)"
  BH_DMI_PRODUCT="$(dmi_read product_name)"
  BH_DMI_FAMILY="$(dmi_read product_family)"
  BH_DMI_BOARD="$(dmi_read board_vendor)"
  BH_DMI_BIOS="$(dmi_read bios_vendor)"
  BH_DMI_BIOS_VERSION="$(dmi_read bios_version)"
  BH_DMI_ASSET_TAG="$(dmi_read chassis_asset_tag)"
}

append_ev() { BH_EVIDENCE="${BH_EVIDENCE:+$BH_EVIDENCE
}• $1"; }

# x86: "hypervisor" sits in the flags line; aarch64: the same token appears in
# the "Features" line (Graviton/Ampere KVM guests) — whole-file grep covers
# both. ARM has no vmx/svm; this is the only CPU-level hypervisor tell there.
has_hv_flag() { grep -qw hypervisor /proc/cpuinfo 2>/dev/null; }

cpu_brand() { awk -F': ' '/model name/{print $2; exit}' /proc/cpuinfo 2>/dev/null; }

# systemd-detect-virt guarded by command_exists + timeout 3 (contract).
sdv_vmm() {
  command_exists systemd-detect-virt || return 0
  if command_exists timeout; then
    timeout 3 systemd-detect-virt --vm 2>/dev/null || true
  else
    systemd-detect-virt --vm 2>/dev/null || true
  fi
}
sdv_any() {
  command_exists systemd-detect-virt || return 0
  if command_exists timeout; then
    timeout 3 systemd-detect-virt 2>/dev/null || true
  else
    systemd-detect-virt 2>/dev/null || true
  fi
}

# grep with an optional 3s timeout — used for the larger /proc scans below;
# plain greps on tiny files (cpuinfo, cgroups) follow the existing file style.
bh_grep_to() {
  if command_exists timeout; then timeout 3 grep "$@"; else grep "$@"; fi
}

# sort + dedupe whitespace-separated words into a comma list (bash-3.2 safe)
bh_join_commas() {
  [ -n "${1:-}" ] || return 0
  local out
  out="$(printf '%s\n' "$1" | sort -u | tr '\n' ',')"
  printf '%s' "${out%,}"
}

# ---- chassis ----
# SMBIOS chassis_type: 1 (Other) / 2 (Unknown) is what most VMs report;
# 3..36 are concrete physical enclosures (desktop, tower, rack, blade, ...).
detect_chassis() {
  local v
  v="$(dmi_read chassis_type)"
  case "$v" in
    ''|*[!0-9]*) return 0 ;;   # file missing or not a plain integer
  esac
  BH_CHASSIS_TYPE="$v"
  case "$v" in
    1|2)
      BH_CHASSIS_CLASS="vm"
      BH_CHASSIS_WEAK=1   # softened: 1/Other and 2/Unknown are also common on physical OEM boards
      ;;
    *)
      if [ "$v" -ge 3 ] && [ "$v" -le 36 ]; then
        BH_CHASSIS_CLASS="physical"
      else
        BH_CHASSIS_CLASS=""
      fi
      ;;
  esac
  case "$BH_CHASSIS_CLASS" in
    vm)
      if [ "$BH_CHASSIS_WEAK" = "1" ]; then
        append_ev "DMI chassis_type=$v => VM-typical (weak: 1/Other also common on physical OEM boards)"
      else
        append_ev "DMI chassis_type=$v => VM-typical"
      fi
      ;;
    physical) append_ev "DMI chassis_type=$v => physical chassis" ;;
  esac
}

# ---- chroot ----
# Our "/" is not the root PID 1 sees. Purely informational here — detect_virt
# only promotes it to a verdict when no container/VM signal exists at all.
detect_chroot() {
  BH_IS_CHROOT=0
  [ -d /proc/1/root/. ] || return 0
  local a b
  a="$(stat -c %d:%i / 2>/dev/null)"
  b="$(stat -c %d:%i /proc/1/root/. 2>/dev/null)"
  if [ -n "$a" ] && [ -n "$b" ] && [ "$a" != "$b" ]; then
    BH_IS_CHROOT=1
    append_ev "/ and /proc/1/root/. differ (device:inode) => chroot"
  fi
}

# Map DMI vendor/product (optional: bios_vendor, chassis asset tag) to a
# friendly VM product name. Prints "" when unknown.
map_vm_product() {
  local vendor="$1" product="${2:-}" bios="${3:-}" tag="${4:-}" p2=""
  case "$vendor" in
    QEMU)
      # v5: refine the stock signature with the QEMU machine type when the
      # product string carries one (i440FX/Q35); fall back to the generic tag.
      case "$product" in
        *Q35*)    printf 'QEMU Q35' ;;
        *i440FX*) printf 'QEMU i440fx' ;;
        *)        printf 'KVM/QEMU' ;;
      esac
      ;;
    "Amazon EC2")            printf 'AWS EC2 (Nitro/KVM)' ;;
    "Microsoft Corporation") printf 'Hyper-V' ;;
    VMware*)                 printf 'VMware ESXi' ;;
    "innotek GmbH")          printf 'VirtualBox' ;;
    Xen)                     printf 'Xen HVM' ;;
    Bochs)                   printf 'Bochs' ;;
    "Parallels Software International Inc.") printf 'Parallels' ;;
    Google)                  printf 'Google Compute Engine (KVM)' ;;
    DigitalOcean)            printf 'DigitalOcean (KVM)' ;;
    Hetzner)                 printf 'Hetzner Cloud (KVM)' ;;
    Scaleway)                printf 'Scaleway (KVM)' ;;
    "Oracle Corporation")
      # Oracle Corporation covers both on-prem Oracle VM and OCI guests;
      # only the OracleCloud.com chassis asset tag means OCI.
      if [ "$tag" = "OracleCloud.com" ]; then
        printf 'Oracle Cloud (OCI)'
      else
        printf 'Oracle VM'
      fi
      ;;
    Alibaba*)                printf 'Alibaba Cloud (KVM)' ;;
    Tencent*)                printf 'Tencent Cloud (KVM)' ;;
    OpenStack*|Mirantis*)    printf 'OpenStack (KVM)' ;;
    "FreeBSD bhyve"|bhyve)   printf 'bhyve' ;;
    Nutanix*)                printf 'Nutanix AHV (KVM)' ;;
    crosvm)                  printf 'crosvm (KVM)' ;;
    "Cloud Hypervisor"|cloud-hypervisor|clh) printf 'Cloud Hypervisor' ;;
    *)
      case "$product" in
        *"Virtual Machine"*)      p2='KVM/QEMU' ;;
        *VMware*)                 p2='VMware' ;;
        *VirtualBox*)             p2='VirtualBox' ;;
        *"HVM domU"*)             p2='Xen HVM' ;;
        *BHYVE*|*bhyve*)          p2='bhyve' ;;
        # v5: QEMU machine types + newer KVM-family products. The machine-type
        # strings only mean QEMU when the BIOS flavor is QEMU firmware
        # (SeaBIOS / OVMF / EDK II) — otherwise keep the generic KVM/QEMU tag.
        *"i440FX"*)
          case "$bios" in
            SeaBIOS|OVMF|*EDK*|*edk*|"") p2='QEMU i440fx' ;;
            *)                           p2='KVM/QEMU' ;;
          esac ;;
        *"Q35"*)
          case "$bios" in
            SeaBIOS|OVMF|*EDK*|*edk*|"") p2='QEMU Q35' ;;
            *)                           p2='KVM/QEMU' ;;
          esac ;;
        *Nutanix*)                p2='Nutanix AHV (KVM)' ;;
        *crosvm*)                 p2='crosvm (KVM)' ;;
        *"Cloud Hypervisor"*|*cloud-hypervisor*|*cloud_hypervisor*) p2='Cloud Hypervisor' ;;
        *"Standard PC"*|*"QEMU"*) p2='KVM/QEMU' ;;
        *"Alibaba Cloud ECS"*)    p2='Alibaba Cloud ECS (KVM)' ;;
        *OpenStack*)              p2='OpenStack (KVM)' ;;
        *)                        p2='' ;;
      esac
      # Linode exposes no sys_vendor/product signature — only bios_vendor says "Linode"
      if [ -z "$p2" ] && [ "$bios" = "Linode" ]; then p2='Linode (KVM)'; fi
      printf '%s' "$p2"
      ;;
  esac
}

# Map DMI data (vendor, product, bios_vendor, chassis asset tag) to a cloud
# provider. Prints "" when the platform carries no cloud identity.
# NOTE: "Microsoft Corporation" alone is plain Hyper-V — Azure requires the
# well-known chassis asset tag 7783-7084-3265-9085-8269-3286-77.
map_vm_cloud() {
  local vendor="$1" product="${2:-}" bios="${3:-}" tag="${4:-}"
  case "$vendor" in
    "Amazon EC2")  printf 'AWS EC2' ;;
    "Microsoft Corporation")
      if [ "$tag" = "7783-7084-3265-9085-8269-3286-77" ]; then
        printf 'Microsoft Azure'
      fi
      ;;
    Google)        printf 'Google Cloud' ;;
    DigitalOcean)  printf 'DigitalOcean' ;;
    Alibaba*)      printf 'Alibaba Cloud' ;;
    Tencent*)      printf 'Tencent Cloud' ;;
    OpenStack*)    printf 'OpenStack cloud' ;;
    "Oracle Corporation")
      if [ "$tag" = "OracleCloud.com" ]; then
        printf 'Oracle Cloud (OCI)'
      fi
      ;;
    Hetzner)       printf 'Hetzner Cloud' ;;
    Scaleway)      printf 'Scaleway' ;;
    *)
      # Linode: no sys_vendor, only bios_vendor
      if [ "$bios" = "Linode" ]; then
        printf 'Linode (Akamai)'
      else
        case "$product" in
          *OpenStack*) printf 'OpenStack cloud' ;;
        esac
      fi
      ;;
  esac
}

# Pure helper (tests call this directly): cloud identity from DMI globals.
cloud_from_dmi() {
  map_vm_cloud "$BH_DMI_VENDOR" "$BH_DMI_PRODUCT" "$BH_DMI_BIOS" "$BH_DMI_ASSET_TAG"
}

# AWS bios_version looks like "4.2.amazon" — evidence-only corroboration.
bh_aws_bios_ev() {
  case "$BH_DMI_BIOS_VERSION" in
    *amazon*) append_ev "DMI bios_version='$BH_DMI_BIOS_VERSION' (Amazon build)" ;;
  esac
}

# AWS EC2 generation split from the DMI signature:
#   product contains ".metal"  -> bare metal instance (Nitro)
#   product contains "HVM domU" -> Xen generation
#   otherwise                  -> Nitro (KVM), with /sys/hypervisor/type as tiebreak
classify_aws() {
  local hv=""
  [ -r /sys/hypervisor/type ] && hv="$(tr -d '\n' < /sys/hypervisor/type 2>/dev/null)"
  case "$BH_DMI_PRODUCT" in
    *.metal*)
      BH_AWS_GEN="nitro"
      BH_KIND="bare-metal"
      BH_TYPE="aws-metal"
      BH_PRODUCT="AWS EC2 bare metal (Nitro)"
      append_ev "AWS DMI product '$BH_DMI_PRODUCT' contains .metal => bare metal instance (Nitro)"
      ;;
    *"HVM domU"*)
      BH_AWS_GEN="xen"
      BH_PRODUCT="AWS EC2 (Xen HVM domU)"
      append_ev "AWS DMI product 'HVM domU' => Xen generation"
      ;;
    *)
      if [ "$hv" = "xen" ]; then
        BH_AWS_GEN="xen"
        BH_PRODUCT="AWS EC2 (Xen)"
        append_ev "/sys/hypervisor/type = xen => AWS Xen generation"
      else
        BH_AWS_GEN="nitro"
        BH_PRODUCT="AWS EC2 (Nitro/KVM)"
        append_ev "AWS DMI without 'HVM domU'/xen hypervisor => Nitro generation"
      fi
      ;;
  esac
  bh_aws_bios_ev
}

map_container_product() {
  case "$1" in
    docker)         printf 'Docker' ;;
    podman)         printf 'Podman' ;;
    kubernetes)     printf 'Kubernetes (CRI)' ;;
    lxc)            printf 'LXC / LXD' ;;
    systemd-nspawn) printf 'systemd-nspawn' ;;
    openvz)         printf 'OpenVZ / Virtuozzo' ;;
    containerd)     printf 'containerd' ;;
    chroot)         printf 'chroot environment' ;;
    *)              printf 'Container (%s)' "$1" ;;
  esac
}

map_sdv_product() {
  case "$1" in
    kvm)       printf 'KVM' ;;
    qemu)      printf 'QEMU' ;;
    vmware)    printf 'VMware' ;;
    microsoft) printf 'Hyper-V' ;;
    oracle)    printf 'VirtualBox' ;;
    xen)       printf 'Xen' ;;
    bochs)     printf 'Bochs' ;;
    parallels) printf 'Parallels' ;;
    bhyve)     printf 'bhyve' ;;
    "")       printf '' ;;
    *)         printf 'hypervisor (%s)' "$1" ;;
  esac
}

# Detect the hypervisor hosting the container we run in (best effort).
detect_host_virt() {
  local t p
  t="$(sdv_vmm)"
  p="$(map_vm_product "$BH_DMI_VENDOR" "$BH_DMI_PRODUCT" "$BH_DMI_BIOS" "$BH_DMI_ASSET_TAG")"
  if [ -n "$p" ]; then
    BH_HOST_TYPE="${t:-$BH_HOST_TYPE}"
    BH_HOST_PRODUCT="$p"
    append_ev "host DMI: vendor='$BH_DMI_VENDOR' product='$BH_DMI_PRODUCT'"
  elif [ -n "$t" ]; then
    BH_HOST_TYPE="$t"
    p="$(map_sdv_product "$t")"
    BH_HOST_PRODUCT="${p:-$t}"
    append_ev "systemd-detect-virt --vm = $t"
  fi
}

detect_virt_core() {
  read_all_dmi
  detect_chassis
  detect_chroot
  local ctype=""

  # ---- container signals ----
  # G8 fix: evaluated BEFORE any WSL early-return — Docker can run inside WSL2,
  # and that box must report kind=container/type=docker with the WSL1-vs-WSL2
  # distinction kept as the HOST label (see the WSL block below).
  if [ -e /.dockerenv ]; then
    ctype="docker"
    append_ev "/.dockerenv present"
  fi
  if [ -e /run/.containerenv ]; then
    ctype="${ctype:-podman}"
    append_ev "/run/.containerenv present (Podman)"
  fi
  if [ -r /run/systemd/container ]; then
    local sc
    sc="$(tr -d '\n' < /run/systemd/container 2>/dev/null)"
    if [ -n "$sc" ]; then
      ctype="${ctype:-$sc}"
      append_ev "/run/systemd/container = $sc"
    fi
  fi
  local cg
  for cg in /proc/1/cgroup /proc/self/cgroup /proc/self/mountinfo; do
    [ -r "$cg" ] || continue
    if grep -aq kubepods "$cg" 2>/dev/null; then
      ctype="kubernetes"; append_ev "$cg mentions kubepods"
    fi
    if grep -aqE '/docker[/-]|docker\.slice' "$cg" 2>/dev/null; then
      ctype="${ctype:-docker}"; append_ev "$cg references docker"
    fi
    if grep -aqE 'libpod|podman' "$cg" 2>/dev/null; then
      ctype="${ctype:-podman}"; append_ev "$cg references podman/libpod"
    fi
    if grep -aqE '(^|[:/])lxc' "$cg" 2>/dev/null; then
      ctype="${ctype:-lxc}"; append_ev "$cg references lxc"
    fi
    if grep -aqE 'machine.slice|systemd-nspawn' "$cg" 2>/dev/null; then
      ctype="${ctype:-systemd-nspawn}"; append_ev "$cg references systemd-nspawn/machine.slice"
    fi
    if grep -aq 'vzcid\|/vz/' "$cg" 2>/dev/null; then
      ctype="openvz"; append_ev "$cg references openvz"
    fi
  done
  if [ -e /var/run/secrets/kubernetes.io/serviceaccount ] || [ -e /run/secrets/kubernetes.io/serviceaccount ]; then
    ctype="kubernetes"
    append_ev "Kubernetes serviceaccount present"
  fi
  if [ -r /proc/1/environ ] && tr '\0' '\n' < /proc/1/environ 2>/dev/null | grep -q '^container=lxc'; then
    ctype="lxc"; append_ev "/proc/1/environ container=lxc"
  fi
  # Kubernetes injects KUBERNETES_SERVICE_HOST into PID 1's environment
  if [ -r /proc/1/environ ] && tr '\0' '\n' < /proc/1/environ 2>/dev/null | grep -q '^KUBERNETES_SERVICE_HOST='; then
    ctype="kubernetes"
    append_ev "/proc/1/environ sets KUBERNETES_SERVICE_HOST"
  fi

  # ---- OpenVZ / Virtuozzo (container tech, may sit above other signals) ----
  # Virtuozzo 7 dropped /proc/user_beancounters; envID/VxID in status is the marker
  if grep -qE '^(envID|VxID):' /proc/self/status 2>/dev/null; then
    ctype="openvz"
    append_ev "/proc/self/status has envID/VxID (OpenVZ / Virtuozzo 7)"
  fi
  if [ -e /proc/vz ] && [ ! -e /proc/bc ]; then
    ctype="openvz"
    append_ev "/proc/vz present without /proc/bc"
  elif [ -e /proc/user_beancounters ]; then
    ctype="openvz"
    append_ev "/proc/user_beancounters present"
  fi

  # ---- WSL (1 = syscall translation layer, 2 = real VM with custom kernel) ----
  # G8: runs AFTER the container signals so a container on WSL keeps its own
  # verdict and the WSL generation becomes the host VM label instead.
  if grep -qi microsoft /proc/version 2>/dev/null; then
    local krel wslprod
    krel="$(uname -r 2>/dev/null)"
    case "$krel" in
      *microsoft-standard*)
        BH_WSL_GEN=2
        wslprod="WSL2 (Windows Subsystem for Linux 2, real Linux kernel)"
        ;;
      *)
        BH_WSL_GEN=1
        wslprod="WSL1 (Windows Subsystem for Linux 1, syscall translation)"
        ;;
    esac
    if [ -n "$ctype" ]; then
      # container verdict wins; WSL1-vs-WSL2 distinction moves to the host label
      BH_KIND="container"
      BH_TYPE="$ctype"
      BH_PRODUCT="$(map_container_product "$ctype")"
      BH_HOST_TYPE="wsl$BH_WSL_GEN"
      BH_HOST_PRODUCT="$wslprod"
      append_ev "/proc/version mentions Microsoft (kernel $krel -> WSL$BH_WSL_GEN) => container on WSL$BH_WSL_GEN host"
      return
    fi
    BH_KIND="vm"; BH_TYPE="wsl"
    BH_PRODUCT="$wslprod"
    append_ev "/proc/version mentions Microsoft (kernel $krel -> WSL$BH_WSL_GEN)"
    detect_host_virt
    return
  fi

  if [ -n "$ctype" ]; then
    BH_KIND="container"
    BH_TYPE="$ctype"
    BH_PRODUCT="$(map_container_product "$ctype")"
    detect_host_virt
    return
  fi

  # ---- Xen paravirtualized (no DMI in PV guests) ----
  if [ -r /sys/hypervisor/type ] && [ "$(tr -d '\n' < /sys/hypervisor/type 2>/dev/null)" = "xen" ]; then
    if [ "$BH_DMI_VENDOR" = "Amazon EC2" ]; then
      # EC2 Xen guests DO expose DMI ("HVM domU") — report AWS, not generic Xen
      BH_KIND="vm"; BH_TYPE="xen-hvm"; BH_AWS_GEN="xen"
      BH_PRODUCT="AWS EC2 (Xen HVM domU)"
      append_ev "/sys/hypervisor/type = xen"
      append_ev "DMI: vendor='Amazon EC2' product='$BH_DMI_PRODUCT' => AWS Xen generation"
      bh_aws_bios_ev
      BH_CLOUD="AWS EC2"
      BH_CLOUD_METHOD="dmi"
      return
    fi
    BH_KIND="vm"; BH_TYPE="xen-pv"; BH_PRODUCT="Xen PV"
    append_ev "/sys/hypervisor/type = xen"
    if [ -r /proc/xen/capabilities ] && grep -q control_d /proc/xen/capabilities 2>/dev/null; then
      BH_PRODUCT="Xen dom0 (host)"
      append_ev "/proc/xen/capabilities has control_d (dom0)"
    fi
    return
  fi

  # ---- full VMs ----
  local t p
  t="$(sdv_vmm)"
  p="$(map_vm_product "$BH_DMI_VENDOR" "$BH_DMI_PRODUCT" "$BH_DMI_BIOS" "$BH_DMI_ASSET_TAG")"
  if [ -n "$p" ]; then
    BH_KIND="vm"
    BH_TYPE="${t:-unknown}"
    BH_PRODUCT="$p"
    append_ev "DMI: vendor='$BH_DMI_VENDOR' product='$BH_DMI_PRODUCT' board='$BH_DMI_BOARD'"
    [ -n "$t" ] && append_ev "systemd-detect-virt --vm = $t"
    # AWS needs a generation split (Nitro vs Xen) and a .metal bare-metal override
    case "$BH_DMI_VENDOR" in
      "Amazon EC2") classify_aws ;;
    esac
  elif [ -n "$t" ]; then
    BH_KIND="vm"
    BH_TYPE="$t"
    BH_PRODUCT="Virtual machine ($t)"
    append_ev "systemd-detect-virt --vm = $t"
  elif has_hv_flag; then
    BH_KIND="vm"
    BH_TYPE="unknown"
    BH_PRODUCT="Virtual machine (hypervisor bit set, vendor unknown)"
    append_ev "/proc/cpuinfo has 'hypervisor' flag"
  else
    BH_KIND="bare-metal"
    BH_TYPE="none"
    BH_PRODUCT="Bare metal (dedicated server)"
    append_ev "no hypervisor flag, no container markers, no VM DMI signature"
    [ -n "$BH_DMI_VENDOR" ] && append_ev "DMI: vendor='$BH_DMI_VENDOR' product='$BH_DMI_PRODUCT'"
    case "$BH_CHASSIS_CLASS" in
      physical) append_ev "chassis_type=$BH_CHASSIS_TYPE corroborates bare metal" ;;
      vm)       append_ev "chassis_type=$BH_CHASSIS_TYPE suggests VM (weak: chassis 1/Other is common on physical boards too)" ;;
    esac
    # chroot is the weakest container signal: only claim it when nothing else matched
    if [ "$BH_IS_CHROOT" = "1" ]; then
      BH_KIND="container"
      BH_TYPE="chroot"
      BH_PRODUCT="$(map_container_product chroot)"
      append_ev "everything else unknown + / differs from /proc/1/root => chroot"
    fi
  fi

  # (nested-virtualization note moved to detect_nested_virt — C4 tri-state,
  #  now runs for every kind: vm, container, bare-metal and WSL)

  # clocksource corroboration
  local cs
  cs="$(cat /sys/devices/system/clocksource/clocksource0/current_clocksource 2>/dev/null)"
  case "$cs" in
    kvm-clock) append_ev "clocksource = kvm-clock (KVM signature)" ;;
    tsc)       : ;;
    xen)       append_ev "clocksource = xen" ;;
    *)         : ;;
  esac

  # cloud vendor from DMI (metadata probes live in 12-cloud.sh)
  BH_CLOUD="$(cloud_from_dmi)"
  # Scaleway images also drop a runtime marker when DMI is hidden/overridden
  if [ -z "$BH_CLOUD" ] && [ -e /var/run/scaleway ]; then
    BH_CLOUD="Scaleway"
    append_ev "/var/run/scaleway marker present"
  fi
  [ -n "$BH_CLOUD" ] && BH_CLOUD_METHOD="dmi"
}

# =====================================================================
# R3-approved deep-scan detectors — pure local reads, no network, no
# stdout; each only SETs its global + appends evidence lines.
# =====================================================================

# ---- C4: nested virtualization tri-state ----
# BH_VIRT_NESTED = "exposed" | "masked" | "native" | "" (no CPU signal)
#   exposed: vmx/svm visible AND hypervisor flag -> guest may run its own VMs
#   native : vmx/svm visible without hypervisor flag -> bare-metal CPU
#   masked : hypervisor flag without vmx/svm -> CPUID-filtered by the host
# ARM (aarch64) has no vmx/svm; the "hypervisor" token in the Features line
# plays the hypervisor role (Graviton/Ampere), so ARM guests land on "masked".
detect_nested_virt() {
  BH_VIRT_NESTED=""
  local vmx=0 hv=0 is_arm=0
  bh_grep_to -qwE 'vmx|svm' /proc/cpuinfo 2>/dev/null && vmx=1
  has_hv_flag && hv=1
  bh_grep_to -q '^Features' /proc/cpuinfo 2>/dev/null && is_arm=1  # aarch64 cpuinfo format
  if [ "$vmx" = "1" ] && [ "$hv" = "1" ]; then
    BH_VIRT_NESTED="exposed"
    append_ev "nested virtualization exposed (vmx/svm in CPU flags) => guest may run its own VMs"
  elif [ "$vmx" = "1" ]; then
    BH_VIRT_NESTED="native"
    append_ev "vmx/svm in CPU flags without hypervisor flag => native (bare-metal CPU)"
  elif [ "$hv" = "1" ]; then
    BH_VIRT_NESTED="masked"
    if [ "$is_arm" = "1" ]; then
      append_ev "hypervisor bit in cpuinfo Features (no vmx/svm on ARM) => masked (virt features not exposed to guests)"
    else
      append_ev "hypervisor flag without vmx/svm => masked (CPUID-filtered by host)"
    fi
  fi
  # A container shares the host kernel: /proc/cpuinfo is the host's view,
  # never the container's own — never claim the guest owns the flags.
  if [ -n "$BH_VIRT_NESTED" ] && [ "$BH_KIND" = "container" ]; then
    append_ev "caveat: cpu flags are host cpu flags (container view)"
  fi
}

# ---- C1: confidential computing ----
# BH_CONF_COMPUTING = amd-sev | amd-sev-es | amd-sev-snp | intel-tdx |
#                     intel-sgx | arm-cca | ""
# Sources ONLY (no dmesg inference): (a) /proc/cpuinfo flags sev/sev_es/
# sev_snp/tdx_guest, (b) device nodes /dev/sev-guest or /dev/sev, (c)
# directory /sys/kernel/security/tdx_guest, (d) /dev/sgx_enclave or /dev/sgx
# (intel-sgx; NOTE: SGX is a host TEE capability visible on bare metal too,
# so it is the lowest-precedence verdict). Highest wins: snp > sev-es > sev
# > tdx > sgx. arm-cca is a reserved value — no (a)/(b)/(c)/(d) source
# exists for it yet, so it stays unset until an approved marker is defined.
# v5 (C03): extra device nodes were appended (not restructured); a co-resident
# SGX node only adds corroboration evidence, it never overwrites the winner.
detect_conf_computing() {
  BH_CONF_COMPUTING=""
  local src=""
  if bh_grep_to -qw 'sev_snp' /proc/cpuinfo 2>/dev/null; then
    BH_CONF_COMPUTING="amd-sev-snp"; src="cpuinfo flag sev_snp"
  elif bh_grep_to -qw 'sev_es' /proc/cpuinfo 2>/dev/null; then
    BH_CONF_COMPUTING="amd-sev-es"; src="cpuinfo flag sev_es"
  elif bh_grep_to -qw 'sev' /proc/cpuinfo 2>/dev/null; then
    BH_CONF_COMPUTING="amd-sev"; src="cpuinfo flag sev"
  elif bh_grep_to -qw 'tdx_guest' /proc/cpuinfo 2>/dev/null; then
    BH_CONF_COMPUTING="intel-tdx"; src="cpuinfo flag tdx_guest"
  fi
  if [ -z "$BH_CONF_COMPUTING" ] && [ -e /dev/sev-guest ]; then
    BH_CONF_COMPUTING="amd-sev"; src="/dev/sev-guest present"
  fi
  # v5 (C03): legacy /dev/sev node (no -guest chardev)
  if [ -z "$BH_CONF_COMPUTING" ] && [ -e /dev/sev ]; then
    BH_CONF_COMPUTING="amd-sev"; src="/dev/sev present"
  fi
  if [ -z "$BH_CONF_COMPUTING" ] && [ -d /sys/kernel/security/tdx_guest ]; then
    BH_CONF_COMPUTING="intel-tdx"; src="/sys/kernel/security/tdx_guest present"
  fi
  # v5 (C03): SGX device nodes (lowest precedence — host TEE capability)
  if [ -z "$BH_CONF_COMPUTING" ] && { [ -e /dev/sgx_enclave ] || [ -e /dev/sgx ]; }; then
    BH_CONF_COMPUTING="intel-sgx"; src="/dev/sgx_enclave|/dev/sgx present"
  fi
  if [ -n "$BH_CONF_COMPUTING" ]; then
    append_ev "confidential computing: $BH_CONF_COMPUTING ($src)"
  else
    append_ev "confidential computing: none detected"
  fi
  # v5 (C03): corroboration only — SGX alongside another verdict is extra
  # evidence, never an overwrite of the SEV/TDX winner above.
  if [ -n "$BH_CONF_COMPUTING" ] && [ "$BH_CONF_COMPUTING" != "intel-sgx" ]; then
    if [ -e /dev/sgx_enclave ] || [ -e /dev/sgx ]; then
      append_ev "SGX device node present (additional TEE capability, not the primary verdict)"
    fi
  fi
}

# ---- C7: VMM handler fingerprint from /proc/interrupts ----
# Interrupt handler names leak the hosting VMM (regex in BH_IRQ_VMM_RE).
# GUARD (R3): inside a container /proc/interrupts is the HOST's table, so the
# scan only runs when the header CPU-column count matches our visible NCPU;
# otherwise BH_IRQ_VMM stays "" (host view would be misattributed).
detect_irq_vmm() {
  BH_IRQ_VMM=""
  if [ ! -r /proc/interrupts ]; then
    append_ev "VMM fingerprint: /proc/interrupts unreadable"
    return 0
  fi
  local cols
  cols="$(awk 'NR==1{print NF; exit}' /proc/interrupts 2>/dev/null)"
  if [ "$BH_KIND" = "container" ]; then
    if [ -z "$cols" ] || [ "$cols" -ne "$NCPU" ] 2>/dev/null; then
      append_ev "VMM fingerprint skipped: /proc/interrupts shows $cols CPU columns vs NCPU=$NCPU (container sees host table)"
      return 0
    fi
  fi
  local raw
  raw="$(bh_grep_to -oE "$BH_IRQ_VMM_RE" /proc/interrupts 2>/dev/null | sort -u | tr '\n' ',')"
  raw="${raw%,}"
  BH_IRQ_VMM="$raw"
  if [ -n "$BH_IRQ_VMM" ]; then
    append_ev "VMM handlers in /proc/interrupts: $BH_IRQ_VMM"
  else
    append_ev "no VMM handler names in /proc/interrupts"
  fi
}

# ---- C8: virtio device inventory ----
# Driver basenames behind /sys/bus/virtio/devices/*/driver, e.g. virtio_blk.
detect_virtio_devs() {
  BH_VIRTIO_DEVS=""
  if [ ! -d /sys/bus/virtio/devices ]; then
    append_ev "virtio inventory: /sys/bus/virtio absent"
    return 0
  fi
  local d name names="" n=0
  for d in /sys/bus/virtio/devices/*; do
    [ -e "$d" ] || continue          # glob unmatched -> literal pattern
    [ -e "$d/driver" ] || continue   # virtio device not bound to a driver
    name="$(readlink "$d/driver" 2>/dev/null)"
    name="${name##*/}"               # basename without an external command
    [ -n "$name" ] || continue
    names="$names $name"
    n=$((n + 1))
  done
  if [ -n "$names" ]; then
    BH_VIRTIO_DEVS="$(bh_join_commas "$names")"
    append_ev "virtio devices: $BH_VIRTIO_DEVS ($n device(s))"
  else
    append_ev "no virtio devices bound"
  fi
}

# =====================================================================
# v5 deep tells (C03) — evidence-only VMM fingerprints.
# DISCIPLINE: nothing here may override BH_KIND/BH_TYPE/BH_PRODUCT or any
# verdict set above; every check only appends IDs to BH_VMM_TELLS and
# evidence lines. BH_QEMU_ACCEL, BH_DMI_SPOOF, BH_ACPI_OEM and BH_XEN_VER
# are new orthogonal globals. Budget: all reads are single 1-token
# sysfs/proc files (or 16 bytes of the ACPI table), no awk, total < 0.5s.
# =====================================================================

# bhv5c3_tell_add ID — append a deduped evidence ID to BH_VMM_TELLS.
bhv5c3_tell_add() {
  [ -n "${1:-}" ] || return 0
  case ",${BH_VMM_TELLS:-}," in
    *",$1,"*) return 0 ;;
  esac
  BH_VMM_TELLS="${BH_VMM_TELLS:+${BH_VMM_TELLS},}$1"
  return 0
}

# ---- tell: NIC driver fingerprint (/sys/class/net/*/device/driver) ----
# Paravirtual NIC drivers identify the hosting VMM; fully emulated NICs
# (e1000/rtl8139/pcnet32) are a weaker "emu-nic" tell. Inside a container
# the netns devices are host-side, so the emu-nic tell gains a (host-view)
# suffix per spec.
bhv5c3_tell_nic() {
  local base="${1:-/sys/class/net}"   # arg 1: base dir (test fixture override)
  [ -d "$base" ] || return 0
  local d drv hits=""
  for d in "$base"/*; do
    [ -e "$d/device/driver" ] || continue
    drv="$(readlink "$d/device/driver" 2>/dev/null)"
    drv="${drv##*/}"
    case "$drv" in
      virtio_net|hv_netvsc|vmxnet3|xen_netfront|ena|gve|e1000|e1000e|rtl8139|pcnet32)
        case ",$hits," in
          *",$drv,"*) : ;;
          *) hits="${hits:+$hits,}$drv" ;;
        esac
        ;;
    esac
  done
  [ -n "$hits" ] || return 0
  local view="" mapped="" m
  if [ "$BH_KIND" = "container" ]; then
    view=" (container: host netns view)"
  fi
  for m in virtio_net hv_netvsc vmxnet3 xen_netfront ena gve; do
    case ",$hits," in
      *",$m,"*)
        case "$m" in
          virtio_net)   mapped="${mapped:+$mapped,}virtio_net=>KVM/QEMU" ;;
          hv_netvsc)    mapped="${mapped:+$mapped,}hv_netvsc=>Hyper-V" ;;
          vmxnet3)      mapped="${mapped:+$mapped,}vmxnet3=>VMware" ;;
          xen_netfront) mapped="${mapped:+$mapped,}xen_netfront=>Xen" ;;
          ena)          mapped="${mapped:+$mapped,}ena=>AWS-Nitro" ;;
          gve)          mapped="${mapped:+$mapped,}gve=>Google-Cloud" ;;
        esac
        ;;
    esac
  done
  for m in e1000 e1000e rtl8139 pcnet32; do
    case ",$hits," in
      *",$m,"*) mapped="${mapped:+$mapped,}$m=>emulated" ;;
    esac
  done
  case "$hits" in
    *virtio_net*|*hv_netvsc*|*vmxnet3*|*xen_netfront*|*ena*|*gve*)
      bhv5c3_tell_add nicdrv
      append_ev "NIC driver(s): $mapped$view"
      ;;
  esac
  case "$hits" in
    *e1000*|*rtl8139*|*pcnet32*)
      if [ "$BH_KIND" = "container" ]; then
        bhv5c3_tell_add "emu-nic(host-view)"
      else
        bhv5c3_tell_add "emu-nic"
      fi
      append_ev "emulated NIC driver(s): $mapped$view"
      ;;
  esac
  return 0
}

# ---- tell: PCI vendor census (/sys/bus/pci/devices/*/vendor) ----
# 0x1af4 virtio (Red Hat), 0x1b36 QEMU, 0x15ad VMware, 0x1414 vmbus,
# 0x5853 Xen. An absent/empty PCI bus on x86 (where every real board
# enumerates PCI) hints at a microvm (pci=off) layout — but inside a
# container the empty bus is a namespace artifact, so no tell there.
bhv5c3_tell_pci() {
  local dir="${1:-/sys/bus/pci/devices}"   # arg 1: devices dir (test fixture override)
  local d v any=0
  local nv=0 nq=0 nvm=0 nms=0 nx=0 summ=""
  if [ -d "$dir" ]; then
    for d in "$dir"/*/vendor; do
      [ -r "$d" ] || continue
      any=1
      v="$(cat "$d" 2>/dev/null)"
      case "$v" in
        0x1af4|0x1AF4) nv=$((nv + 1)) ;;
        0x1b36|0x1B36) nq=$((nq + 1)) ;;
        0x15ad|0x15AD) nvm=$((nvm + 1)) ;;
        0x1414)        nms=$((nms + 1)) ;;
        0x5853)        nx=$((nx + 1)) ;;
      esac
    done
  fi
  if [ "$any" = 1 ]; then
    if [ "$nv" -gt 0 ];  then summ="${summ:+$summ,}virtio=$nv"; fi
    if [ "$nq" -gt 0 ];  then summ="${summ:+$summ,}qemu=$nq"; fi
    if [ "$nvm" -gt 0 ]; then summ="${summ:+$summ,}vmware=$nvm"; fi
    if [ "$nms" -gt 0 ]; then summ="${summ:+$summ,}vmbus=$nms"; fi
    if [ "$nx" -gt 0 ];  then summ="${summ:+$summ,}xen=$nx"; fi
    if [ -n "$summ" ]; then
      bhv5c3_tell_add pcivendor
      local view=""
      if [ "$BH_KIND" = "container" ]; then view=" (container: host view)"; fi
      append_ev "PCI vendor census: $summ$view"
    fi
    return 0
  fi
  # absent or empty bus -> pci-off microvm hint (x86 only, never containers)
  if [ "$BH_KIND" = "container" ]; then return 0; fi
  case "${BHV5C3_ARCH:-}" in
    x86_64|i386|i486|i586|i686|x86)
      bhv5c3_tell_add pci-off
      append_ev "PCI bus absent/empty on x86 => microvm-style pci=off layout"
      ;;
  esac
  return 0
}

# ---- tell: VMM kernel modules (/sys/module) ----
# vmw_*/hv_*/xen_*/virtio_*/ptp_kvm module dirs leak the host VMM layer;
# kvm_amd|kvm_intel WITHOUT a hypervisor flag means this box RUNS VMs (host).
bhv5c3_tell_modules() {
  local base="${1:-/sys/module}"   # arg 1: module dir (test fixture override)
  local d name hits="" kvmmod=""
  for d in "$base"/vmw_* "$base"/hv_* "$base"/xen_* "$base"/virtio_*; do
    [ -d "$d" ] || continue          # glob unmatched -> literal pattern
    name="${d##*/}"
    case ",$hits," in *",$name,"*) continue ;; esac
    hits="${hits:+$hits,}$name"
  done
  if [ -d "$base/ptp_kvm" ]; then
    case ",$hits," in *",ptp_kvm,"*) : ;; *) hits="${hits:+$hits,}ptp_kvm" ;; esac
  fi
  if [ -d "$base/kvm_amd" ] || [ -d "$base/kvm_intel" ]; then
    if [ "${BHV5C3_HV:-0}" = "1" ]; then
      kvmmod="kvm host module present (hypervisor flag set)"
    else
      kvmmod="kvm_amd/kvm_intel loaded WITHOUT hypervisor flag => this box runs VMs (host)"
      bhv5c3_tell_add modules
    fi
  fi
  if [ -n "$hits" ]; then
    bhv5c3_tell_add modules
    local view=""
    if [ "$BH_KIND" = "container" ]; then view=" (container: host view)"; fi
    append_ev "VMM modules in /sys/module: $hits$view"
  fi
  if [ -n "$kvmmod" ]; then
    append_ev "$kvmmod"
  fi
  return 0
}

# ---- tell: dmesg 'Hypervisor detected' line ----
# Skipped entirely when dmesg_restrict is on (output would be empty anyway);
# capped at 2s via timeout when available. Empty result -> no tell.
bhv5c3_tell_dmesg() {
  command_exists dmesg || return 0
  if [ "$(cat /proc/sys/kernel/dmesg_restrict 2>/dev/null)" = "1" ]; then
    return 0
  fi
  local line
  if command_exists timeout; then
    line="$(timeout 2 dmesg 2>/dev/null | grep -m1 -E 'Hypervisor detected: (KVM|Microsoft Hyper-V|VMware|Xen|QEMU)')" || line=""
  else
    line="$(dmesg 2>/dev/null | grep -m1 -E 'Hypervisor detected: (KVM|Microsoft Hyper-V|VMware|Xen|QEMU)')" || line=""
  fi
  [ -n "$line" ] || return 0
  line="${line:0:120}"
  bhv5c3_tell_add dmesg
  local view=""
  if [ "$BH_KIND" = "container" ]; then view=" (container: host kernel ring)"; fi
  append_ev "dmesg: \"$line\"$view"
  return 0
}

# ---- tell: kernel cmdline fingerprints ----
# firecracker-style: reboot=k + pci=off + 8250* (>= 3 tokens) => microvm;
# VM-style: root=/dev/vd?|xvd? + console=ttyS0.
bhv5c3_tell_cmdline() {
  local cf="${1:-/proc/cmdline}"   # arg 1: cmdline file (test fixture override)
  [ -r "$cf" ] || return 0
  local cl tk fc=0 vm=0
  cl="$(cat "$cf" 2>/dev/null)"
  [ -n "$cl" ] || return 0
  local toks=()
  read -r -a toks <<<"$cl" || true
  if [ "${#toks[@]}" -gt 0 ]; then
    for tk in "${toks[@]}"; do
      case "$tk" in
        reboot=k|reboot=k,*) fc=$((fc + 1)) ;;
        pci=off)             fc=$((fc + 1)) ;;
        8250*)               fc=$((fc + 1)) ;;
        root=/dev/vda|root=/dev/vda[0-9]*|root=/dev/xvda|root=/dev/xvda[0-9]*) vm=$((vm + 1)) ;;
        console=ttyS0*)      vm=$((vm + 1)) ;;
      esac
    done
  fi
  if [ "$fc" -ge 3 ]; then
    bhv5c3_tell_add cmdline
    append_ev "kernel cmdline firecracker-style (reboot=k + pci=off + 8250*) => microvm"
  fi
  if [ "$vm" -ge 2 ]; then
    bhv5c3_tell_add cmdline
    append_ev "kernel cmdline VM-style (root=/dev/vd?|xvd? + console=ttyS0)"
  fi
  return 0
}

# ---- tell: device-tree hypervisor (aarch64/arm only) ----
# /proc/device-tree/hypervisor/compatible carries "linux,kvm" or "xen";
# the file is NUL-padded property data, so strip NUL bytes first.
bhv5c3_tell_dt() {
  local cf="${1:-/proc/device-tree/hypervisor/compatible}"   # arg 1: compatible file (test fixture override)
  case "${BHV5C3_ARCH:-}" in
    aarch64|arm|armv7*|armv8*) : ;;
    *) return 0 ;;
  esac
  [ -r "$cf" ] || return 0
  local v
  v="$(tr -d '\0' < "$cf" 2>/dev/null)"
  case "$v" in
    *xen*)
      bhv5c3_tell_add dt
      append_ev "device-tree hypervisor compatible='$v' => Xen (ARM)"
      ;;
    *kvm*)
      bhv5c3_tell_add dt
      append_ev "device-tree hypervisor compatible='$v' => KVM (ARM)"
      ;;
  esac
  return 0
}

# ---- tell + global: Xen version (/sys/hypervisor) ----
bhv5c3_tell_xenver() {
  local base="${1:-/sys/hypervisor}"   # arg 1: /sys/hypervisor dir (test fixture override)
  [ "$(cat "$base/type" 2>/dev/null)" = "xen" ] || return 0
  # cat (not redirection) so a missing version file is silenced, not a shell error
  BH_XEN_VER="$(cat "$base/version" 2>/dev/null)"
  BH_XEN_VER="${BH_XEN_VER//[[:cntrl:]]/}"
  bhv5c3_tell_add xenver
  if [ -n "$BH_XEN_VER" ]; then
    append_ev "Xen hypervisor version: $BH_XEN_VER (/sys/hypervisor/version)"
  else
    append_ev "Xen detected; /sys/hypervisor/version unreadable"
  fi
  return 0
}

# ---- BH_QEMU_ACCEL: kvm | tcg | "" ----
# Only when the DMI vendor/product suggests QEMU/Bochs: KVM PV-clock evidence
# (kvm-clock or kvm PV cpu flags) with the hypervisor flag => "kvm"; the
# hypervisor flag without any PV evidence => "tcg" (emulated — benchmark
# caveat). No QEMU DMI or no hypervisor flag => "" (undetermined).
bhv5c3_qemu_accel() {
  BH_QEMU_ACCEL=""
  local q=0
  case "${BH_DMI_VENDOR:-}" in
    QEMU|Bochs) q=1 ;;
  esac
  if [ "$q" = 0 ]; then
    case "${BH_DMI_PRODUCT:-}" in
      *QEMU*|*Bochs*|*"Standard PC"*) q=1 ;;
    esac
  fi
  [ "$q" = 1 ] || return 0
  if [ "${BHV5C3_HV:-0}" = "1" ]; then
    if [ "${BHV5C3_CS:-}" = "kvm-clock" ] || [ "${BHV5C3_PV:-0}" = "1" ]; then
      BH_QEMU_ACCEL="kvm"
      append_ev "QEMU/Bochs DMI + KVM PV evidence (clocksource=${BHV5C3_CS:-none}, pv-flags=${BHV5C3_PV:-0}) => accel=kvm"
    else
      BH_QEMU_ACCEL="tcg"
      append_ev "QEMU/Bochs DMI + hypervisor flag but no KVM PV evidence (clocksource=${BHV5C3_CS:-none}) => accel=tcg (emulated: benchmark caveat)"
    fi
  fi
  return 0
}

# ---- BH_ACPI_OEM: mapped ACPI DSDT OEM ID ----
# Reads the 16-byte ACPI table header (head -c 16 | od -An -tx1; hex tokens
# keep 1-byte alignment even for space/NUL bytes), takes OEM ID bytes 10-15,
# sanitizes to [A-Z0-9 ] and maps known VMM OEMs. Missing/unreadable (root-only
# 0400 is tolerated) => "". Unknown OEM => "" (raw ID not reported).
bhv5c3_acpi_oem() {
  BH_ACPI_OEM=""
  local f="${1:-/sys/firmware/acpi/tables/DSDT}"   # arg 1: table file (test fixture override)
  [ -r "$f" ] || return 0
  local odout
  odout="$(head -c 16 "$f" 2>/dev/null | od -An -tx1)" || odout=""
  [ -n "$odout" ] || return 0
  local toks=() hexstr="" oem="" i h
  read -r -a toks <<<"$odout" || true
  if [ "${#toks[@]}" -lt 16 ]; then return 0; fi
  for i in 10 11 12 13 14 15; do
    h="${toks[i]:-}"
    case "$h" in
      [0-9a-fA-F][0-9a-fA-F]) hexstr="${hexstr}\\x$h" ;;
    esac
  done
  [ -n "$hexstr" ] || return 0
  oem="$(printf '%b' "$hexstr")"
  oem="$(printf '%s' "$oem" | tr -cd 'A-Z0-9 ')"
  [ -n "$oem" ] || return 0
  local m=""
  case "$oem" in
    BOCHS*)  m="QEMU" ;;
    XEN*)    m="Xen" ;;
    VBOX*)   m="VBox" ;;
    VMWARE*) m="VMware" ;;
  esac
  if [ -n "$m" ]; then
    BH_ACPI_OEM="$m"
    append_ev "ACPI DSDT OEM ID '$oem' => $m"
  fi
  return 0
}

# ---- BH_DMI_SPOOF: DMI/chassis contradiction detector ----
# 1 only on strong contradictions (never from weak signals):
#   a) hypervisor flag or KVM PV clocks + physical-vendor-like DMI vendor
#      (map_vm_product found nothing) => VM behind custom/spoofed DMI;
#   b) QEMU/Bochs DMI vendor + concrete physical chassis_type 3..23 =>
#      spoofed chassis.
bhv5c3_dmi_spoof() {
  BH_DMI_SPOOF=0
  local p
  p="$(map_vm_product "${BH_DMI_VENDOR:-}" "${BH_DMI_PRODUCT:-}" "${BH_DMI_BIOS:-}" "${BH_DMI_ASSET_TAG:-}")"
  if [ "${BHV5C3_HV:-0}" = "1" ] || [ "${BHV5C3_PV:-0}" = "1" ] || [ "${BHV5C3_CS:-}" = "kvm-clock" ]; then
    if [ -z "$p" ]; then
      case "${BH_DMI_VENDOR:-}" in
        Supermicro*|ASUS*|Gigabyte*|ASRock*|Dell*|HP*|Hewlett-Packard*|Lenovo*|Intel*)
          BH_DMI_SPOOF=1
          append_ev "hypervisor/PV-clock evidence behind physical-vendor DMI '${BH_DMI_VENDOR:-}' => VM behind custom/spoofed DMI"
          ;;
      esac
    fi
  fi
  case "${BH_DMI_VENDOR:-}" in
    QEMU|Bochs)
      case "${BH_CHASSIS_TYPE:-}" in
        ''|*[!0-9]*) : ;;
        *)
          if [ "${BH_CHASSIS_TYPE:-0}" -ge 3 ] && [ "${BH_CHASSIS_TYPE:-0}" -le 23 ]; then
            BH_DMI_SPOOF=1
            append_ev "QEMU/Bochs DMI with physical chassis_type=${BH_CHASSIS_TYPE:-} => spoofed chassis"
          fi
          ;;
      esac
      ;;
  esac
  if [ "$BH_DMI_SPOOF" = "1" ] && [ "$BH_KIND" = "container" ]; then
    append_ev "caveat: DMI/cpuinfo are host view (container)"
  fi
  return 0
}

# ---- orchestrator: run once at the end of detect_virt (BH_KIND already set) ----
bhv5c3_deep_tells() {
  BH_VMM_TELLS=""
  # shared 1-token inputs, read once (cached for the sub-checks below)
  BHV5C3_ARCH="$(uname -m 2>/dev/null)"
  BHV5C3_HV=0
  if has_hv_flag; then BHV5C3_HV=1; fi
  BHV5C3_PV=0
  if grep -qE 'kvmclock|kvm_steal_time|kvm_asyncpf' /proc/cpuinfo 2>/dev/null; then BHV5C3_PV=1; fi
  BHV5C3_CS="$(cat /sys/devices/system/clocksource/clocksource0/current_clocksource 2>/dev/null)"
  # evidence tells (never touch verdicts)
  bhv5c3_tell_nic
  bhv5c3_tell_pci
  bhv5c3_tell_modules
  bhv5c3_tell_dmesg
  bhv5c3_tell_cmdline
  bhv5c3_tell_dt
  bhv5c3_tell_xenver
  # orthogonal new globals
  bhv5c3_qemu_accel
  bhv5c3_acpi_oem
  bhv5c3_dmi_spoof
  return 0
}

# =====================================================================
# Entry point — 99-main.sh calls detect_virt(). Classic verdict first,
# then the cross-cutting deep-scan detectors (they need BH_KIND set for
# the container guards, hence they run after the verdict is known).
# =====================================================================
detect_virt() {
  detect_virt_core
  detect_nested_virt      # C4
  detect_conf_computing   # C1
  detect_irq_vmm          # C7
  detect_virtio_devs      # C8
  bhv5c3_deep_tells       # v5 C03: evidence-only VMM tells + accel/spoof/OEM globals
}

# ============ lib/12-cloud.sh ============
# =====================================================================
# blackhole-vps-bench · 12-cloud.sh — cloud metadata probes (IMDS etc.)
# Pure functions only: sourcing this file has NO side effects.
# cloud_metadata_probe() is called from gather_info (20-info.sh) when the
# network is allowed. Request budgets: DMI-hinted probes use 2s per
# request; the generic fallback sweep (hidden/unknown DMI) fires all
# provider probes in PARALLEL at 1s per request — worst-case wall time is
# ~3s (AWS token + instance-id + instance-type), inside the 4s total
# metadata budget.
# v5.0.0 (C02) additions: five more providers join the SAME parallel
# sweep wave (zero added wall time), a family-gated corroboration/AZ
# wave adds <=2s worst case, and bh_offline_hints() (pure local reads,
# BH_NO_NET-safe) populates evidence-only provider hints — see the v5
# section below.
# Rules:
#   - metadata NEVER overrides a different DMI-derived cloud verdict —
#     it only fills an empty BH_CLOUD or refreshes the same family;
#   - BH_AWS_GEN is derived ONLY from DMI product / instance-type evidence
#     (see bh_probe_aws) — never from "an IMDSv2 token succeeded": Xen-
#     generation EC2 instances serve IMDSv2 just like Nitro ones;
#   - PRIVACY: with BH_REDACT=1, BH_CLOUD_DETAIL keeps provider/region/size
#     evidence only — instance ids, hostnames and tenancy OCID strings are
#     never fetched into the detail (stripped at composition time).
# =====================================================================
# shellcheck shell=bash

# ---------------------------------------------------------------------
# State & flags — introduces no BH_* globals of its own; it
# only SETS detection globals owned by 10-detect.sh (BH_CLOUD,
# BH_CLOUD_DETAIL, BH_CLOUD_METHOD, BH_AWS_GEN) and READS the run-mode
# flags BH_NO_NET (00-core.sh) and BH_REDACT (privacy switch: unset or 0
# = off, 1 = keep only provider/region/size evidence).
# v5.0.0 (C02) additionally SETs: BH_CLOUD_META2, the offline hint
# globals BH_RESOLV_HINT / BH_NTP_HINT / BH_MAC_HINT / BH_V6_PREFIX_HINT
# and the internal BHV5_AWS_TOKEN cache (all default "", every read
# guarded with ${VAR:-}; see the v5 section below).
# ---------------------------------------------------------------------

# Internal: curl with a caller-chosen per-request budget, silent on any
# error, and a hard silent skip when BH_NO_NET=1. EVERY network-capable
# helper in this module funnels through here.
bh_meta_curl_cap() { # bh_meta_curl_cap <seconds> <curl args incl. URL>
  [ "${BH_NO_NET:-0}" = "1" ] && return 0
  local cap="$1"; shift
  curl -fsS --max-time "$cap" "$@" 2>/dev/null
}

# Internal budgets: 2s for DMI-hinted probes, 1s for the generic sweep.
bh_meta_curl()  { bh_meta_curl_cap 2 "$@"; }
bh_meta_curl1() { bh_meta_curl_cap 1 "$@"; }

# PRIVACY switch: returns 0 (true) when BH_REDACT=1 was requested.
bh_redact_on() { [ "${BH_REDACT:-0}" = "1" ]; }

# Internal: append one generic-sweep result record "cloud|detail|gen".
# Pipes are stripped so a hostile metadata answer cannot forge extra fields.
bh_probe_record() { # bh_probe_record <file> <cloud> <detail> [aws_gen]
  [ -n "$1" ] || return 0
  local d="${3:-}" g="${4:-}"
  d=${d//|/ }
  g=${g//|/ }
  printf '%s|%s|%s\n' "$2" "$d" "$g" >> "$1"
}

# Internal: fill BH_CLOUD from a metadata result without ever overriding a
# different DMI-derived verdict. Same-family fills just refresh the detail.
bh_meta_fill() { # bh_meta_fill <cloud-name> <detail>
  local cloud="$1" detail="${2:-}"
  case "$BH_CLOUD" in
    "")       BH_CLOUD="$cloud"
              if [ -n "$detail" ]; then BH_CLOUD_DETAIL="$detail"; fi
              BH_CLOUD_METHOD="metadata"
              ;;
    "$cloud") if [ -n "$detail" ]; then BH_CLOUD_DETAIL="$detail"; fi
              BH_CLOUD_METHOD="metadata"
              ;;
    *)        : ;;   # DMI already identified another cloud — leave it alone
  esac
}

# AWS IMDSv2: PUT a session token, then read instance-id / instance-type.
# bh_probe_aws [record-file]
#   no record-file — hinted mode (2s caps): fills BH_CLOUD/BH_CLOUD_DETAIL
#                    and derives BH_AWS_GEN from DMI/instance-type evidence.
#   record-file    — generic-sweep mode (1s caps): appends one result record.
#
# BUG G6 fix — BH_AWS_GEN derivation. A successful IMDSv2 token does NOT
# identify the hypervisor generation: Xen-generation EC2 instances serve
# IMDSv2 too. The generation is therefore derived ONLY from DMI product /
# instance-type evidence, never from "IMDSv2 answered", and it never
# overrides a verdict already made by 10-detect.sh (classify_aws, which
# owns the DMI vendor='Amazon EC2' case and runs before any metadata probe):
#   DMI product contains "HVM domU"   -> xen
#   instance type matches *.metal     -> metal (bare metal; classify_aws
#                                        reports the same DMI evidence as
#                                        'nitro' when it sees the product)
#   DMI vendor QEMU + EC2-style type  -> nitro (Nitro guests are KVM/QEMU;
#                                        EC2-style = lowercase family.type,
#                                        e.g. m5.large / t3.micro)
#   otherwise                         -> "" (unknown, left empty on purpose)
bh_probe_aws() { # bh_probe_aws [record-file]
  local out="${1:-}" cap=2
  [ -n "$out" ] && cap=1
  local token iid="" itype detail="" gen=""
  token="$(bh_meta_curl_cap "$cap" -X PUT -H 'X-aws-ec2-metadata-token-ttl-seconds: 60' http://169.254.169.254/latest/api/token)"
  [ -n "$token" ] || return 0
  # v5 (C02): stash the session token so the AZ refresh (bhv5c2_az_fetch)
  # can reuse it instead of minting a second session (60s TTL, one run;
  # never printed, never leaves the process).
  BHV5_AWS_TOKEN="$token"
  # PRIVACY: with BH_REDACT=1 the instance-id is not even fetched — it can
  # never leak into BH_CLOUD_DETAIL.
  if ! bh_redact_on; then
    iid="$(bh_meta_curl_cap "$cap" -H "X-aws-ec2-metadata-token: $token" http://169.254.169.254/latest/meta-data/instance-id)"
  fi
  itype="$(bh_meta_curl_cap "$cap" -H "X-aws-ec2-metadata-token: $token" http://169.254.169.254/latest/meta-data/instance-type)"
  if [ -n "$itype" ]; then detail="$itype"; fi
  if [ -n "$iid" ]; then detail="${detail:+$detail }($iid)"; fi
  if [ -z "${BH_AWS_GEN:-}" ]; then
    case "${BH_DMI_PRODUCT:-}" in
      *"HVM domU"*) gen="xen" ;;
      *)
        case "$itype" in
          *.metal) gen="metal" ;;
          *)
            if [ "${BH_DMI_VENDOR:-}" = "QEMU" ]; then
              case "$itype" in
                [a-z]*.[a-z]*) gen="nitro" ;;
              esac
            fi
            ;;
        esac
        ;;
    esac
  fi
  if [ -n "$out" ]; then
    bh_probe_record "$out" "AWS EC2" "$detail" "$gen"
    return 0
  fi
  bh_meta_fill "AWS EC2" "$detail"
  if [ -n "$gen" ]; then BH_AWS_GEN="$gen"; fi
}

# Azure IMDS.
#   hinted mode (no record file, 2s cap): instance/compute JSON; only
#     vmSize + zone are extracted — no subscription/tenant fields.
#   sweep mode (record file, 1s caps): the dedicated location / vmSize text
#     endpoints — stores region + size only.
bh_probe_azure() { # bh_probe_azure [record-file]
  local out="${1:-}" cap=2
  [ -n "$out" ] && cap=1
  local detail=""
  if [ -n "$out" ]; then
    local loc vmsize
    loc="$(bh_meta_curl_cap "$cap" -H 'Metadata: true' 'http://169.254.169.254/metadata/instance/compute/location?api-version=2021-02-01&format=text')"
    vmsize="$(bh_meta_curl_cap "$cap" -H 'Metadata: true' 'http://169.254.169.254/metadata/instance/compute/vmSize?api-version=2021-02-01&format=text')"
    [ -n "$loc" ] || [ -n "$vmsize" ] || return 0
    if [ -n "$vmsize" ] && [ -n "$loc" ]; then detail="$vmsize ($loc)"
    elif [ -n "$vmsize" ]; then detail="$vmsize"
    else detail="$loc"
    fi
    bh_probe_record "$out" "Microsoft Azure" "$detail"
    return 0
  fi
  local json vmsize zone
  json="$(bh_meta_curl_cap "$cap" -H 'Metadata:true' 'http://169.254.169.254/metadata/instance/compute?api-version=2021-02-01')"
  [ -n "$json" ] || return 0
  vmsize="$(printf '%s' "$json" | sed -n 's/.*"vmSize"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -n 1)"
  zone="$(printf '%s' "$json" | sed -n 's/.*"zone"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -n 1)"
  [ -n "$vmsize" ] || return 0
  detail="$vmsize"
  if [ -n "$zone" ]; then detail="$detail (zone $zone)"; fi
  bh_meta_fill "Microsoft Azure" "$detail"
}

# GCP metadata server (its DNS name only resolves inside GCP).
# Detail = machine-type + zone (the "projects/<n>/zones/" prefix is
# stripped away); both are provider/region/size facts only.
bh_probe_gcp() { # bh_probe_gcp [record-file]
  local out="${1:-}" cap=2
  [ -n "$out" ] && cap=1
  local mt zone detail=""
  mt="$(bh_meta_curl_cap "$cap" -H 'Metadata-Flavor: Google' 'http://metadata.google.internal/computeMetadata/v1/instance/machine-type' | awk -F/ '{print $NF}')"
  zone="$(bh_meta_curl_cap "$cap" -H 'Metadata-Flavor: Google' 'http://metadata.google.internal/computeMetadata/v1/instance/zone' | awk -F/ '{print $NF}')"
  [ -n "$mt" ] || [ -n "$zone" ] || return 0
  if [ -n "$mt" ] && [ -n "$zone" ]; then detail="$mt ($zone)"
  elif [ -n "$mt" ]; then detail="$mt"
  else detail="$zone"
  fi
  if [ -n "$out" ]; then
    bh_probe_record "$out" "Google Cloud" "$detail"
    return 0
  fi
  bh_meta_fill "Google Cloud" "$detail"
}

# OCI requires the well-known 'Authorization: Bearer Oracle' header.
# Hinted mode uses opc/v2; the generic sweep uses opc/v1 (same shape).
# Only the region is extracted — no tenancy/compartment OCIDs are kept.
# (The DMI chassis asset-tag 'OracleCloud.com' path in 10-detect.sh stays
# the primary OCI identifier; this is the metadata corroboration.)
bh_probe_oci() { # bh_probe_oci [record-file]
  local out="${1:-}" cap=2 url="http://169.254.169.254/opc/v2/instance/"
  if [ -n "$out" ]; then cap=1; url="http://169.254.169.254/opc/v1/instance/"; fi
  local raw region
  raw="$(bh_meta_curl_cap "$cap" -H 'Authorization: Bearer Oracle' "$url")"
  [ -n "$raw" ] || return 0
  region="$(printf '%s' "$raw" | grep -o '"region"[^,]*' | head -n 1 | sed -n 's/.*"\([^"]*\)"$/\1/p')"
  if [ -n "$out" ]; then
    bh_probe_record "$out" "Oracle Cloud (OCI)" "$region"
    return 0
  fi
  bh_meta_fill "Oracle Cloud (OCI)" "$region"
}

# Linode has no distinctive sys_vendor (only bios_vendor="Linode"), so the
# generic sweep also tries the Linode metadata service. v1.json may require
# a metadata token on hardened images — guarded: any failure is a silent
# skip, and only a trivially parseable region/size label is kept.
bh_probe_linode() { # bh_probe_linode <record-file>  (generic sweep only)
  local out="${1:-}"
  [ -n "$out" ] || return 0
  local json label region detail
  json="$(bh_meta_curl1 http://169.254.169.254/v1.json)"
  [ -n "$json" ] || return 0
  label="$(printf '%s' "$json" | sed -n 's/.*"label"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -n 1)"
  region="$(printf '%s' "$json" | sed -n 's/.*"region"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -n 1)"
  [ -n "$label" ] || [ -n "$region" ] || return 0
  if [ -n "$label" ] && [ -n "$region" ]; then detail="$label ($region)"
  elif [ -n "$label" ]; then detail="$label"
  else detail="$region"
  fi
  bh_probe_record "$out" "Linode (Akamai)" "$detail"
}

# Alibaba uses its own metadata IP instead of the link-local address.
bh_probe_ali() {
  local it
  it="$(bh_meta_curl http://100.100.100.200/latest/meta-data/instance/instance-type)"
  [ -n "$it" ] || return 0
  bh_meta_fill "Alibaba Cloud" "$it"
}

# DigitalOcean legacy v1 metadata (plain HTTP, no auth).
bh_probe_do() {
  local host region detail
  if bh_redact_on; then
    host=""   # PRIVACY: the hostname is never fetched nor stored
    region="$(bh_meta_curl http://169.254.169.254/metadata/v1/region)"
  else
    host="$(bh_meta_curl http://169.254.169.254/metadata/v1/hostname)"
    region="$(bh_meta_curl http://169.254.169.254/metadata/v1/region)"
  fi
  if [ -z "$host" ] && [ -z "$region" ]; then return 0; fi
  if [ -n "$host" ] && [ -n "$region" ]; then
    detail="$host ($region)"
  elif [ -n "$region" ]; then
    detail="$region"
  else
    detail="$host"
  fi
  bh_meta_fill "DigitalOcean" "$detail"
}

# Tencent serves metadata via a DNS name that only resolves inside their VPC.
bh_probe_tencent() { # bh_probe_tencent [record-file]
  local out="${1:-}" cap=2
  [ -n "$out" ] && cap=1
  local it
  it="$(bh_meta_curl_cap "$cap" http://metadata.tencentyun.com/latest/meta-data/instance-type)"
  [ -n "$it" ] || return 0
  if [ -n "$out" ]; then
    bh_probe_record "$out" "Tencent Cloud" "$it"
    return 0
  fi
  bh_meta_fill "Tencent Cloud" "$it"
}

# =====================================================================
# v5.0.0 (module C02) — extra provider metadata + passive offline hints
# =====================================================================
# New BH_* globals SET by this module from here on (all default "",
# every read guarded with ${VAR:-}):
#   BH_CLOUD_META2     second, evidence-only metadata verdict from the
#                      v5 provider probes: "vultr <region>" |
#                      "scaleway <type> <zone>" | "upcloud <zone>" |
#                      "openstack <az>" | "hetzner".
#                      Set by bh_meta2_apply (priority: Vultr, Scaleway,
#                      UpCloud, OpenStack, Hetzner). The BH_CLOUD fill
#                      itself still goes through bh_meta_fill, so this
#                      never overrides a different DMI-derived verdict.
#   BHV5_AWS_TOKEN     in-process IMDSv2 session token cache (stashed by
#                      bh_probe_aws, reused by bhv5c2_az_fetch). Never
#                      printed, never leaves the process.
#   BH_RESOLV_HINT     offline hint: /etc/resolv.conf search classes
#   BH_NTP_HINT        offline hint: chrony/ntp/timesyncd server classes
#   BH_MAC_HINT        offline hint: gateway MAC OUI class (first 3
#                      octets only — never a full MAC)
#   BH_V6_PREFIX_HINT  offline hint: global IPv6 prefix classes
# The four hint globals are provider-class evidence, e.g.
# "aws (search ec2.internal)". With BH_REDACT=1 they collapse to class
# names only ("aws-like") — no domains, no OUI strings. They NEVER write
# BH_CLOUD / BH_CLOUD_DETAIL.
# Budget: every v5 network probe runs at a 1s cap and all probes of a
# wave run in PARALLEL — worst-case added wall time is 2s (the Vultr
# regioncode+hostname chain, or the AWS AZ chain when no cached token
# exists; typical is sub-100ms because link-local endpoints answer or
# fail immediately).
# ---------------------------------------------------------------------

# Internal: harden a metadata string for detail/tag fields — first line
# only, pipes neutralized (mirrors bh_probe_record's stripping).
bhv5c2_clean() { # bhv5c2_clean <string>
  local s="$1"
  s="${s%%$'\n'*}"
  s="${s//|/ }"
  printf '%s' "$s"
}

# Vultr v1 metadata (plain-text answers on the link-local address).
# The region code must match ^[a-z]{3}[0-9]?$. The record's tag column
# carries "vultr <region>" for bh_meta2_apply.
# PRIVACY: with BH_REDACT=1 the hostname is never fetched — the valid
# region code alone then carries the identification.
bh_probe_vultr() { # bh_probe_vultr [record-file]
  local out="${1:-}" region="" host="" detail tag
  region="$(bh_meta_curl1 http://169.254.169.254/v1/regioncode)"
  case "$region" in
    [a-z][a-z][a-z]|[a-z][a-z][a-z][0-9]) : ;;
    *) return 0 ;;
  esac
  if ! bh_redact_on; then
    host="$(bh_meta_curl1 http://169.254.169.254/v1/hostname)"
    host="$(bhv5c2_clean "$host")"
  fi
  if [ -z "$host" ] && ! bh_redact_on; then return 0; fi
  detail="$region"
  [ -n "$host" ] && detail="$host ($region)"
  tag="vultr $region"
  if [ -n "$out" ]; then
    bh_probe_record "$out" "Vultr" "$detail" "$tag"
    return 0
  fi
  bh_meta_fill "Vultr" "$detail"
  if [ -z "${BH_CLOUD_META2:-}" ]; then BH_CLOUD_META2="$tag"; fi
  return 0
}

# Scaleway metadata (dedicated 169.254.42.42). Only commercial_type and
# zone are extracted; the zone must match ^[a-z]{2}-[a-z0-9]{2,6}-[0-9]$.
bh_probe_scaleway() { # bh_probe_scaleway [record-file]
  local out="${1:-}" json="" ctype="" zone="" detail tag
  json="$(bh_meta_curl1 'http://169.254.42.42/conf?format=json')"
  [ -n "$json" ] || return 0
  ctype="$(printf '%s' "$json" | sed -n 's/.*"commercial_type"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -n 1)"
  ctype="$(bhv5c2_clean "$ctype")"
  # grep -o takes the FIRST "zone" occurrence in document order, so a
  # hostile user_data blob cannot shadow the top-level key.
  zone="$(printf '%s' "$json" | grep -oE '"zone"[[:space:]]*:[[:space:]]*"[^"]*"' | head -n 1 | sed -n 's/.*"[^"]*"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')"
  [ -n "$ctype" ] || return 0
  if [[ ! "$zone" =~ ^[a-z]{2}-[a-z0-9]{2,6}-[0-9]$ ]]; then return 0; fi
  detail="$ctype ($zone)"
  tag="scaleway $ctype $zone"
  if [ -n "$out" ]; then
    bh_probe_record "$out" "Scaleway" "$detail" "$tag"
    return 0
  fi
  bh_meta_fill "Scaleway" "$detail"
  if [ -z "${BH_CLOUD_META2:-}" ]; then BH_CLOUD_META2="$tag"; fi
  return 0
}

# UpCloud metadata v1 (link-local JSON). Only the "zone" key is read;
# the zone must match ^[a-z]{2}-[a-z0-9]+[0-9]$.
bh_probe_upcloud() { # bh_probe_upcloud [record-file]
  local out="${1:-}" json="" zone="" tag
  json="$(bh_meta_curl1 http://169.254.169.254/metadata/v1.json)"
  [ -n "$json" ] || return 0
  zone="$(printf '%s' "$json" | grep -oE '"zone"[[:space:]]*:[[:space:]]*"[^"]*"' | head -n 1 | sed -n 's/.*"[^"]*"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')"
  if [[ ! "$zone" =~ ^[a-z]{2}-[a-z0-9]+[0-9]$ ]]; then return 0; fi
  tag="upcloud $zone"
  if [ -n "$out" ]; then
    bh_probe_record "$out" "UpCloud" "$zone" "$tag"
    return 0
  fi
  bh_meta_fill "UpCloud" "$zone"
  if [ -z "${BH_CLOUD_META2:-}" ]; then BH_CLOUD_META2="$tag"; fi
  return 0
}

# OpenStack nova metadata (covers OVH / Rackspace and other OpenStack
# clouds). The answer must START with '{' before it is parsed; only the
# availability_zone is extracted (never hostname / project / uuid).
bh_probe_openstack() { # bh_probe_openstack [record-file]
  local out="${1:-}" json="" az="" tag=""
  json="$(bh_meta_curl1 http://169.254.169.254/openstack/latest/meta_data.json)"
  [ -n "$json" ] || return 0
  local trimmed="${json#"${json%%[![:space:]]*}"}"
  case "$trimmed" in
    '{'*) : ;;
    *) return 0 ;;
  esac
  az="$(printf '%s' "$json" | sed -n 's/.*"availability_zone"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -n 1)"
  az="$(bhv5c2_clean "$az")"
  if [ -n "$az" ]; then tag="openstack $az"; fi
  if [ -n "$out" ]; then
    bh_probe_record "$out" "OpenStack cloud" "$az" "$tag"
    return 0
  fi
  bh_meta_fill "OpenStack cloud" "$az"
  if [ -n "$tag" ] && [ -z "${BH_CLOUD_META2:-}" ]; then BH_CLOUD_META2="$tag"; fi
  return 0
}

# Hetzner Cloud metadata (link-local under /hetzner/v1/). Existence
# check only — the hostname and instance-id are NEVER stored, printed or
# recorded. The region is left to the offline sources (cloud-init
# instance-data / resolv + IPv6 prefix hints in bh_offline_hints).
bh_probe_hetzner() { # bh_probe_hetzner [record-file]
  local out="${1:-}" h="" iid=""
  h="$(bh_meta_curl1 http://169.254.169.254/hetzner/v1/metadata/hostname)"
  [ -n "$h" ] || return 0
  iid="$(bh_meta_curl1 http://169.254.169.254/hetzner/v1/metadata/instance-id)"
  [ -n "$iid" ] || return 0
  if [ -n "$out" ]; then
    bh_probe_record "$out" "Hetzner Cloud" "" "hetzner"
    return 0
  fi
  bh_meta_fill "Hetzner Cloud" ""
  if [ -z "${BH_CLOUD_META2:-}" ]; then BH_CLOUD_META2="hetzner"; fi
  return 0
}

# Internal: apply the v5 provider records in priority order (Vultr,
# Scaleway, UpCloud, OpenStack, Hetzner). Mirrors bh_sweep_apply: the
# first provider with a record wins. The record's third column carries
# the BH_CLOUD_META2 tag (bh_probe_record's gen slot, unused for these
# providers); bh_meta_fill still refuses to override a different DMI
# verdict.
bh_meta2_apply() { # bh_meta2_apply <record-file>...   (priority order)
  local f cloud detail tag
  for f in "$@"; do
    [ -s "$f" ] || continue
    while IFS='|' read -r cloud detail tag; do
      [ -n "$cloud" ] || continue
      bh_meta_fill "$cloud" "$detail"
      if [ -n "$tag" ] && [ -z "${BH_CLOUD_META2:-}" ]; then
        BH_CLOUD_META2="$tag"
      fi
      break 2
    done < "$f"
  done
  return 0
}

# Internal (background job): fetch the availability zone for a big-3
# family already established by DMI or metadata. AWS reuses the stashed
# IMDSv2 token when bh_probe_aws minted one this run (60s TTL), else
# requests a fresh one; Alibaba serves zone-id from its own metadata IP;
# Tencent a placement/region. Writes "<family>|<zone>" to <outfile> on
# success — nothing else is kept or printed.
bhv5c2_az_fetch() { # bhv5c2_az_fetch <family> <outfile>
  local fam="$1" out="$2" az="" token=""
  case "$fam" in
    "AWS EC2")
      token="${BHV5_AWS_TOKEN:-}"
      [ -n "$token" ] || token="$(bh_meta_curl1 -X PUT -H 'X-aws-ec2-metadata-token-ttl-seconds: 60' http://169.254.169.254/latest/api/token)"
      [ -n "$token" ] || return 0
      az="$(bh_meta_curl1 -H "X-aws-ec2-metadata-token: $token" http://169.254.169.254/latest/meta-data/placement/availability-zone)"
      ;;
    "Alibaba Cloud")
      az="$(bh_meta_curl1 http://100.100.100.200/latest/meta-data/zone-id)"
      ;;
    "Tencent Cloud")
      az="$(bh_meta_curl1 http://metadata.tencentyun.com/latest/meta-data/placement/region)"
      ;;
    *) return 0 ;;
  esac
  [ -n "$az" ] || return 0
  az="$(bhv5c2_clean "$az")"
  printf '%s|%s\n' "$fam" "$az" > "$out" 2>/dev/null || true
  return 0
}

# Internal: append a region/zone token to BH_CLOUD_DETAIL without
# duplicating one already present (used by the AZ refresh only).
bhv5c2_detail_append() { # bhv5c2_detail_append <token>
  local d="${BH_CLOUD_DETAIL:-}" t="$1"
  [ -n "$t" ] || { printf '%s' "$d"; return 0; }
  case " $d " in *" $t "*) printf '%s' "$d"; return 0 ;; esac
  printf '%s' "${d:+$d }$t"
}

# Internal: refresh BH_CLOUD_DETAIL with the fetched zone (foreground —
# bh_meta_fill must run in the parent shell, never a background job).
bhv5c2_az_apply() { # bhv5c2_az_apply <outfile>
  [ -s "$1" ] || return 0
  local fam az
  IFS='|' read -r fam az < "$1"
  case "$fam" in
    "AWS EC2"|"Alibaba Cloud"|"Tencent Cloud") ;;
    *) return 0 ;;
  esac
  [ -n "$az" ] || return 0
  bh_meta_fill "$fam" "$(bhv5c2_detail_append "$az")"
  return 0
}

# v5 wave: family-gated provider corroboration + big-3 AZ refresh. Runs
# after the hinted probes and the generic sweep:
#   - provider corroboration probes fire when DMI (not metadata) picked
#     Scaleway / Hetzner Cloud / OpenStack cloud — DMI names the family
#     but only metadata carries the zone. (Families discovered by the
#     generic sweep were already probed inside its wave.)
#   - the AZ refresh fires when BH_CLOUD is AWS EC2 / Alibaba Cloud /
#     Tencent Cloud; bh_meta_fill applies the same-family refresh rule,
#     so the verdict is never flipped, only the detail gains a zone.
# The family gates are disjoint, so worst-case added wall time is 2s
# (the AWS AZ chain without a cached token); everything runs at 1s caps.
bh_cloud_meta_v5_wave() {
  local probe2=0 azfam=""
  if [ "${BH_CLOUD_METHOD:-}" != "metadata" ]; then
    case "${BH_CLOUD:-}" in
      Scaleway|"Hetzner Cloud"|"OpenStack cloud") probe2=1 ;;
    esac
  fi
  case "${BH_CLOUD:-}" in
    "AWS EC2"|"Alibaba Cloud"|"Tencent Cloud") azfam="${BH_CLOUD}" ;;
  esac
  [ "$probe2" = "1" ] || [ -n "$azfam" ] || return 0
  local dir
  dir="$(mktemp -d "${TMPDIR:-/tmp}/bhmeta2.XXXXXX")" || return 0
  if [ "$probe2" = "1" ]; then
    bh_probe_vultr     "$dir/vultr"     &
    bh_probe_scaleway  "$dir/scaleway"  &
    bh_probe_upcloud   "$dir/upcloud"   &
    bh_probe_openstack "$dir/openstack" &
    bh_probe_hetzner   "$dir/hetzner"   &
  fi
  if [ -n "$azfam" ]; then
    bhv5c2_az_fetch "$azfam" "$dir/az" &
  fi
  wait
  bh_meta2_apply "$dir/vultr" "$dir/scaleway" "$dir/upcloud" "$dir/openstack" "$dir/hetzner"
  bhv5c2_az_apply "$dir/az"
  rm -rf "$dir"
  return 0
}

# ---------------------------------------------------------------------
# v5 passive OFFLINE provider hints — pure parsers + one aggregator.
# Every parser takes a FILE PATH (testable in isolation; no system files
# are modified) and prints "name|evidence" ("class|vendor|oui" for the
# MAC parser); empty output = no hint. Evidence strings never contain
# tokens, ids or full MACs; with BH_REDACT=1 the aggregator keeps class
# names only. Evidence-only: these hints never write BH_CLOUD.
# ---------------------------------------------------------------------

# redact-aware formatter: "name|evidence" -> "name (evidence)" | "name-like"
bhv5c2_hint_fmt() { # bhv5c2_hint_fmt <name|evidence>
  local name="${1%%|*}" ev=""
  [ "$name" != "$1" ] && ev="${1#*|}"
  if bh_redact_on; then printf '%s-like' "$name"; return 0; fi
  if [ -n "$ev" ]; then printf '%s (%s)' "$name" "$ev"; else printf '%s' "$name"; fi
  return 0
}

# /etc/resolv.conf search/domain classes. Kubernetes "*.svc.*" entries
# are skipped on purpose (the container module owns that signal) while
# the remaining search entries keep scanning — an EKS-style
# "search default.svc.cluster.local ... ec2.internal" still yields aws.
bhv5c2_parse_resolv() { # bhv5c2_parse_resolv <resolv.conf> -> "name|evidence"
  [ -r "$1" ] || return 0
  local dom hint=""
  while IFS= read -r dom; do
    case "$dom" in
      *.svc|*.svc.*)                    continue ;;
      *ec2.internal|*compute.internal)  hint="aws|search $dom" ;;
      *internal.cloudapp.net)           hint="azure|search $dom" ;;
      *google.internal|c.*.internal)    hint="gcp|search $dom" ;;
    esac
    [ -n "$hint" ] && break
  done < <(awk '$1=="search"||$1=="domain"{for(i=2;i<=NF;i++)print $i}' "$1" 2>/dev/null)
  [ -n "$hint" ] && printf '%s\n' "$hint"
  return 0
}

# chrony/ntp/timesyncd server classes (spec table: time.aws.com,
# metadata.google.internal, ntp1.aliyun.com, time1.cloud.tencent.com).
bhv5c2_parse_ntp() { # bhv5c2_parse_ntp <config-or-sources file> -> "name|evidence"
  [ -r "$1" ] || return 0
  awk '
    /time\.aws\.com/             { print "aws|time.aws.com";             exit }
    /metadata\.google\.internal/ { print "gcp|metadata.google.internal"; exit }
    /ntp1\.aliyun\.com/          { print "alibaba|ntp1.aliyun.com";      exit }
    /time1\.cloud\.tencent\.com/ { print "tencent|time1.cloud.tencent.com"; exit }
  ' "$1" 2>/dev/null
  return 0
}

# Gateway-MAC class from an /proc/net/arp-style table (first complete
# entry: flags 0x2, valid unicast MAC). Only the first 3 octets (OUI)
# are ever reported — never the full MAC. Mini-table = a few well-known
# vendor OUIs; anything with the locally-administered bit set (second
# nibble 2/6/a/e) and no table hit classifies as locally-administered.
bhv5c2_parse_arp() { # bhv5c2_parse_arp <arp table> -> "class|vendor|oui"
  [ -r "$1" ] || return 0
  local ip hw fl mac mask dev oui vendor class
  while read -r ip hw fl mac mask dev; do
    [ "$fl" = "0x2" ] || continue
    case "$mac" in
      ??:??:??:??:??:??) : ;;
      *) continue ;;
    esac
    mac="$(printf '%s' "$mac" | tr 'A-F' 'a-f')"
    oui="${mac:0:8}"
    vendor=""
    case "$oui" in
      00:0d:3a|00:15:5d)                   vendor="microsoft" ;;
      00:50:56|00:0c:29|00:05:69|00:1c:14) vendor="vmware" ;;
      52:54:00)                            vendor="qemu" ;;
      00:16:3e)                            vendor="xen" ;;
      b8:cb:2f)                            vendor="digitalocean" ;;
    esac
    if [ -n "$vendor" ]; then
      class="vendor-known"
    else
      class="vendor-unknown"
      case "${mac:1:1}" in
        2|6|a|e) class="locally-administered" ;;
      esac
    fi
    printf '%s|%s|%s\n' "$class" "$vendor" "$oui"
    return 0
  done < "$1"
  return 0
}

# Global-scope IPv6 prefixes from /proc/net/if_inet6 (the kernel prints
# lowercase hex; scope column "00000000" = global). Provider allocation
# mini-table per spec.
bhv5c2_parse_if_inet6() { # bhv5c2_parse_if_inet6 <if_inet6> -> "name|evidence"
  [ -r "$1" ] || return 0
  local addr idx plen scope flg dev
  while read -r addr idx plen scope flg dev; do
    [ "$scope" = "00000000" ] || continue
    case "$addr" in
      2a01:4f8*)  printf 'hetzner|2a01:4f8\n';       return 0 ;;
      2604:a880*) printf 'digitalocean|2604:a880\n'; return 0 ;;
      2a03:b0c0*) printf 'digitalocean|2a03:b0c0\n'; return 0 ;;
      2001:19f0*) printf 'vultr|2001:19f0\n';        return 0 ;;
      2400:8900*) printf 'vultr|2400:8900\n';        return 0 ;;
      2001:bc8*)  printf 'scaleway|2001:bc8\n';      return 0 ;;
    esac
  done < "$1"
  return 0
}

# Aggregator — sets BH_RESOLV_HINT / BH_NTP_HINT / BH_MAC_HINT /
# BH_V6_PREFIX_HINT (guarded defaults; existing values survive when a
# parser finds nothing). Pure local reads: safe under BH_NO_NET=1 and in
# detect/sec modes. Called at the top of cloud_metadata_probe and by
# 13-region.sh's gather_region (via a command -v guard) so the hints
# populate in EVERY mode.
bh_offline_hints() {
  BH_RESOLV_HINT="${BH_RESOLV_HINT:-}"
  BH_NTP_HINT="${BH_NTP_HINT:-}"
  BH_MAC_HINT="${BH_MAC_HINT:-}"
  BH_V6_PREFIX_HINT="${BH_V6_PREFIX_HINT:-}"
  local r f cls ven oui
  r="$(bhv5c2_parse_resolv /etc/resolv.conf)"
  if [ -n "$r" ]; then BH_RESOLV_HINT="$(bhv5c2_hint_fmt "$r")"; fi
  for f in /etc/chrony/sources /etc/chrony/chrony.conf /etc/ntp.conf /etc/systemd/timesyncd.conf; do
    [ -r "$f" ] || continue
    r="$(bhv5c2_parse_ntp "$f")"
    if [ -n "$r" ]; then BH_NTP_HINT="$(bhv5c2_hint_fmt "$r")"; break; fi
  done
  r="$(bhv5c2_parse_arp /proc/net/arp)"
  if [ -n "$r" ]; then
    cls="${r%%|*}"; r="${r#*|}"; ven="${r%%|*}"; oui="${r#*|}"
    if bh_redact_on; then
      BH_MAC_HINT="$cls"
    else
      BH_MAC_HINT="$cls"
      [ -n "$ven" ] && BH_MAC_HINT="$BH_MAC_HINT $ven"
      [ -n "$oui" ] && BH_MAC_HINT="$BH_MAC_HINT ($oui)"
    fi
  fi
  r="$(bhv5c2_parse_if_inet6 /proc/net/if_inet6)"
  if [ -n "$r" ]; then BH_V6_PREFIX_HINT="$(bhv5c2_hint_fmt "$r")"; fi
  return 0
}

# Internal: apply generic-sweep records in priority order — the first
# provider with a result wins; bh_meta_fill still refuses to override a
# different DMI verdict, and the AWS generation from a record never
# overrides an already-established BH_AWS_GEN.
bh_sweep_apply() { # bh_sweep_apply <record-file>...   (priority order)
  local f cloud detail gen
  for f in "$@"; do
    [ -s "$f" ] || continue
    while IFS='|' read -r cloud detail gen; do
      [ -n "$cloud" ] || continue
      bh_meta_fill "$cloud" "$detail"
      if [ "$cloud" = "AWS EC2" ] && [ -n "$gen" ] && [ -z "${BH_AWS_GEN:-}" ]; then
        BH_AWS_GEN="$gen"
      fi
      break 2
    done < "$f"
  done
}

# Generic metadata sweep for DMI-hidden images (no vendor hint and no DMI
# cloud verdict): every unambiguous provider endpoint is probed in PARALLEL,
# each request capped at 1s, so the worst-case wall time is ~3s (AWS token +
# instance-id + instance-type) — within the 4s total metadata budget. First
# success in priority order wins: AWS, GCP, Azure, OCI, Linode, Tencent.
bh_generic_metadata_sweep() {
  local dir
  dir="$(mktemp -d "${TMPDIR:-/tmp}/bhmeta.XXXXXX")" || return 0
  bh_probe_aws     "$dir/aws"     &
  bh_probe_gcp     "$dir/gcp"     &
  bh_probe_azure   "$dir/azure"   &
  bh_probe_oci     "$dir/oci"     &
  bh_probe_linode  "$dir/linode"  &
  bh_probe_tencent "$dir/tencent" &
  # v5 (C02): five more providers join the SAME parallel wave — zero
  # added wall time (the AWS 3-request chain stays the longest at ~3s).
  bh_probe_vultr     "$dir/vultr"     &
  bh_probe_scaleway  "$dir/scaleway"  &
  bh_probe_upcloud   "$dir/upcloud"   &
  bh_probe_openstack "$dir/openstack" &
  bh_probe_hetzner   "$dir/hetzner"   &
  wait
  bh_sweep_apply "$dir/aws" "$dir/gcp" "$dir/azure" "$dir/oci" "$dir/linode" "$dir/tencent"
  bh_meta2_apply "$dir/vultr" "$dir/scaleway" "$dir/upcloud" "$dir/openstack" "$dir/hetzner"
  rm -rf "$dir"
}

# Best-effort cloud metadata probes. Guarded:
#   - skipped entirely when BH_NO_NET=1 or curl is missing
#   - vendor-hinted probes only: DMI tells us which endpoint is worth trying
#   - last-resort generic sweep: when DMI found nothing at all, probe every
#     provider endpoint in parallel (1s caps) so DMI-hidden images still
#     identify; first success in priority order wins
cloud_metadata_probe() {
  # v5 (C02): passive offline hints first — pure local reads, so they
  # also populate when BH_NO_NET=1 (detect/sec modes force it) before
  # the network probes are skipped below.
  bh_offline_hints
  [ "$BH_NO_NET" = "1" ] && return 0
  command_exists curl || return 0
  BH_CLOUD_META2="${BH_CLOUD_META2:-}"   # v5 global ("" default, guarded)

  local hinted=0
  case "$BH_DMI_VENDOR" in
    "Amazon EC2")            bh_probe_aws;     hinted=1 ;;
    "Microsoft Corporation") bh_probe_azure;   hinted=1 ;;
    Google)                  bh_probe_gcp;     hinted=1 ;;
    "Oracle Corporation")    bh_probe_oci;     hinted=1 ;;
    Alibaba*)                bh_probe_ali;     hinted=1 ;;
    DigitalOcean)            bh_probe_do;      hinted=1 ;;
    Tencent*)                bh_probe_tencent; hinted=1 ;;
  esac

  if [ "$hinted" = "0" ] && [ -z "$BH_CLOUD" ]; then
    bh_generic_metadata_sweep
  fi

  # v5 (C02): DMI-known Scaleway/Hetzner/OpenStack corroboration + big-3
  # AZ refresh (family-gated, parallel, 1s caps, <=2s worst case).
  bh_cloud_meta_v5_wave
}

# Deprecated alias kept for compatibility with the old 20-info call site.
probe_cloud_meta() { cloud_metadata_probe; }

# ============ lib/13-region.sh ============
# =====================================================================
# blackhole-vps-bench · 13-region.sh — offline region / datasource facts
# =====================================================================
# v5.0.0 (module C02). 100% OFFLINE: reads only cloud-init's local state
# files — no network, no metadata services, no curl. Expected to run in
# EVERY mode, including detect and sec (which force BH_NO_NET=1 before
# any gather call).
#
# Sources (first match wins per key):
#   1. /run/cloud-init/instance-data.json — whitelisted keys only:
#        cloud-name, region, availability-zone (plus "datasource" for the
#      class name). Parsed with grep/sed only — no jq dependency. Values
#      may be JSON null -> treated as empty. The file is only trusted
#      after a guard confirms it carries cloud-init markers ("ds-mode" /
#      "datasource" / "cloud-name").
#   2. /var/lib/cloud/instance/datasource — fallback for the datasource
#      class name only (e.g. DataSourceEc2Local).
#
# Globals SET by gather_region() (each defaults ""):
#   BH_CI_CLOUD   cloud-init cloud-name (aws / azure / gce / openstack /
#                 digitalocean / hetzner / scaleway / vultr / nocloud);
#                 derived from the datasource class when cloud-init had
#                 no cloud-name
#   BH_CI_REGION  region; derived from the AZ prefix when cloud-init has
#                 none (fsn1-dc14 -> fsn1, us-east-1a -> us-east-1)
#   BH_CI_AZ      availability-zone ("" when cloud-init had none)
#   BH_DS_CLASS   raw datasource class (DataSourceEc2Local, ...)
# BH_CLOUD / BH_CLOUD_DETAIL are NEVER touched here — detection
# (10-detect.sh) owns the verdict; these are corroborating region facts
# only.
#
# PRIVACY: no instance ids, hostnames or tokens are read from either
# file — only the whitelisted region/zone/cloud-class keys are kept.
#
# 99-main wiring: bhv5c15_v5_gathers() calls gather_region() in every
# mode. gather_region also pulls in 12-cloud.sh's bh_offline_hints()
# (via a command -v guard) so the passive provider hints populate even
# in detect/sec mode, where cloud_metadata_probe() is never called.
# =====================================================================
# shellcheck shell=bash

# ---------------------------------------------------------------------
# Pure helpers (bhv5c2_ prefix) — every one takes a path/value argument,
# prints its result ("" = nothing found) and has no side effects.
# ---------------------------------------------------------------------

# Guard: only trust a JSON file that actually carries cloud-init markers.
bhv5c2_ci_guard() { # bhv5c2_ci_guard <instance-data.json> -> 0 = trustworthy
  [ -r "$1" ] || return 1
  grep -qE '"(ds-mode|datasource|cloud-name)"' "$1" 2>/dev/null
}

# Extract a whitelisted key's string value from cloud-init's
# pretty-printed instance-data.json (grep to find the key line, sed to
# cut the value). Unquoted JSON null simply never matches the sed value
# pattern -> empty. Keys are caller-supplied literals from the whitelist
# (cloud-name / region / availability-zone / datasource).
bhv5c2_ci_json_value() { # bhv5c2_ci_json_value <file> <key> -> value|""
  [ -r "$1" ] || return 0
  grep -E "^[[:space:]]*\"$2\"[[:space:]]*:" "$1" 2>/dev/null \
    | head -n 1 \
    | sed -n 's/^[[:space:]]*"[^"]*"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p'
  return 0
}

# Derive the region from an availability-zone per spec:
#   fsn1-dc14    -> fsn1         (Hetzner "-dcNN" suffix)
#   us-east-1a   -> us-east-1    (trailing zone letter after a digit)
#   us-east1-b   -> us-east1     (GCP-style "-<letter>" suffix)
#   cn-hangzhou-g -> cn-hangzhou (Alibaba-style "-<letter>" suffix)
# Prints "" when no known suffix shape matches — the AZ is then not a
# reliable region prefix (e.g. OpenStack's generic "nova", Scaleway's
# "fr-par-1"), so the region stays empty instead of being guessed.
bhv5c2_region_from_az() { # bhv5c2_region_from_az <az> -> region|""
  local az="$1" r=""
  case "$az" in
    *-dc[0-9]*)  r="${az%-dc*}" ;;   # fsn1-dc14     -> fsn1
    *[0-9][a-z]) r="${az%?}" ;;      # us-east-1a    -> us-east-1
    *-[a-z])     r="${az%-?}" ;;     # us-east1-b    -> us-east1
  esac
  case "$r" in
    ""|*[!0-9]*) : ;;                # keep (non-empty, not a bare number)
    *) r="" ;;                       # "1a" would yield "1" — not a region
  esac
  printf '%s' "$r"
}

# Whitelisted cloud-init datasource classes (spec list; DataSourceEc2 is
# accepted as a superset for older cloud-init releases that wrote the
# bare class name). Leftmost-longest ERE matching, longer names first.
bhv5c2_ds_class_from_file() { # <file> -> first whitelisted class|""
  [ -r "$1" ] || return 0
  local re='DataSource(Ec2Local|HetznerCloud|DigitalOcean|OpenStack|Scaleway|Vultr|Azure|NoCloud|GCE|Ec2)'
  grep -oE "$re" "$1" 2>/dev/null | head -n 1
  return 0
}

# Same extraction for an already-read string (e.g. the "datasource"
# value inside instance-data.json, which may carry extra text).
bhv5c2_ds_class_from_string() { # <string> -> first whitelisted class|""
  [ -n "$1" ] || return 0
  local re='DataSource(Ec2Local|HetznerCloud|DigitalOcean|OpenStack|Scaleway|Vultr|Azure|NoCloud|GCE|Ec2)'
  printf '%s\n' "$1" | grep -oE "$re" 2>/dev/null | head -n 1
  return 0
}

# Map a datasource class to cloud-init's lowercase cloud-name vocabulary.
# Only used to fill an EMPTY BH_CI_CLOUD — it never overrides anything.
bhv5c2_ds_to_cloud() { # <class> -> cloud-name|""
  case "$1" in
    DataSourceEc2*)         printf 'aws' ;;
    DataSourceAzure)        printf 'azure' ;;
    DataSourceGCE)          printf 'gce' ;;
    DataSourceOpenStack)    printf 'openstack' ;;
    DataSourceDigitalOcean) printf 'digitalocean' ;;
    DataSourceHetznerCloud) printf 'hetzner' ;;
    DataSourceScaleway)     printf 'scaleway' ;;
    DataSourceVultr)        printf 'vultr' ;;
    DataSourceNoCloud)      printf 'nocloud' ;;
  esac
  return 0
}

# ---------------------------------------------------------------------
# Entry point — 99-main.sh calls gather_region() in every mode.
# Idempotent, offline, silent. Pure function definitions above; this
# file has NO top-level side effects.
# ---------------------------------------------------------------------
gather_region() {
  BH_CI_CLOUD=""
  BH_CI_REGION=""
  BH_CI_AZ=""
  BH_DS_CLASS=""
  local ci="/run/cloud-init/instance-data.json"
  local dsv="/var/lib/cloud/instance/datasource"
  local v
  if bhv5c2_ci_guard "$ci"; then
    v="$(bhv5c2_ci_json_value "$ci" cloud-name)"
    [ -n "$v" ] && BH_CI_CLOUD="$v"
    v="$(bhv5c2_ci_json_value "$ci" region)"
    [ -n "$v" ] && BH_CI_REGION="$v"
    v="$(bhv5c2_ci_json_value "$ci" availability-zone)"
    [ -n "$v" ] && BH_CI_AZ="$v"
    # the datasource class rides along in instance-data as well
    v="$(bhv5c2_ci_json_value "$ci" datasource)"
    [ -n "$v" ] && BH_DS_CLASS="$(bhv5c2_ds_class_from_string "$v")"
  fi
  # region fallback: derive from the AZ prefix when cloud-init had none
  if [ -z "$BH_CI_REGION" ] && [ -n "$BH_CI_AZ" ]; then
    v="$(bhv5c2_region_from_az "$BH_CI_AZ")"
    [ -n "$v" ] && BH_CI_REGION="$v"
  fi
  # datasource fallback when instance-data was absent or untrusted
  if [ -z "$BH_DS_CLASS" ]; then
    BH_DS_CLASS="$(bhv5c2_ds_class_from_file "$dsv")"
  fi
  # coarse cloud-name from the datasource class when cloud-init had none
  if [ -z "$BH_CI_CLOUD" ] && [ -n "$BH_DS_CLASS" ]; then
    v="$(bhv5c2_ds_to_cloud "$BH_DS_CLASS")"
    [ -n "$v" ] && BH_CI_CLOUD="$v"
  fi
  # passive offline provider hints (12-cloud.sh) — pulled in here too so
  # they populate in every mode even when cloud_metadata_probe() is not
  # called (detect/sec). Idempotent; guarded because this module must
  # also work when sourced standalone.
  if command -v bh_offline_hints >/dev/null 2>&1; then
    bh_offline_hints
  fi
  return 0
}

# ============ lib/15-gpu.sh ============
# =====================================================================
# blackhole-vps-bench · 15-gpu.sh — GPU / accelerator inventory (passive)
# =====================================================================
#
# v4.0 (W3-N): answers "is there a GPU here and can we actually use it?"
# sysfs-first — NO lspci dependency, ZERO network, zero writes:
#   D1 device nodes      /dev/dri/card* renderD* + /dev/nvidia* -> BH_GPU_NODES
#                        /proc/driver/nvidia/version            -> BH_NVIDIA_DRIVER
#   D2 PCI enumeration   /sys/bus/pci/devices class 0x03xx      -> BH_GPU_PCI
#   D3 nvidia-smi query  name/mem/gen/width/driver              -> BH_GPU_NVIDIA
#   D4 MIG / vGPU        nvidia-smi -L (MIG only)               -> BH_GPU_MIG / BH_GPU_VGPU
#   D5 AMD/Intel VRAM    drm sysfs mem_info_vram_total          -> BH_GPU_VRAM_SYSFS
#   D6 libs-vs-devices   ldconfig vs /dev + PCI NVIDIA          -> BH_GPU_LIBS
#   D7 passthrough       driver of the first 0x03 device        -> BH_GPU_PASSTHROUGH
#   D8 one-line verdict                                         -> BH_GPU_SUMMARY
#
# Contract: sets BH_* globals only (never prints to stdout); every potentially
# hanging external command is guarded (command_exists + `timeout 3` via
# bh_gpu_t3 — nvidia-smi is ALWAYS timeout-wrapped: a driver-less container is
# the classic hang); NO network access; no `set -e`; bash-3.2 compatible (no
# assoc arrays / mapfile / ${var,,}); never fails: on a GPU-less box every
# global stays "" (BH_GPU_LIBS becomes "none" per D6) and gather_gpu returns 0
# in well under a second. The /sys/bus/pci/devices walk is capped at 64
# devices so huge hosts stay cheap.
# shellcheck shell=bash

# ------- globals (empty / neutral defaults — the no-GPU shape) -------
BH_GPU_NODES=""        # "dri:2(card1+render1) nvidia:0" | "" = no GPU device nodes
BH_NVIDIA_DRIVER=""    # kernel module version "535.104.05" | "" = not loaded/absent
BH_GPU_PCI=""          # "1x NVIDIA 10de:2684 (3D, driver nvidia) + 1x ASPEED 1a03:2000 (VGA)" | ""
BH_GPU_NVIDIA=""       # "A100-SXM4-40GB, 40960 MiB, PCIe4 x16, driver 535.104" | ""
BH_GPU_MIG=""          # "MIG: 4 slices" | ""
BH_GPU_VGPU=""         # reserved — the `-q` vGPU probe is intentionally skipped (cheap module)
BH_GPU_VRAM_SYSFS=""   # "65536 MiB (amdgpu)" — largest card exposing sysfs VRAM | ""
BH_GPU_LIBS=""         # "cuda-libs-without-devices (broken GPU container)" | "none" | ""
BH_GPU_PASSTHROUGH=""  # "vfio (passed into VM)" | "native driver" | "driver ast" | ""
BH_GPU_SUMMARY=""      # one-line verdict, always non-empty after gather_gpu

# bh_gpu_t3 CMD... — run a possibly-hanging external command under `timeout 3`
# when available (same pattern as bh_t2 in 55-storage-map.sh / 85-hardening.sh).
bh_gpu_t3() {
  if command_exists timeout; then
    timeout 3 "$@" 2>/dev/null </dev/null
  else
    "$@" 2>/dev/null </dev/null
  fi
}

# bh_gpu_trim S — strip leading/trailing whitespace (sysfs label files are
# space-padded); pure parameter expansion, no external tool, no subshell cost.
bh_gpu_trim() {
  local s="$1"
  s="${s#"${s%%[![:space:]]*}"}"
  s="${s%"${s##*[![:space:]]}"}"
  printf '%s' "$s"
}

gather_gpu() {
  # ================= D1: device nodes =================
  local n_card=0 n_render=0 n_nv=0 p dri_part
  for p in /dev/dri/card*;    do [ -e "$p" ] || continue; n_card=$(( n_card + 1 ));   done
  for p in /dev/dri/renderD*; do [ -e "$p" ] || continue; n_render=$(( n_render + 1 )); done
  # literal /dev/nvidia* per spec — nvidiactl / nvidia-uvm control nodes count
  # too: this is device EXPOSURE, not a GPU count (nvidia-smi owns the count).
  for p in /dev/nvidia*;      do [ -e "$p" ] || continue; n_nv=$(( n_nv + 1 ));       done

  if [ $(( n_card + n_render )) -gt 0 ]; then
    dri_part="dri:$(( n_card + n_render ))(card${n_card}+render${n_render})"
  else
    dri_part="dri:0"
  fi
  if [ $(( n_card + n_render + n_nv )) -gt 0 ]; then
    BH_GPU_NODES="${dri_part} nvidia:${n_nv}"
  fi

  # kernel module version: first version-like token ("NVRM version: ... 535.104.05 ...")
  if [ -r /proc/driver/nvidia/version ]; then
    BH_NVIDIA_DRIVER="$(awk '{ for (i = 1; i <= NF; i++) if ($i ~ /^[0-9]+(\.[0-9]+)+$/) { print $i; exit } }' /proc/driver/nvidia/version 2>/dev/null)"
  fi

  # ================= D2: PCI enumeration via sysfs (no lspci) =================
  # Walk /sys/bus/pci/devices, keep only display-class (0x03xxxx) functions.
  # Pure-bash reads of the single-token sysfs files (no subshell per file);
  # the whole walk is capped at 64 devices.
  local scanned=0 i found fmt
  local -a g_fmts=() g_counts=()
  local nvidia_pci=0 first03=0 f03_driver=""
  # headline slots for the D8 summary: NVIDIA > AMD > Intel > first-of-any
  local pci_nv_m="" pci_nv_t=""        # 10de model/class
  local pci_amd_m="" pci_amd_t=""      # 1002
  local pci_itl_m=""                   # 8086
  local pci_gen_vn="" pci_gen_m="" pci_gen_t=""   # first 0x03 device, generic
  local cls ctype vend devid vname model drvname

  for p in /sys/bus/pci/devices/*; do
    [ -d "$p" ] || continue                    # unmatched glob / hotplug race
    scanned=$(( scanned + 1 ))
    [ "$scanned" -gt 64 ] && break

    cls=""
    read -r cls < "$p/class" 2>/dev/null || true
    cls="${cls#0x}"
    case "$cls" in
      030000) ctype="VGA"  ;;
      030200) ctype="3D"   ;;
      03*)    ctype="Disp" ;;
      *)      continue     ;;
    esac

    vend=""; devid=""
    read -r vend  < "$p/vendor" 2>/dev/null || true
    read -r devid < "$p/device"  2>/dev/null || true
    vend="${vend#0x}"; devid="${devid#0x}"
    case "$vend" in ''|*[!0-9a-fA-F]*) continue ;; esac
    case "$devid" in ''|*[!0-9a-fA-F]*) devid="0000" ;; esac

    case "$vend" in
      10de) vname="NVIDIA"     ;;
      1002) vname="AMD/ATI"    ;;
      8086) vname="Intel"      ;;
      1a03) vname="ASPEED"     ;;
      15ad) vname="VMware"     ;;
      1b36) vname="QXL/RedHat" ;;
      1013) vname="Cirrus"     ;;
      *)    vname="PCI"        ;;
    esac
    [ "$vend" = "10de" ] && nvidia_pci=1

    model=""
    read -r model < "$p/label" 2>/dev/null || true
    model="$(bh_gpu_trim "$model")"
    [ -n "$model" ] || model="${vend}:${devid}"

    drvname=""
    if command_exists readlink; then
      drvname="$(readlink "$p/driver" 2>/dev/null)"
      drvname="${drvname##*/}"
    fi
    if [ -n "$drvname" ]; then
      fmt="${vname} ${model} (${ctype}, driver ${drvname})"
    else
      fmt="${vname} ${model} (${ctype})"
    fi

    # dedup identical (model, class, driver) combos, keep first-seen order
    found=-1; i=0
    while [ "$i" -lt "${#g_fmts[@]}" ]; do
      [ "${g_fmts[$i]}" = "$fmt" ] && { found=$i; break; }
      i=$(( i + 1 ))
    done
    if [ "$found" -ge 0 ]; then
      local gc=${g_counts[$found]}
      g_counts[found]=$(( gc + 1 ))
    else
      g_fmts[${#g_fmts[@]}]="$fmt"
      g_counts[${#g_counts[@]}]=1
    fi

    # D7 input: first 0x03 device in sysfs order, raw driver ("" when unbound)
    if [ "$first03" -eq 0 ]; then
      first03=1
      f03_driver="$drvname"
    fi
    # D8 headline slots
    case "$vend" in
      10de) [ -z "$pci_nv_m" ]  && { pci_nv_m="$model";  pci_nv_t="$ctype"; } ;;
      1002) [ -z "$pci_amd_m" ] && { pci_amd_m="$model"; pci_amd_t="$ctype"; } ;;
      8086) [ -z "$pci_itl_m" ] && { pci_itl_m="$model"; } ;;
    esac
    [ -z "$pci_gen_m" ] && { pci_gen_vn="$vname"; pci_gen_m="$model"; pci_gen_t="$ctype"; }
  done

  if [ "${#g_fmts[@]}" -gt 0 ]; then
    i=0
    while [ "$i" -lt "${#g_fmts[@]}" ]; do
      BH_GPU_PCI="${BH_GPU_PCI:+${BH_GPU_PCI} + }${g_counts[$i]}x ${g_fmts[$i]}"
      i=$(( i + 1 ))
    done
  fi

  # ================= D3: nvidia-smi (ALWAYS timeout-wrapped) =================
  # A driver-less container (CUDA image without devices) is the classic hang —
  # never call nvidia-smi outside bh_gpu_t3.
  local nout="" nline="" parsed="" ngpu=0 qrc=0
  local nv_name="" nv_mem="" nv_drv="" nv_gen="" nv_w=""
  if command_exists nvidia-smi; then
    nout="$(bh_gpu_t3 nvidia-smi --query-gpu=name,memory.total,driver_version,pcie.link.gen.current,pcie.link.width.current --format=csv,noheader,nounits)"
    qrc=$?
    if [ -n "$nout" ]; then
      ngpu="$(printf '%s\n' "$nout" | awk 'NF { n++ } END { print n + 0 }')"
      nline="$(printf '%s\n' "$nout" | awk 'NF { print; exit }')"
      # "|" separator: GPU names never contain one, and unlike whitespace/tabs
      # a non-whitespace IFS keeps EMPTY csv fields aligned for `read`.
      parsed="$(printf '%s\n' "$nline" | awk -F', ' '{ printf "%s|%s|%s|%s|%s", $1, $2, $3, $4, $5 }')"
      IFS="|" read -r nv_name nv_mem nv_drv nv_gen nv_w _ <<<"$parsed" || true
      nv_name="$(bh_gpu_trim "$nv_name")"
      case "$nv_name" in ""|"N/A"|"ERR!"|"[N/A]"|"[Not Supported]"|"[Insufficient Permissions]") nv_name="" ;; esac
      nv_mem="$(bh_gpu_trim "$nv_mem")"; case "$nv_mem" in ''|*[!0-9]*) nv_mem="" ;; esac
      nv_drv="$(bh_gpu_trim "$nv_drv")"; case "$nv_drv" in ''|*[!0-9.]*) nv_drv="" ;; esac
      nv_gen="$(bh_gpu_trim "$nv_gen")"; case "$nv_gen" in ''|*[!0-9]*) nv_gen="" ;; esac
      nv_w="$(bh_gpu_trim "$nv_w")";     case "$nv_w"   in ''|*[!0-9]*) nv_w=""   ;; esac

      if [ -n "$nv_name" ]; then
        BH_GPU_NVIDIA="$nv_name"
        [ -n "$nv_mem" ] && BH_GPU_NVIDIA="${BH_GPU_NVIDIA}, ${nv_mem} MiB"
        if [ -n "$nv_gen" ] && [ "$nv_gen" -gt 0 ] 2>/dev/null && \
           [ -n "$nv_w" ]   && [ "$nv_w"   -gt 0 ] 2>/dev/null; then
          BH_GPU_NVIDIA="${BH_GPU_NVIDIA}, PCIe${nv_gen} x${nv_w}"
        fi
        # "535.104.05" -> "535.104" (%.* drops the last dot-component)
        [ -n "$nv_drv" ] && BH_GPU_NVIDIA="${BH_GPU_NVIDIA}, driver ${nv_drv%.*}"
        [ "$ngpu" -gt 1 ] 2>/dev/null && BH_GPU_NVIDIA="${BH_GPU_NVIDIA}, x ${ngpu} GPUs"
      fi
    fi
  fi

  # ================= D4: MIG / vGPU =================
  BH_GPU_VGPU=""    # the `-q` vGPU probe is intentionally skipped — keep it cheap
  # qrc=124 means the query probe was killed by `timeout 3` — the driver env is
  # hung, so a second nvidia-smi (-L) would just burn another 3s. Old drivers
  # that merely DON'T SUPPORT --query-gpu fail fast (rc!=124) and still get the
  # -L probe here.
  if command_exists nvidia-smi && [ "$qrc" -ne 124 ]; then
    local migout="" mign=0
    migout="$(bh_gpu_t3 nvidia-smi -L)"
    if [ -n "$migout" ]; then
      mign="$(printf '%s\n' "$migout" | awk '$1 == "MIG" { n++ } END { print n + 0 }')"
      [ "$mign" -gt 0 ] 2>/dev/null && BH_GPU_MIG="MIG: ${mign} slices"
    fi
  fi

  # ================= D5: AMD/Intel VRAM via sysfs =================
  # amdgpu (and the new xe driver) expose mem_info_vram_total in bytes,
  # world-readable — the only VRAM source that needs no privileged tool.
  local vcf vb=0 vbest=0 vdir vdrv=""
  for vcf in /sys/class/drm/card*/device/mem_info_vram_total; do
    [ -r "$vcf" ] || continue
    vb="$(tr -d ' \t\n\r' < "$vcf" 2>/dev/null)"
    case "$vb" in ''|*[!0-9]*) continue ;; esac
    [ "$vb" -gt 0 ] || continue
    if [ "$vb" -gt "$vbest" ]; then
      vbest="$vb"
      vdir="${vcf%/mem_info_vram_total}"           # .../cardN/device
      vdrv=""
      if command_exists readlink; then
        vdrv="$(readlink "${vdir}/driver" 2>/dev/null)"
        vdrv="${vdrv##*/}"
      fi
      [ -n "$vdrv" ] || vdrv="amdgpu"
    fi
  done
  [ "$vbest" -gt 0 ] && BH_GPU_VRAM_SYSFS="$(( vbest / 1048576 )) MiB (${vdrv})"

  # ================= D6: CUDA libs without devices =================
  # CUDA runtime libs present but zero NVIDIA devices/PCI: the broken-GPU-
  # container signature (workspace "GPU" plans on nvme-only VPSes).
  local cudalibs=0 ldp=""
  if command_exists ldconfig; then
    ldp="$(bh_gpu_t3 ldconfig -p)"
    case "$ldp" in *libcuda.so*|*libnvidia-ml.so*) cudalibs=1 ;; esac
  fi
  if [ "$n_nv" -eq 0 ] && [ "$nvidia_pci" -eq 0 ]; then
    if [ "$cudalibs" -eq 1 ]; then
      BH_GPU_LIBS="cuda-libs-without-devices (broken GPU container)"
    else
      BH_GPU_LIBS="none"
    fi
  fi

  # ================= D7: passthrough state of the first 0x03 device ========
  if [ "$first03" -eq 1 ]; then
    case "$f03_driver" in
      vfio-pci)              BH_GPU_PASSTHROUGH="vfio (passed into VM)" ;;
      nvidia|amdgpu|i915|xe) BH_GPU_PASSTHROUGH="native driver" ;;
      "")                    : ;;                                # unbound -> ""
      *)                     BH_GPU_PASSTHROUGH="driver ${f03_driver}" ;;
    esac
  fi

  # ================= D8: one-line verdict =================
  local gb=""
  if [ -n "$BH_GPU_NVIDIA" ]; then
    BH_GPU_SUMMARY="$nv_name"
    if [ -n "$nv_mem" ]; then
      gb="$(awk -v m="$nv_mem" 'BEGIN{ printf "%d", m / 1024 + 0.5 }')"   # MiB -> GB, rounded
      [ -n "$gb" ] && BH_GPU_SUMMARY="${BH_GPU_SUMMARY} ${gb}GB"
    fi
    [ -n "$nv_drv" ] && BH_GPU_SUMMARY="${BH_GPU_SUMMARY} (driver ${nv_drv%.*})"
    [ "$ngpu" -gt 1 ] 2>/dev/null && BH_GPU_SUMMARY="${BH_GPU_SUMMARY}, x ${ngpu} GPUs"
  elif [ -n "$pci_nv_m" ]; then
    BH_GPU_SUMMARY="NVIDIA ${pci_nv_m} (${pci_nv_t})"
  elif [ -n "$pci_amd_m" ]; then
    BH_GPU_SUMMARY="AMD/ATI ${pci_amd_m} (${pci_amd_t})"
  elif [ -n "$pci_itl_m" ]; then
    BH_GPU_SUMMARY="Intel iGPU (${pci_itl_m})"
  elif [ -n "$pci_gen_m" ]; then
    BH_GPU_SUMMARY="${pci_gen_vn} ${pci_gen_m} (${pci_gen_t})"
  elif [ -n "$BH_GPU_VRAM_SYSFS" ]; then
    BH_GPU_SUMMARY="GPU ${BH_GPU_VRAM_SYSFS}"
  elif [ -n "$BH_GPU_NODES" ]; then
    BH_GPU_SUMMARY="GPU device nodes (${BH_GPU_NODES}, no PCI view)"
  elif [ -n "$BH_GPU_MIG" ]; then
    BH_GPU_SUMMARY="${BH_GPU_MIG}"
  else
    BH_GPU_SUMMARY="no GPU detected (vCPU-only plan)"
  fi

  return 0
}

# ============ lib/16-hw-deep.sh ============
# =====================================================================
# blackhole-vps-bench · 16-hw-deep.sh — deep hardware context (v5.0.0)
# =====================================================================
#
# v5.0 (C05): passive one-line hardware facts the fast modules do not cover.
# sysfs / procfs only, every probe is a 1-token file read, zero network,
# zero writes, no PCI walk here on purpose (VMM/PCI evidence is owned by
# another module):
#   N1 NUMA topology    /sys/devices/system/node/node*          -> BH_NUMA_TXT
#   N2 offline CPUs     /sys/devices/system/cpu/offline         -> BH_NUMA_OFFLINE
#   F1 cpufreq policy   .../cpufreq/policy0 + turbo switches    -> BH_CPUFREQ_TXT
#   T1 thermal sensors  /sys/class/hwmon -> /sys/class/thermal  -> BH_THERMAL_TXT
#   T2 throttle events  .../cpu0/thermal_throttle/*_count       -> BH_THROTTLE_CNT
#   E1 machine checks   /proc/interrupts MCE + EDAC counters    -> BH_HWERR_TXT
#   M1 DIMM inventory   dmidecode -t memory (root only)         -> BH_DIMM_TXT
#                                                               BH_DIMM_NOTE
#
# Contract: function definitions only — nothing is read at source time.
# gather_hwdeep() resets every global to "" and fills what it can; any probe
# that comes up empty stays "" and the report simply omits the line (never a
# warning: cpufreq and thermal are routinely absent in VMs and containers).
# Every sysfs path is guarded with [ -r ] / [ -d ]; an unmatched glob is
# caught by the same guards. Budget: well under 0.5s — the ONLY external
# process is `dmidecode -t memory` under `timeout 2`, and only as root with
# BH_REDACT!=1. Serial numbers / vendor / locator strings are deliberately
# never parsed, so BH_DIMM_TXT cannot leak an identity even unredacted.
# shellcheck shell=bash

# ------- private helpers (prefix bhv5c5_ — owned by C05) -------

# bhv5c5_trim S — strip leading/trailing whitespace (sysfs label files are
# space-padded); pure parameter expansion, no external tool, no subshell.
bhv5c5_trim() {
  local s="${1:-}"
  s="${s#"${s%%[![:space:]]*}"}"
  s="${s%"${s##*[![:space:]]}"}"
  printf '%s' "$s"
}

# bhv5c5_sys1 FILE — first line of a one-token sysfs file, trimmed; "" when
# the file is missing or unreadable (the caller treats "" as n/a). The [ -r ]
# guard lives here so every read site is covered; plain `read`, no subshell,
# no external tool.
bhv5c5_sys1() {
  local v=""
  if [ -r "$1" ]; then
    IFS= read -r v < "$1" 2>/dev/null || v=""
  fi
  bhv5c5_trim "$v"
}

# bhv5c5_temp_c V — millidegrees Celsius -> integer degrees ("45000" -> "45",
# "-2500" -> "-2"); prints nothing when V is not a plain integer. mawk-safe:
# plain regex, %d stays far inside the int range.
bhv5c5_temp_c() {
  awk -v m="${1:-}" 'BEGIN{ if (m ~ /^-?[0-9]+$/) printf "%d", m / 1000 }' 2>/dev/null
}

# bhv5c5_cpuset_overlap A B — print "1" when the two cpulist strings ("0-3,8"
# style) share at least one logical CPU, else print nothing. Ranges are
# compared pairwise as intervals and never expanded, so huge masks cost the
# same as tiny ones.
bhv5c5_cpuset_overlap() {
  awk -v a="${1:-}" -v b="${2:-}" 'BEGIN{
    m = split(a, A, ",")
    for (i = 1; i <= m; i++) {
      if (A[i] !~ /^[0-9]+(-[0-9]+)?$/) continue
      k = split(A[i], r, "-")
      a1 = r[1] + 0; a2 = (k == 2) ? r[2] + 0 : r[1] + 0
      if (a2 < a1) { t = a1; a1 = a2; a2 = t }
      n = split(b, B, ",")
      for (j = 1; j <= n; j++) {
        if (B[j] !~ /^[0-9]+(-[0-9]+)?$/) continue
        kk = split(B[j], s, "-")
        b1 = s[1] + 0; b2 = (kk == 2) ? s[2] + 0 : s[1] + 0
        if (b2 < b1) { t = b1; b1 = b2; b2 = t }
        if (a1 <= b2 && b1 <= a2) { print "1"; exit 0 }
      }
    }
  }' 2>/dev/null
}

# bhv5c5_t2 CMD... — the only external command this module may run
# (dmidecode): always under `timeout 2` when available, stderr dropped,
# stdin detached so it can never sit on a prompt.
bhv5c5_t2() {
  if command_exists timeout; then
    timeout 2 "$@" 2>/dev/null </dev/null
  else
    "$@" 2>/dev/null </dev/null
  fi
}

# bhv5c5_dimm_line DMI_TEXT — condense `dmidecode -t memory` output into one
# report line: "dimm=<installed>/<slots> <type> <speed> ecc=<type>".
# Counts and types only: locators, vendors and serial numbers are never
# extracted, so no serial can ever reach a sink. Prints "" when the dump has
# no populated memory device. dmidecode prints Size as "N GB" (new) or
# "N MB" (old), Speed as "N MT/s" (new) or "N MHz" (old); both accepted.
bhv5c5_dimm_line() {
  printf '%s\n' "${1:-}" | awk '
    /^[ \t]*Memory Device$/ {
      slots++; devok = 0
    }
    /^[ \t]*Size:/ {
      sub(/^[^:]*:[ \t]*/, "")
      if ($0 ~ /^[0-9]+ (MB|GB)$/) { inst++; devok = 1 }
    }
    /^[ \t]*Type:/ {
      if (devok && type == "") {
        sub(/^[^:]*:[ \t]*/, "")
        sub(/[ \t]+$/, "")
        if ($0 ~ /^(LP)?DDR[0-9]?$/) type = $0
      }
    }
    /^[ \t]*Speed:/ {
      if (devok && speed == "") {
        sub(/^[^:]*:[ \t]*/, "")
        sub(/\(.*/, "")            # "3200 MT/s (2666 MT/s)" -> "3200 MT/s"
        sub(/[ \t]+$/, "")
        if ($0 ~ /^[0-9]+ (MT\/s|MHz)$/) speed = $0
      }
    }
    /^[ \t]*Error Correction Type:/ {
      if (ecc == "") {
        sub(/^[^:]*:[ \t]*/, "")
        sub(/[ \t]+$/, "")
        if ($0 != "" && $0 != "Unknown") ecc = $0
      }
    }
    END {
      if (slots + 0 > 0 && inst + 0 > 0) {
        gsub(/[^A-Za-z0-9 .(),_-]/, "", ecc)
        ecc = substr(ecc, 1, 32)
        line = "dimm=" inst "/" slots
        if (type != "")  line = line " " type
        if (speed != "") line = line " " speed
        if (ecc != "")   line = line " ecc=" ecc
        print line
      }
    }
  ' 2>/dev/null
}

# ---------------------------------------------------------------------
# gather_hwdeep — fill the BH_* deep-hardware globals (see header).
# ---------------------------------------------------------------------
gather_hwdeep() {
  # ---- globals: every value defaults to "" at function start ----
  BH_NUMA_TXT="";      BH_NUMA_OFFLINE=""
  BH_CPUFREQ_TXT="";   BH_THERMAL_TXT=""
  BH_THROTTLE_CNT="";  BH_HWERR_TXT=""
  BH_DIMM_TXT="";      BH_DIMM_NOTE=""

  local node_dir cl offline pdir fmin fmax gov drv seg turbo
  local nturbo hw hw_i tname tvals tf tcount tvc tlab parts
  local tz tz_i tztype tzv tpkg tcore hwerr mce
  local edir ce ue ecc_ce ecc_ue ecc_k got dmi is_root

  # ================= N1: NUMA topology =================
  # Count /sys/devices/system/node/node*, join the cpulists of the first 4
  # nodes, add the distance row (first 8 values) of the first node, and —
  # best effort — map the self cpuset onto the first overlapping node.
  local nscan=0 nodes=0 cl4="" first_node="" self_node=""
  for node_dir in /sys/devices/system/node/node*; do
    [ -d "$node_dir" ] || continue               # unmatched glob / hotplug race
    nscan=$(( nscan + 1 ))
    [ "$nscan" -gt 32 ] && break                 # huge-host cost cap
    nodes=$(( nodes + 1 ))
    cl="$(bhv5c5_sys1 "$node_dir/cpulist")"
    if [ "$nodes" -le 4 ] && [ -n "$cl" ]; then
      case "$cl" in *[!0-9,-]*) cl="" ;; esac    # malformed -> drop
      [ -n "$cl" ] && cl4="${cl4:+$cl4,}$cl"
    fi
    # self mapping: first node whose cpulist overlaps $CPUSET (skip on fail)
    if [ -z "$self_node" ] && [ -n "${CPUSET:-}" ] && [ -n "$cl" ]; then
      case "$cl" in
        *[!0-9,-]*) : ;;
        *)
          if [ -n "$(bhv5c5_cpuset_overlap "${CPUSET:-}" "$cl")" ]; then
            self_node="${node_dir##*/}"
          fi
          ;;
      esac
    fi
    [ -n "$first_node" ] || first_node="$node_dir"
  done
  if [ "$nodes" -gt 16 ]; then
    BH_NUMA_TXT="numa=16+"
  elif [ "$nodes" -gt 0 ]; then
    BH_NUMA_TXT="numa=$nodes"
    [ -n "$cl4" ] && BH_NUMA_TXT="$BH_NUMA_TXT cpulists=$cl4"
    # inter-node distance row of the first node, first 8 values, comma-joined
    if [ -n "$first_node" ] && [ -r "$first_node/distance" ]; then
      local drow dist8
      drow="$(bhv5c5_sys1 "$first_node/distance")"
      dist8="$(printf '%s\n' "$drow" | awk '{
        out = ""
        for (i = 1; i <= NF && i <= 8; i++) {
          if ($i !~ /^[0-9]+$/) break
          out = out (i > 1 ? "," : "") $i
        }
        print out
      }' 2>/dev/null)"
      [ -n "$dist8" ] && BH_NUMA_TXT="$BH_NUMA_TXT dist=$dist8"
    fi
    [ -n "$self_node" ] && BH_NUMA_TXT="$BH_NUMA_TXT self=$self_node"
  fi

  # ============ N2: offline CPUs (oversell evidence) ============
  # Non-empty means the kernel itself says some cores are offline — the
  # report renders this; empty stays "" (no line).
  offline="$(bhv5c5_sys1 /sys/devices/system/cpu/offline)"
  case "$offline" in
    ''|*[!0-9,-]*) BH_NUMA_OFFLINE="" ;;
    *)             BH_NUMA_OFFLINE="$offline" ;;
  esac

  # ===== F1: cpufreq policy (routinely absent in VMs -> "") =====
  # kHz sysfs values -> integer MHz; NEVER warn when the tree is missing.
  pdir="/sys/devices/system/cpu/cpufreq/policy0"
  if [ -d "$pdir" ]; then
    fmin="$(bhv5c5_sys1 "$pdir/scaling_min_freq")"
    fmax="$(bhv5c5_sys1 "$pdir/scaling_max_freq")"
    gov="$(bhv5c5_sys1 "$pdir/scaling_governor")"
    drv="$(bhv5c5_sys1 "$pdir/scaling_driver")"
    case "$fmin" in ''|*[!0-9]*) fmin="" ;; esac
    case "$fmax" in ''|*[!0-9]*) fmax="" ;; esac
    case "$gov" in *[!A-Za-z0-9_-]*) gov="" ;; esac
    case "$drv" in *[!A-Za-z0-9_-]*) drv="" ;; esac
    seg=""
    [ -n "$fmin" ] && [ -n "$fmax" ] && \
      seg="$(awk -v lo="$fmin" -v hi="$fmax" 'BEGIN{ printf "%d-%dMHz", lo / 1000, hi / 1000 }')"
    # turbo: intel_pstate no_turbo=1, else cpufreq boost=0, else amd_pstate
    # status "disable" — all three mean turbo is off
    nturbo="$(bhv5c5_sys1 /sys/devices/system/cpu/intel_pstate/no_turbo)"
    if [ "$nturbo" = "1" ]; then
      turbo="turbo=off"
    elif [ "$(bhv5c5_sys1 /sys/devices/system/cpu/cpufreq/boost)" = "0" ]; then
      turbo="turbo=off"
    elif [ "$(bhv5c5_sys1 /sys/devices/system/cpu/amd_pstate/status)" = "disable" ]; then
      turbo="turbo=off"
    else
      turbo=""
    fi
    BH_CPUFREQ_TXT="$seg"
    [ -n "$gov" ] && BH_CPUFREQ_TXT="${BH_CPUFREQ_TXT:+$BH_CPUFREQ_TXT }governor=$gov"
    [ -n "$drv" ] && BH_CPUFREQ_TXT="${BH_CPUFREQ_TXT:+$BH_CPUFREQ_TXT }driver=$drv"
    [ -n "$turbo" ] && BH_CPUFREQ_TXT="${BH_CPUFREQ_TXT:+$BH_CPUFREQ_TXT }$turbo"
  fi

  # ====== T1: thermal sensors (typical VMs -> "", never a warn) ======
  # hwmon first: chip name + up to 4 temp*_input values per chip, 8 chips
  # max. A temp*_label can stand in for a missing chip name (some drivers
  # expose labels but no name); it is read at most once per chip. Fallback
  # (only when hwmon yielded nothing): /sys/class/thermal thermal zones.
  parts=""
  hw_i=0
  for hw in /sys/class/hwmon/hwmon*; do
    [ -d "$hw" ] || continue
    hw_i=$(( hw_i + 1 ))
    [ "$hw_i" -gt 8 ] && break
    tname="$(bhv5c5_sys1 "$hw/name")"
    case "$tname" in *[!A-Za-z0-9_.[:space:]-]*) tname="" ;; esac
    tvals=""
    tcount=0
    tlab=""
    # note: the glob is lexicographic, so on many-temp chips an arbitrary
    # (not strictly lowest) subset of 4 sensors is shown — fine for a report
    for tf in "$hw"/temp*_input; do
      [ -r "$tf" ] || continue                   # unmatched glob -> skip
      tcount=$(( tcount + 1 ))
      [ "$tcount" -gt 4 ] && break
      tvc="$(bhv5c5_temp_c "$(bhv5c5_sys1 "$tf")")"
      [ -n "$tvc" ] && tvals="${tvals:+$tvals }${tvc}°C"
      if [ -z "$tname" ] && [ -z "$tlab" ]; then
        tlab="$(bhv5c5_sys1 "${tf%_input}_label")"
        case "$tlab" in *[!A-Za-z0-9_.[:space:]-]*) tlab="" ;; esac
      fi
    done
    [ -z "$tname" ] && tname="$tlab"
    if [ -z "$tname" ] && [ -n "$hw" ]; then
      case "$hw" in */hwmon*) tname="hwmon${hw##*/hwmon}" ;; esac
    fi
    if [ -n "$tname" ] && [ -n "$tvals" ]; then
      parts="${parts:+$parts | }${tname}: $tvals"
    fi
  done
  if [ -z "$parts" ]; then
    tz_i=0
    for tz in /sys/class/thermal/thermal_zone*; do
      [ -d "$tz" ] || continue
      tz_i=$(( tz_i + 1 ))
      [ "$tz_i" -gt 8 ] && break
      tztype="$(bhv5c5_sys1 "$tz/type")"
      case "$tztype" in ''|*[!A-Za-z0-9_-]*) continue ;; esac
      tzv="$(bhv5c5_temp_c "$(bhv5c5_sys1 "$tz/temp")")"
      [ -n "$tzv" ] || continue
      parts="${parts:+$parts | }${tztype}: ${tzv}°C"
    done
  fi
  BH_THERMAL_TXT="$parts"

  # ============ T2: thermal throttle event counters ============
  # Non-zero counts are hard evidence the package/cores ran hot enough to
  # throttle — a VM cannot fake these away (host-owned sysfs).
  tpkg="$(bhv5c5_sys1 /sys/devices/system/cpu/cpu0/thermal_throttle/package_throttle_count)"
  tcore="$(bhv5c5_sys1 /sys/devices/system/cpu/cpu0/thermal_throttle/core_throttle_count)"
  case "$tpkg" in ''|*[!0-9]*) tpkg="" ;; esac
  case "$tcore" in ''|*[!0-9]*) tcore="" ;; esac
  if [ -n "$tpkg" ] && [ -n "$tcore" ] && [ $(( tpkg + tcore )) -gt 0 ]; then
    BH_THROTTLE_CNT="pkg=$tpkg core=$tcore"
  fi

  # ============ E1: hardware error counters ============
  # MCE: per-CPU machine-check event total from /proc/interrupts; EDAC:
  # corrected/uncorrectable ECC counters summed over all memory controllers.
  # Only pieces that are readable get rendered; none -> "".
  hwerr=""
  if [ -r /proc/interrupts ]; then
    # the MCE row is "MCE:  <per-cpu counts ...>  Machine check errors" —
    # trailing text adds 0, per-CPU columns are summed
    mce="$(awk '/^[ \t]*MCE:/ { s = 0; for (i = 2; i <= NF; i++) s += ($i + 0); print s + 0; exit }' /proc/interrupts 2>/dev/null)"
    case "$mce" in ''|*[!0-9]*) mce="" ;; esac
    [ -n "$mce" ] && hwerr="mce=$mce"
  fi
  ecc_ce=0; ecc_ue=0; ecc_k=0
  for edir in /sys/devices/system/edac/mc/mc*; do
    [ -d "$edir" ] || continue
    ce="$(bhv5c5_sys1 "$edir/ce_count")"
    ue="$(bhv5c5_sys1 "$edir/ue_count")"
    case "$ce" in ''|*[!0-9]*) ce="" ;; esac
    case "$ue" in ''|*[!0-9]*) ue="" ;; esac
    got=0
    [ -n "$ce" ] && { ecc_ce=$(( ecc_ce + ce )); got=1; }
    [ -n "$ue" ] && { ecc_ue=$(( ecc_ue + ue )); got=1; }
    [ "$got" -eq 1 ] && ecc_k=$(( ecc_k + 1 ))
  done
  [ "$ecc_k" -gt 0 ] && hwerr="${hwerr:+$hwerr }ecc corr=$ecc_ce unc=$ecc_ue (${ecc_k} ctrl)"
  BH_HWERR_TXT="$hwerr"

  # ============ M1: DIMM inventory (root + dmidecode only) ============
  # The ONLY timeout-wrapped external call in this module (timeout 2), and
  # only when root and BH_REDACT!=1. Non-root / redacted -> "" plus the
  # BH_DIMM_NOTE="root-only" hint; dmidecode simply missing -> clean "".
  is_root=0
  [ "$(id -u 2>/dev/null || echo 1)" = "0" ] && is_root=1
  if [ "$is_root" -eq 1 ] && [ "${BH_REDACT:-0}" != "1" ] && command_exists dmidecode; then
    dmi="$(bhv5c5_t2 dmidecode -t memory)"
    [ -n "$dmi" ] && BH_DIMM_TXT="$(bhv5c5_dimm_line "$dmi")"
  elif [ "$is_root" -ne 1 ] || [ "${BH_REDACT:-0}" = "1" ]; then
    BH_DIMM_NOTE="root-only"
  fi

  return 0
}

# ============ lib/20-info.sh ============
# =====================================================================
# blackhole-vps-bench · 20-info.sh — system info + cgroup limits + offline extras
# =====================================================================
#
# v4.0 (W3-C):
#   - ZERO network calls from this module, ever. The egress-IP / geo / ASN
#     lookups (ipify + ip-api) moved to the net module (60-net.sh); cloud
#     metadata stays in 12-cloud.sh. BH_IPV4/BH_IPV6/BH_IP_GEO/BH_IP_ASN are
#     declared here ("" default) and filled by the module that owns them.
#   - CPU flags now work on x86_64 ("flags") AND aarch64 ("Features").
#   - New offline extras: CPU vulnerability matrix (BH_VULN_*), ISA inventory
#     (BH_CPU_AI_FEAT / BH_CPU_CRYPTO_FEAT), microcode + stepping (BH_CPU_UCODE
#     / BH_CPU_STEPPING), KSM state (BH_KSM_STATE / BH_KSM_SHARING).
# shellcheck shell=bash

BH_HOSTNAME=""; BH_OS=""; BH_KERNEL=""; BH_ARCH=""; BH_UPTIME=""
BH_CPU_MODEL=""; BH_CPU_LOGICAL=""; BH_CPU_PHYS=""; BH_CPU_FLAGS_HI=""
BH_MEM_TOTAL_MB=""; BH_MEM_AVAIL_MB=""; BH_MEM_SWAP_MB=""
BH_MEM_LIMIT_MB="0"; BH_MEM_EFF_MB=""; BH_CPU_QUOTA_TXT=""
BH_DISK_DEV=""; BH_DISK_FS=""; BH_DISK_TOTAL_MB=""; BH_DISK_AVAIL_MB=""
BH_IPV4=""; BH_IPV6=""; BH_IP_GEO=""; BH_IP_ASN=""
# deep-scan extras (v2)
BH_DNS=""; BH_TCPCC=""; BH_TCPCC_AVAIL=""; BH_ENTROPY=""
BH_TUN=0; BH_FUSE=0; BH_PPP=0
BH_LOAD=""; BH_PROCS=0; BH_TZ=""
# environment deep-dive extras (v2.1)
BH_STEAL_PCT=""; BH_CPU_FREQ_MHZ=""; BH_CPUSET_N=0; BH_THP=""
BH_HUGEPAGES_TOTAL=""; BH_DISK_SCHED=""; BH_DISK_ROTA=""; BH_DISK_CLASS=""
BH_NET_MTU=""; BH_SWAP_DETAIL=""
# offline security / CPU-identity extras (v4.0 — W3-C)
# vuln matrix: /sys/devices/system/cpu/vulnerabilities/* (C2)
BH_VULN_WORST=""; BH_VULN_TOTAL=0; BH_VULN_SCOPE=""
# ISA inventory: AI/ML + crypto extensions, comma lists (C3)
