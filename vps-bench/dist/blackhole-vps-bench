  printf '{'
  printf '"tool":"%s","version":"%s","generated_at":"%s","mode":"%s",' \
    "$(json_esc "$BH_TOOL")" "$(json_esc "$BH_VERSION")" "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" "$(json_esc "$BH_MODE")"
