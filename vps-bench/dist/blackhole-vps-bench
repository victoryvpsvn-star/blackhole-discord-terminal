  # ---- v4: environment deep-dive (module 25 — object only when it ran) ----
  if [ -n "${BH_CAPS_CLASS:-}${BH_DEV_MAP:-}${BH_PIDS_MAX:-}${BH_PID1_LSM:-}${BH_CG_CONTROLLERS:-}${BH_RL_NOFILE:-}${BH_OOM_ADJ:-}" ]; then
