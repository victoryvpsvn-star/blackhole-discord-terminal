# bhv5c9_now_ms — milliseconds since epoch; now_ms (00-core.sh) when loaded,
# EPOCHREALTIME (no forks) otherwise, `date` as the last resort. Used only
# for the wall-clock budget of the /proc walk.
bhv5c9_now_ms() {
  if command -v now_ms >/dev/null 2>&1; then now_ms; return 0; fi
  if [ -n "${EPOCHREALTIME:-}" ]; then
    local secs frac
    secs=${EPOCHREALTIME%%.*}
    frac=${EPOCHREALTIME#*.}
    case "$frac" in ''|*[!0-9]*) frac=0 ;; esac
    printf '%s%03d' "$secs" $(( 10#$frac / 1000 ))
    return 0
  fi
  date +%s%3N 2>/dev/null || printf '%s000' "$(date +%s 2>/dev/null || echo 0)"
}

# sec_malware_hunt — entry point, called (guarded `declare -F`) from
# run_sec_audit in 80-ssh.sh. Every verdict goes through sec_line, so
# BH_SEC_WARN/BH_SEC_BAD and the posture/exit gates pick these up.
sec_malware_hunt() {
  [ "${BH_NO_SEC:-0}" = "1" ] && return 0   # belt & braces (run_sec_audit gates too)
  BH_MH_DELETED=0; BH_MH_WWEXEC=0; BH_MH_MEMFD=0; BH_MH_SCANNED=0; BH_MH_PARTIAL=0
  if [ ! -d /proc ]; then
    sec_line info "malware-hunt: n/a (/proc unavailable)"
    return 0
  fi
  # self-match guard (same idea as the miner scan in 85-hardening.sh): skip
  # our own PID and the $PPID chain — our ancestry is known-clean.
  local parent="${PPID:-}" gp
  gp="$(awk '/^PPid/{print $2}' "/proc/$parent/status" 2>/dev/null)"
  local skip="|$$|$parent|${gp:-}|"
  local view=""
  [ "${EUID:-$(id -u 2>/dev/null)}" -ne 0 ] 2>/dev/null && view=" (own-user view)"
  local d p exe real cm show is_del=0
  local del_n=0 ww_n=0 mf_n=0 seen_del=0 seen_ww=0 ww_more=0 del_list=""
  local t0 cur
  t0="$(bhv5c9_now_ms)"
  case "$t0" in ''|*[!0-9]*) t0=0 ;; esac
  for d in /proc/[0-9]*; do
    [ -d "$d" ] || continue
    p="${d#/proc/}"
    case "$skip" in *"|$p|"*) continue ;; esac
    # wall-clock budget (~1.5s): bail out flagged rather than overrun
    if [ "$t0" -gt 0 ] && [ $(( BH_MH_SCANNED % 64 )) -eq 0 ] && [ "$BH_MH_SCANNED" -gt 0 ]; then
      cur="$(bhv5c9_now_ms)"
      case "$cur" in ''|*[!0-9]*) cur=$t0 ;; esac
      if [ $(( cur - t0 )) -gt 1500 ]; then
        BH_MH_PARTIAL=1
        break
      fi
    fi
    # /proc/<pid>/exe is a kernel-side symlink — readlink on it cannot block;
    # a vanished pid (race) yields an empty string and is skipped, never flagged.
    exe="$(readlink "$d/exe" 2>/dev/null)"
    [ -n "$exe" ] || continue
    BH_MH_SCANNED=$((BH_MH_SCANNED + 1))
    real="$exe"
    is_del=0
    case "$real" in *" (deleted)") is_del=1; real="${real% (deleted)}" ;; esac
    case "$real" in
      /memfd:*)
        # runtime-legit in-memory exec — INFO, never a warn
        BH_MH_MEMFD=$((BH_MH_MEMFD + 1)); mf_n=$((mf_n + 1))
        continue ;;
      /tmp/*|/var/tmp/*|/dev/shm/*|/run/user/*)
        BH_MH_WWEXEC=$((BH_MH_WWEXEC + 1)); ww_n=$((ww_n + 1))
        if [ "$seen_ww" -lt 3 ]; then
          show="$real"
          bhv5c9_redact_on && show="${real##*/}"
          sec_line bad "process executing from world-writable dir: $show (pid $p)$view"
          seen_ww=$((seen_ww + 1))
        else
          ww_more=$((ww_more + 1))
        fi
        continue ;;
    esac
    if [ "$is_del" = "1" ]; then
      BH_MH_DELETED=$((BH_MH_DELETED + 1)); del_n=$((del_n + 1))
      if [ "$seen_del" -lt 3 ]; then
        cm=""
        { IFS= read -r cm < "$d/comm"; } 2>/dev/null || cm=""
        [ -n "$cm" ] || cm="pid:$p"
        del_list="${del_list:+$del_list, }pid $p ($cm)"
        seen_del=$((seen_del + 1))
      fi
    fi
  done
  # ---- verdicts (capped at 3 BAD + 3 WARN lines total) ----
  if [ "$ww_n" -gt 0 ]; then
    if [ "$ww_more" -gt 0 ]; then
      sec_line info "malware-hunt: $ww_more more world-writable-exec process(es) beyond the 3 shown (total $BH_MH_WWEXEC)$view"
    fi
  fi
  if [ "$del_n" -gt 0 ]; then
    local more_del=""
    [ "$del_n" -gt "$seen_del" ] && more_del=" (+$((del_n - seen_del)) more)"
    sec_line warn "malware-hunt: $del_n process(es) running deleted binaries — $del_list$more_del$view"
  fi
  if [ "$mf_n" -gt 0 ]; then
    sec_line info "malware-hunt: $mf_n memfd-backed process(es) (runtime-legit in-memory exec — e.g. JVM/.NET, not file-backed)$view"
  fi
  if [ "$ww_n" -eq 0 ] && [ "$del_n" -eq 0 ]; then
    if [ "$BH_MH_SCANNED" -eq 0 ]; then
      sec_line info "malware-hunt: n/a (no /proc entries readable — hardened container or restrictive LSM)$view"
    else
      sec_line ok "malware-hunt: clean — no deleted-binary or world-writable-dir execution ($BH_MH_SCANNED process(es) checked$view)"
    fi
  fi
  if [ "$BH_MH_PARTIAL" = "1" ]; then
    sec_line info "malware-hunt: scan truncated at the time budget ($BH_MH_SCANNED process(es) checked)$view"
  fi
  return 0
}

