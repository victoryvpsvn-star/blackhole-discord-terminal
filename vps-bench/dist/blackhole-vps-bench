  if [ -n "${BH_GEO_LOC:-}${BH_GEO_CLO:-}${BH_NET_CLO:-}${BH_LAT_MATRIX:-}${BH_NAT_MODE:-}${BH_DNS_MS:-}${BH_PACKET_LOSS:-}${BH_IPV6_GRADE:-}${BH_PORT_25:-}${BH_NIC_DRIVER:-}" ]; then
